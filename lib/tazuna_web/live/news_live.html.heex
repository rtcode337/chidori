<Layouts.flash_group flash={@flash} />
<main class="news-page">
  <div>
    <header>
      <a href={~p"/"} class="brand" aria-label="tazuna トップページ">
        <span> t </span>
        <strong>tazuna</strong>
      </a>
      <nav aria-label="主要メニュー">
        <a class="active" href={~p"/news"}>最新情報</a>
        <a href={~p"/relations"}>関連図</a>
        <a href={~p"/datasets"}>データ収集</a>
      </nav>
    </header>

    <section class="news-intro">
      <p>DAILY UPDATES</p>
      <h1>{if @topic, do: "今日、押さえておきたい#{@topic.name}", else: "最新情報"}</h1>
      <p>
        集めるのは Chiezo です。tazuna は収集を依頼して、溜まったものを読みます。
        依頼して作られる収集は止まった状態なので、<strong>この画面から AI が勝手に動くことはありません</strong>。
      </p>
    </section>

    <%!-- 話題ごとのタブ。**集めるものも溜まるものも話題ごとに別**なので、
         1 つに混ぜると、どちらの状態を見ているのか読めなくなる。
         並ぶのは `Tazuna.Topics` の話題そのもの（定義はコードにある） --%>
    <nav :if={@topics != []} class="relation-tabs" aria-label="話題">
      <.link
        :for={topic <- @topics}
        patch={~p"/news?view=#{topic.collection}"}
        class={if @topic && @topic.collection == topic.collection, do: "selected"}
      >
        {topic.name}
      </.link>
    </nav>

    <%!-- まとめ。**記事の一覧より先に出す** —— 溜まったものをそのまま並べても
         読めないので、何が起きたかを先に言う（通知に出すのもここの1行目） --%>
    <section :if={@news.digests != []} class="news-digest" aria-label="まとめ">
      <% digest = List.first(@news.digests) %>
      <p class="news-source">{digest.collected_at}</p>
      <h2>{digest.title}</h2>
      <pre>{digest.summary}</pre>
    </section>

    <section class="news-list" aria-live="polite">
      <%= for article <- sorted_articles(@news) do %>
        <article>
          <%!-- 配信元が配っている絵。**無いほうが多い**ので、あるときだけ出す --%>
          <img :if={article.image} class="news-thumb" src={article.image} alt="" loading="lazy" />
          <div>
            <p class="news-source">{article.collected_at}</p>
            <h2>
              <%!-- 出典があれば原文へ。無ければ見出しだけ出す（Chiezo 側にも入口はある） --%>
              <%= if article.url do %>
                <a href={article.url} target="_blank" rel="noreferrer">{article.title}</a>
              <% else %>
                {article.title}
              <% end %>
            </h2>
            <p :if={article.summary} class="news-summary">{article.summary}</p>
            <%!-- なぜこの重さなのか。読んだ AI が付けた印なら、その旨も含めて出る --%>
            <p class="news-reason">{article.reason}</p>
          </div>
          <span class={importance_class(article.importance)}>
            {importance_label(article.importance)}
          </span>
        </article>
      <% end %>
    </section>

    <%!-- Chiezo の状態と、そこへ送る設定を **1 つの枠にまとめる**（関連図と同じ形）。
         状態を見る場所と、直す場所と、押す場所が離れていると、何がどこへ効くのか
         読めない --%>
    <section class="collect-panel" aria-label="最新情報の収集">
      <h2>Chiezo の収集</h2>
      <p aria-live="polite">{status_message(@news) || collection_note(@news)}</p>

      <dl :if={@news.collection} class="collect-facts">
        <div :for={{label, value} <- collection_facts(@news)}>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      </dl>

      <%!-- **選んだところはサーバーが覚える**（`phx-change`）。覚えないと、収集の
           状態が届いた拍子にフォームが描き直され、選んだ相手が元の値に戻る --%>
      <form id="collect-form" phx-submit="collect" phx-change="pick_sweep">
        <.sweep_table state={@news} picks={@picks} backends={@backends} />

        <p class="muted-note">{sweep_note(@topic)}</p>
        <button
          type="submit"
          phx-disable-with="送っています…"
          disabled={@news.status == :loading or not @news.configured}
        >
          {collect_label(@news)}
        </button>
      </form>

      <p :if={@news.collection && @news.collection.url} class="muted-note">
        <a href={@news.collection.url} target="_blank" rel="noreferrer">Chiezo で見る</a>
      </p>

      <%!-- **この場で 1 回だけ頼める。** 定時の巡回は決まった仕事しかしないので、
           「この話の続きを追って」のような頼みごとの行き先がここにしかない。
           割り込みは定時の巡回の進み具合にも次の予定にも触らない --%>
      <details :if={@news.collection} class="ask-more">
        <summary>いま頼む（割り込み）</summary>
        <form phx-submit="ask">
          <p>
            <label>
              頼みたいこと<br />
              <textarea
                name="note"
                rows="3"
                placeholder="例: この件の続報を追って、関係する発表もまとめて"
              ></textarea>
            </label>
          </p>
          <p class="muted-note">
            定時の巡回とは別に 1 回だけ走ります（進み具合にも次の予定にも触りません）。
            走るのは「{Tazuna.News.focus_sweep()}」の設定です —— <strong>落とす力と印を付け直す力を持つのはこの回だけ</strong>なので、
            「これは宣伝だから落として」も頼めます。巡回の依頼文は書き換わりません。
          </p>
          <button type="submit" disabled={@asking} phx-disable-with="頼んでいます…">
            Chiezo に頼む
          </button>
        </form>
      </details>

      <%!-- AI に何を頼んでいるかは、押す前にも後にも読めるようにする。
           畳んでおくのは、ふだんは読みたいのが結果のほうだから --%>
      <details class="news-prompt">
        <summary>Chiezo への依頼文</summary>
        <p class="news-prompt-note">{prompt_note(@news)}</p>
        <pre>{prompt_text(@news, @topic)}</pre>
        <div :for={{name, text} <- sweep_prompts(@topic)}>
          <h3>{name}</h3>
          <pre>{text}</pre>
        </div>
      </details>
    </section>

    <footer>
      <p>
        収集は
        <a href="https://github.com/rtcode337/chiezo" target="_blank" rel="noreferrer">Chiezo</a>
        の「集める」層が行い、溜まったものは Chiezo のソースとして残ります。
        見出しを押すと Chiezo の中身（要約と出典）が開きます。
      </p>
    </footer>
  </div>
</main>
