<Layouts.flash_group flash={@flash} />
<%!-- **見た目は関連図・データ収集と同じ枠**（`relations-page`）。画面ごとに色や
     見出しの作りが違うと、同じアプリの中を移っている気がしない --%>
<main class="relations-page news-page">
  <div>
    <header>
      <a href={~p"/"} class="brand" aria-label="tazuna トップページ"><span>t</span>tazuna</a>
      <nav aria-label="主要メニュー">
        <a class="active" href={~p"/news"}>最新情報</a>
        <a href={~p"/relations"}>関連図</a>
        <a href={~p"/datasets"}>データ収集</a>
      </nav>
    </header>

    <%!-- 話題ごとのタブ。**集めるものも溜まるものも話題ごとに別**なので、
         1 つに混ぜると、どちらの状態を見ているのか読めなくなる。
         並ぶのは `Tazuna.Topics` の話題そのもの（定義はコードにある）。
         **見出しの上に置く**（関連図・データ収集と同じ）—— 見出しと説明は選んだ話題の
         ものなので、切り替える口がその下にあると、どこまでが切り替わるのかが読めない --%>
    <nav :if={@topics != []} class="relation-tabs" aria-label="話題">
      <.link
        :for={topic <- @topics}
        patch={~p"/news?view=#{topic.collection}"}
        class={if @topic && @topic.collection == topic.collection, do: "selected"}
        aria-current={if @topic && @topic.collection == topic.collection, do: "page"}
      >
        {topic.name}
      </.link>
    </nav>

    <section class="relations-intro">
      <p>DAILY UPDATES</p>
      <h1>{if @topic, do: @topic.name, else: "最新情報"}</h1>
      <p>
        集めるのは Chiezo です。tazuna は収集を依頼して、溜まったものを読みます。
        依頼して作られる収集は止まった状態なので、この画面から AI が勝手に動くことはありません。
      </p>
    </section>

    <%!-- まとめ。**記事の一覧より先に出す** —— 溜まったものをそのまま並べても
         読めないので、何が起きたかを先に言う（通知へ流れるのは、この中の要旨） --%>
    <section :if={@news.digests != []} class="news-digest" aria-label="要約">
      <h2 class="news-section-title">要約</h2>
      <% digest = List.first(@news.digests) %>
      <%!-- **見出し・要旨・目次はここで読める。** 章と出典は全画面で読む ——
           長いまとめをここに全部広げると、下の話題と記事一覧が遠くなる。
           押すと全画面で開き、目次の項目を押すとその章から開く --%>
      <div
        class="digest-preview"
        role="button"
        tabindex="0"
        phx-click="open_digest"
        phx-value-index="0"
        aria-label="要約を全画面で読む"
      >
        <.report
          title={digest.title}
          at={digest.collected_at}
          body={digest.summary}
          label={@topic && @topic.name}
          articles={@news.articles}
          cited={digest.cited}
          intro_only
          open_event="open_digest"
        />
        <p class="digest-open-hint">
          タップで全文を全画面で読む<span :if={length(@news.digests) > 1}>（左右のスワイプで前後の要約へ）</span>
        </p>
      </div>
    </section>

    <%!-- 全画面の要約。**左右のスワイプで前後の要約へ**（`DigestSwipe`）。
         **古いほうを左に置く** —— 右へ払う（左のものを引き出す）のは「戻る」の
         動きなので、戻る先が古いほう。新しいほうへは左へ払う --%>
    <%= if viewed = opened_digest(@digest_open, @news, @digest_full) do %>
      <div
        id="digest-viewer"
        class="digest-viewer"
        role="dialog"
        aria-modal="true"
        aria-label="要約"
        phx-hook="DigestSwipe"
        phx-window-keydown="digest_key"
        data-index={@digest_open}
        data-section={@digest_section}
      >
        <nav class="digest-viewer-bar" aria-label="要約の切り替え">
          <button
            type="button"
            phx-click="digest_step"
            phx-value-by="1"
            disabled={@digest_open >= length(@news.digests) - 1}
            aria-label="古い要約"
          >
            ← 古い
          </button>
          <span class="digest-viewer-count">{@digest_open + 1} / {length(@news.digests)}</span>
          <button
            type="button"
            phx-click="digest_step"
            phx-value-by="-1"
            disabled={@digest_open == 0}
            aria-label="新しい要約"
          >
            新しい →
          </button>
          <button
            type="button"
            class="digest-viewer-close"
            phx-click="close_digest"
            aria-label="閉じる"
          >
            ×
          </button>
        </nav>
        <div class="digest-viewer-body">
          <.report
            title={viewed.title}
            at={viewed.collected_at}
            body={viewed.summary}
            label={@topic && @topic.name}
            articles={@news.articles}
            cited={viewed.cited}
            id_prefix="digest-viewer"
          />
        </div>
      </div>
    <% end %>

    <%!-- 記事から育った話題の網。**まとめのすぐ下** —— まとめが「この期間に何が
         あったか」を文で言うのに対して、図は同じことを語のつながりで見せる。
         育てるのは Chiezo で、tazuna は依頼文を渡して読むだけ --%>
    <.topic_map state={@themes} />

    <%!-- 記事の一覧。**ふだんは畳んでおく** —— 読むのは要約と話題の網で、1 件ずつを
         拾いに行くのは気になったときだけ。開いたままだと画面の大半を占める --%>
    <details class="news-articles">
      <summary>
        <h2 class="news-section-title">記事一覧（{length(@news.articles)} 件）</h2>
      </summary>
      <section class="news-list" aria-live="polite">
        <%= for article <- sorted_articles(@news) do %>
          <article>
            <%!-- 配信元が配っている絵。**無いほうが多い**ので、あるときだけ出す --%>
            <img :if={article.image} class="news-thumb" src={article.image} alt="" loading="lazy" />
            <div>
              <%!-- 反応の大きさは重要度と別の軸なので、印の隣ではなく日付の並びに置く --%>
              <p class="news-source">
                {article.collected_at}<span :if={buzz_text(article)}>・{buzz_text(article)}</span>
              </p>
              <h2>
                <%!-- 出典があれば原文へ。無ければ見出しだけ出す（Chiezo 側にも入口はある） --%>
                <%= if article.url do %>
                  <a href={article.url} target="_blank" rel="noreferrer">{article.title}</a>
                <% else %>
                  {article.title}
                <% end %>
              </h2>
              <p :if={article.summary} class="news-summary">{article.summary}</p>
              <%!-- なぜこの重さなのか。読んだ AI が付けた印なら、その旨も含めて出る --%>
              <p class="news-reason">{article.reason}</p>
            </div>
            <span class={importance_class(article.importance)}>
              {importance_label(article.importance)}
            </span>
          </article>
        <% end %>
      </section>
    </details>

    <%!-- 設定は 1 つの枠にまとめる（関連図と同じ形）。状態を見る場所と、直す場所と、
         押す場所が離れていると、何がどこへ効くのか読めない。
         **中は仕事ごとに分ける** —— 集める設定と、知らせる設定は別のもの --%>
    <section class="settings-panel" aria-label={settings_title(@topic)}>
      <h2>{settings_title(@topic)}</h2>

      <section class="settings-block">
        <h3>Chiezo の収集</h3>
        <p aria-live="polite">{status_message(@news) || collection_note(@news)}</p>

        <dl :if={@news.collection} class="collect-facts">
          <div :for={{label, value} <- collection_facts(@news)}>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        </dl>

        <%!-- **選んだところはサーバーが覚える**（`phx-change`）。覚えないと、収集の
             状態が届いた拍子にフォームが描き直され、選んだ相手が元の値に戻る --%>
        <form id="collect-form" phx-submit="collect" phx-change="pick_sweep">
          <.sweep_table state={@news} picks={@picks} backends={@backends} />

          <p class="muted-note">{sweep_note(@topic)}</p>
          <div class="button-row">
            <button
              type="submit"
              phx-disable-with="送っています…"
              disabled={@news.status == :loading or not @news.configured}
            >
              {collect_label(@news)}
            </button>
          </div>
        </form>

        <p :if={@news.collection && @news.collection.url} class="muted-note">
          <a href={@news.collection.url} target="_blank" rel="noreferrer">Chiezo で見る</a>
        </p>
      </section>

      <%!-- 通知先。**画面から直せるようにする** —— 宛先は運用しながら決めるもの
           （試しに別のトピックへ流す、しばらく止める）なので、環境変数だけだと
           変えるたびに立て直しが要る。**畳まない** —— 時刻も宛先も、いまどうなって
           いるかを開かずに読めることのほうが大事 --%>
      <section class="settings-block">
        <h3>通知の設定</h3>
        <p :if={notify_note(@topic)} class="muted-note">{notify_note(@topic)}</p>

        <%!-- 書いたそばから覚える（`phx-change`）。覚えないと、収集の状態が届いた
             拍子にフォームが描き直され、書きかけの通知先が消える --%>
        <.form
          :let={f}
          id="notify-form"
          for={@notify_form}
          phx-submit="save_notify"
          phx-change="edit_notify"
        >
          <p>
            <label>
              通知先（ntfy のトピック名）<br />
              <input type="text" name={f[:ntfy_topic].name} value={f[:ntfy_topic].value} />
            </label>
          </p>
          <p>
            <label>
              ntfy の場所（空なら {Tazuna.Ntfy.default_base_url()}）<br />
              <input
                type="text"
                name={f[:ntfy_base_url].name}
                value={f[:ntfy_base_url].value}
                placeholder="https://ntfy.example.com"
              />
            </label>
          </p>
          <p>
            <label>
              知らせる時刻（JST・空なら回しません。例: 08:00,21:00）<br />
              <input
                type="text"
                name={f[:digest_at].name}
                value={f[:digest_at].value}
                placeholder="07:00,21:00"
              />
            </label>
          </p>
          <p class="muted-note">
            <strong>通知先を空にすると知らせなくなります。</strong>
            既定の通知先は持ちません —— 公開の ntfy では、推測できる名前は誰でも読めるので、<strong>推測されない名前</strong>にしてください。場所は書かなければ公式の公開サーバーへ送ります。
          </p>
          <div class="button-row">
            <button type="submit">通知先を保存</button>
          </div>
        </.form>

        <%!-- 時計を持つのは tazuna の側。Chiezo には「いま回してください」としか
             言わない（何時に読みたいかは利用者の都合なので、あちらに持たせない） --%>
        <p class="muted-note">{digest_note(@topic)}</p>
        <%!-- いまの状態と、前に走った回の記録は分けて出す。混ぜると、止まった回の
             理由（現在形で書かれる）が、いまの状態として読まれる --%>
        <p :if={digest_state_text(@news, @topic)} class="muted-note">
          {digest_state_text(@news, @topic)}
        </p>
        <p class="muted-note">{last_digest_text(@topic)}</p>
        <p class="muted-note">{last_sent_text(@topic)}</p>
        <p :if={@digest_message} aria-live="polite">{@digest_message}</p>

        <div class="button-row">
          <button
            :if={can_notify?(@topic)}
            type="button"
            phx-click="digest_now"
            phx-disable-with="始めています…"
          >
            いま作って知らせる
          </button>
          <button
            :if={can_notify?(@topic)}
            type="button"
            phx-click="notify"
            phx-disable-with="送っています…"
          >
            いまのまとめを知らせる
          </button>
        </div>
      </section>

      <%!-- トピックの収集。**記事とは別の収集**（記事は 30 日で落ちるが、
           トピックは期限では落とさない）。持つ話題にだけ出す --%>
      <section :if={Tazuna.Topics.themes?(@topic)} class="settings-block">
        <h3>トピックの収集</h3>
        <p aria-live="polite">{theme_note(@themes)}</p>

        <dl :if={@themes.collection} class="collect-facts">
          <div :for={{label, value} <- collection_facts(@themes)}>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        </dl>

        <form id="theme-collect-form" phx-submit="collect_themes" phx-change="pick_theme_sweep">
          <.sweep_table state={@themes} picks={@theme_picks} backends={@backends} />
          <p class="muted-note">
            <strong>語を拾うのは機械、精査するのが AI です。</strong> 記事に付いたタグがそのままトピックになり、件数と一緒に出てくる語も Chiezo が
            数えます（機械収集の回は AI を呼びません）。AI の回は、言い換えを畳む・親子を決める・
            話題でない語を外す・説明を書く、の 4 つだけです。
          </p>
          <div class="button-row">
            <button type="submit" phx-disable-with="送っています…">{theme_collect_label(
              @themes
            )}</button>
          </div>
        </form>

        <%!-- **押す口は増やさない。** 読み直しの口は置かず、開き直したときと
             設定を送り直したときに読む（記事のほうと同じ形） --%>
        <div :if={@themes.collection} class="button-row">
          <button type="button" phx-click="pick_themes" phx-disable-with="頼んでいます…">
            いま拾う
          </button>
        </div>

        <p :if={@themes.collection && @themes.collection.url} class="muted-note">
          <a href={@themes.collection.url} target="_blank" rel="noreferrer">Chiezo で見る</a>
        </p>
      </section>

      <%!-- **この場で 1 回だけ頼める。** 定時の巡回は決まった仕事しかしないので、
           「この話の続きを追って」のような頼みごとの行き先がここにしかない。
           割り込みは定時の巡回の進み具合にも次の予定にも触らない --%>
      <details :if={@news.collection} class="ask-more">
        <summary>いま頼む（割り込み）</summary>
        <form phx-submit="ask">
          <p>
            <label>
              頼みたいこと<br />
              <textarea
                name="note"
                rows="3"
                placeholder="例: この件の続報を追って、関係する発表もまとめて"
              ></textarea>
            </label>
          </p>
          <p class="muted-note">
            定時の巡回とは別に 1 回だけ走ります（進み具合にも次の予定にも触りません）。
            走るのは「{Tazuna.News.focus_sweep()}」の設定です —— <strong>落とす力と印を付け直す力を持つのはこの回だけ</strong>なので、
            「これは宣伝だから落として」も頼めます。巡回の依頼文は書き換わりません。
          </p>
          <div class="button-row">
            <button type="submit" disabled={@asking} phx-disable-with="頼んでいます…">
              Chiezo に頼む
            </button>
          </div>
        </form>
      </details>

      <%!-- AI に何を頼んでいるかは、押す前にも後にも読めるようにする。
           畳んでおくのは、ふだんは読みたいのが結果のほうだから --%>
      <details class="news-prompt">
        <summary>Chiezo への依頼文</summary>
        <p class="news-prompt-note">{prompt_note(@news)}</p>
        <pre>{prompt_text(@news, @topic)}</pre>
        <div :for={{name, text} <- sweep_prompts(@topic)}>
          <h3>{name}</h3>
          <pre>{text}</pre>
        </div>
      </details>
    </section>

    <footer>
      <p>
        収集は
        <a href="https://github.com/rtcode337/chiezo" target="_blank" rel="noreferrer">Chiezo</a>
        の「集める」層が行い、溜まったものは Chiezo のソースとして残ります。
        見出しを押すと Chiezo の中身（要約と出典）が開きます。
      </p>
    </footer>
  </div>
</main>
