<Layouts.flash_group flash={@flash} />

<main class="relations-page collect-page">
  <div>
    <header>
      <a href={~p"/"} class="brand" aria-label="tazuna トップページ"><span>t</span>tazuna</a>
      <nav aria-label="主要メニュー">
        <a href={~p"/news"}>最新情報</a>
        <a href={~p"/relations"}>関連図</a>
        <a class="active" href={~p"/datasets"}>データ収集</a>
      </nav>
    </header>

    <%!-- 集めるものごとのタブ。**収集も溜まる先も別**なので、1 つに混ぜると
         どちらの状態を見ているのか読めなくなる。並ぶのは `Tazuna.Datasets` の
         定義そのもの（定義はコードにある）。**見出しの上に置く**（関連図と同じ）——
         見出しと説明は選んだものなので、切り替える口がその下にあると、
         どこまでが切り替わるのかが読めない --%>
    <nav class="relation-tabs" aria-label="集めるもの">
      <.link
        :for={dataset <- @datasets}
        patch={~p"/datasets?view=#{dataset.key}"}
        class={if @view == dataset.key, do: "selected"}
        aria-current={if @view == dataset.key, do: "page"}
      >
        {dataset.name}
      </.link>
    </nav>

    <section class="relations-intro">
      <p>{@dataset.eyebrow}</p>
      <h1>{@dataset.title}</h1>
      <p>{@dataset.description}</p>

      <%!-- **開くたびには取りに行かない。** Chiezo の側は数時間に 1 度しか動かないので、
           いつのものを見ているかを出して、取り直すかは読む人に決めてもらう --%>
      <p class="relation-checked">
        <span class="muted-note">
          <%= if at = checked_at(assigns) do %>
            最後に取得: <strong>{Jst.format(at)}（{Jst.ago(at)}）</strong>
          <% else %>
            まだ取得していません
          <% end %>
        </span>
        <%!-- 本棚を持たない対象は、設定欄を開いているときだけ読み直すものがある --%>
        <% loading = reloading?(assigns) %>
        <button
          :if={@dataset[:derived] || @settings_open}
          type="button"
          phx-click="reload"
          disabled={loading}
          aria-busy={if loading, do: "true"}
          class={if loading, do: "is-loading"}
        >
          {if loading, do: "取得しています…", else: "最新の情報を取得"}
        </button>
      </p>
    </section>

    <%!-- **本棚**（読む側のアプリを持たない対象だけ）。**設定より先に置く** ——
         この対象で読みに来るのは、溜まった本のほう --%>
    <section :if={match?({:ok, [_ | _]}, @shelf)} class="bookshelf" aria-label="本棚">
      <% {:ok, all_books} = @shelf %>
      <% near_count = Enum.count(all_books, &(&1.near != [])) %>
      <% books =
        if @shelf_near_only, do: Enum.filter(all_books, &(&1.near != [])), else: all_books %>
      <h2>本棚 <span class="muted-note">（{length(all_books)} 冊・おすすめ度の高い順）</span></h2>
      <%!-- **興味トピックに近い本は強調する**（技術ニュースで選んだもの。言い換えと
           すぐ下の子も近いと数える）。絞り込みは押したときだけ --%>
      <p :if={near_count > 0} class="shelf-near">
        <button
          type="button"
          class={["shelf-near-toggle", @shelf_near_only && "is-on"]}
          phx-click="toggle_shelf_near"
          aria-pressed={to_string(@shelf_near_only)}
        >
          ★ 興味トピックに近い本だけ（{near_count} 冊）
        </button>
      </p>
      <p class="muted-note">
        おすすめ度は<strong>その本を勧めている記事の本数</strong>です（機械が数えたもの）。 {Tazuna.Datasets.Bookshelf.classic_sources()} 本以上で「定番」。表紙は
        <a href="https://www.hanmoto.com/" target="_blank" rel="noreferrer">版元ドットコム</a>
        の書影です。
      </p>
      <ol class="book-list">
        <li :for={book <- books} class={["book-card", book.near != [] && "is-near"]}>
          <%!-- **本を押すと詳細が開く**（ほかの画面の詳細と同じくモーダル）。
               表紙も押せる —— 目に入るのは表紙のほうが先 --%>
          <button
            type="button"
            class={["book-cover", !book.cover_url && "is-empty"]}
            phx-click="open_book"
            phx-value-title={book.title}
            aria-label={"#{book.name} の詳細を開く"}
          >
            <%!-- 表紙の無い本は 404 が返る。**壊れた画像の印を出さず、枠だけ残す** --%>
            <img
              :if={book.cover_url}
              src={book.cover_url}
              alt=""
              loading="lazy"
              onerror="this.classList.add('is-missing')"
            />
          </button>
          <div class="book-body">
            <p class="book-title">
              <button
                type="button"
                class="book-name"
                phx-click="open_book"
                phx-value-title={book.title}
              >
                {book.name}
              </button>
              <span :if={book.classic} class="book-badge">定番</span>
            </p>
            <p class="book-score">
              記事 {book.docs} 本が勧めている<span :if={book.recent > 0}>（直近 {book.recent} 本）</span>
            </p>
            <p :if={book.near != []} class="book-near">★ 興味: {Enum.join(book.near, "・")}</p>
            <p :if={book.fields != []} class="book-fields">{Enum.join(book.fields, "・")}</p>
            <p :if={book.topics != []} class="book-topics">
              <span :for={topic <- book.topics} class="book-topic">{topic}</span>
            </p>
            <p :if={book.note != ""} class="book-note">{book.note}</p>
          </div>
        </li>
      </ol>
    </section>

    <%!-- Chiezo の状態と、そこへ送る設定を **1 つの枠にまとめる**（関連図と同じ形）。
         状態を見る場所と、直す場所と、押す場所が離れていると、何がどこへ効くのか
         読めない --%>
    <%!-- 設定はページの名前を冠した 1 つの枠にまとめる（他の画面と同じ形）--%>
    <section class="settings-panel" aria-label={"#{@dataset.title}の設定"}>
      <%!-- **設定は畳んでおき、開いたときに Chiezo から読む**（関連図と同じ）。
           本棚を見に来るたびに、収集の状態・巡回・相手の一覧まで運んでいた。
           <details> にしないのは、開いたことをサーバーが知る必要があるため --%>
      <h2 class="settings-heading">
        <button
          type="button"
          id="settings-toggle"
          phx-click="toggle_settings"
          aria-expanded={to_string(@settings_open)}
          aria-controls="chiezo-settings"
        >
          <span class="settings-caret" aria-hidden="true">{if @settings_open, do: "▾", else: "▸"}</span>
          {@dataset.title}の設定
        </button>
      </h2>

      <div :if={@settings_open} id="chiezo-settings">
        <%!-- **誰が集めて、どこに残るか**を設定の頭に置く（ページの下に置いていた頃は、
           設定を読む人の目に入らなかった）。主役ではないので小さく --%>
        <p class="muted-note collect-origin">
          集めるのは
          <a href="https://github.com/rtcode337/chiezo" target="_blank" rel="noreferrer">Chiezo</a>
          の「集める」層です。tazuna が持つのは依頼と進み具合だけで、
          溜まったものは Chiezo のソース「{@dataset.collection}」として残ります
          （読むのは{@dataset.reader}です）。
        </p>
        <%!-- **区画の地図は見出しのすぐ下に置く。** どこまで見終わったかを最初に
           見たいので、状態の数字や巡回の表より先に出す --%>
        <%!-- **区画の一覧。** どこがまだ見られていないかは、ここにしか無い ——
           「ここを先に見てほしい」を頼む口でもある。数百あるので畳んで置く --%>
        <% rows = partition_rows(@state, @dataset.partition_sweeps) %>

        <%!-- **区画を地図にして出す。** 「8,185 区画のうち 2 つ見終わり」と数で言われても、
           それがどこなのかは読めない —— 押した四角から、その場で頼める --%>
        <%!-- **travel-log へはファイルで渡す。** ブラウザから直接 Chiezo を読ませるには
           CORS を開けたうえで Chiezo 自身を https で出す必要があり、LAN の中だけで
           使う機械にそこまでさせる理由がない。中身は travel-log-data と同じ形なので、
           向こうはリポジトリから取り込むのと同じ画面で入れられる --%>
        <%!-- **地図の右上に小さく置く。** 書き出すのは集まった結果なので、区画の進み具合と
           並べて見える場所がよい。主役の操作（送る・頼む）と並べると同じ重さに見える --%>
        <div :if={Tazuna.Datasets.TravelLog.exportable?(@dataset)} class="export-corner">
          <%!-- **リンクと分かる見た目にする。** 押すと降ってくるだけで、画面の状態は
             何も変わらない —— ボタンに寄せると「送る」「走らせる」と同じ重さに見える --%>
          <%!-- 組み立てに十数秒かかるので、**待っている間も押したと分かる**ように
             JS で取りに行く（DownloadLink）。JS が無ければ素のリンクとして働く --%>
          <a
            id={"download-#{@dataset.key}"}
            class="download-link"
            href={~p"/datasets/#{@dataset.key}/travel-log.zip"}
            download
            phx-hook="DownloadLink"
            data-status={"download-status-#{@dataset.key}"}
          >
            ⬇ travel-log 用の ZIP を書き出す
          </a>
          <span
            id={"download-status-#{@dataset.key}"}
            class="download-status"
            role="status"
            phx-update="ignore"
          ></span>
          <p class="muted-note">
            AI が目を通したものだけが入ります（settings.json と spots.csv）。
            目を通したあとで消えたもの（閉店など）は exclude.txt に入り、
            travel-log で読み込むと消えます。取り出しに十数秒かかります。
          </p>
        </div>

        <.partition_map
          map={Tazuna.Datasets.Map.build(rows, origin: origin_of(@plan))}
          sweeps={@dataset.partition_sweeps}
          picked={@picked}
          origin_label={@plan && @plan.place}
          find_query={@map_query}
          find_places={@map_places}
          marker={@map_marker}
        />

        <% picked = picked_row(rows, @picked) %>
        <section :if={picked} class="partition-picked" aria-label="選んだ区画">
          <h3>選んだ区画</h3>
          <dl class="collect-facts">
            <div>
              <dt>範囲（南西 / 北東）</dt>
              <dd>{picked.key}</dd>
            </div>
            <div>
              <dt>この区画にあるもの</dt>
              <dd>{picked.count} 件</dd>
            </div>
            <div>
              <dt>見終わった巡回</dt>
              <dd>{if picked.by, do: "#{picked.by}（#{picked.seen}）", else: "まだ"}</dd>
            </div>
          </dl>
          <%!-- **Chiezo の「選んだ区画で 1 回走らせる」と同じ形**にする ——
             割り込み（進み具合にも印にも触らない）は、押しても画面が変わらず
             「何が起きたのか分からない」になっていた。こちらは**ふつうの回として
             走る**ので、印が付き、読み直せば結果が見える --%>
          <form phx-submit="run_partition" phx-change="pick_run" class="collect-form">
            <input type="hidden" name="key" value={picked.key} />
            <% {plain, hands} = by_kind(@backends) %>
            <% models = models_for(@backends, @run_backend) %>
            <p>
              <label>
                どの巡回として<br />
                <select name="sweep">
                  <%!-- 手で回す回・機械で引く回は出さない（選んでも Chiezo が断る） --%>
                  <option
                    :for={name <- runnable_sweeps(@state, @dataset.partition_sweeps)}
                    value={name}
                    selected={name == @run_sweep}
                  >
                    {name}
                  </option>
                </select>
              </label>
            </p>
            <p>
              <label>
                頼む相手<br />
                <%!-- 欄の名前を `run|backend` にしておくと、モデルの入れ替えは
                   収集の表と同じ台本が引き受ける（`pages.BACKEND_PICKER_SCRIPT`）--%>
                <select name="run|backend">
                  <option value="">巡回の設定のまま</option>
                  <option :for={b <- plain} value={b.id} selected={b.id == @run_backend}>
                    {b.label}
                  </option>
                  <optgroup
                    :if={hands != []}
                    label="ワーカー（枠を見て振り替える）"
                  >
                    <option :for={b <- hands} value={b.id} selected={b.id == @run_backend}>
                      {b.label}
                    </option>
                  </optgroup>
                </select>
              </label>
              <label :if={models != []}>
                モデル<br />
                <select name="run|model">
                  <option value="">モデルは相手の既定</option>
                  <option :for={m <- models} value={m} selected={m == @run_model}>{m}</option>
                </select>
              </label>
            </p>
            <p class="muted-note">
              <strong>ふつうの回として走ります</strong> —— この区画に「見た」印が付き、
              進み具合も次の予定も進みます。AI の呼び出しは<strong>この 1 区画ぶん</strong>です。
            </p>
            <div class="button-row">
              <button type="submit" disabled={@asking} phx-disable-with="走らせています…">
                この区画で 1 回走らせる
              </button>
              <button type="button" phx-click="unpick_partition">やめる</button>
            </div>
          </form>
        </section>

        <%!-- **起点。** ざっと見るも情報収集も、ここから近い順に区画を広げる。
           **Chiezo の収集の起点にも同じものを送る**（区画を選ぶのは Chiezo）。
           区画の地図のすぐ下に置く —— どこから広がっているかを地図と並べて読むため --%>
        <section
          :if={@plan && Tazuna.Datasets.uses_origin?(@dataset)}
          class="survey-plan"
          aria-label="起点"
        >
          <h3>起点</h3>
          <p class="muted-note">
            「ざっと見る」も「情報収集」も、この起点から近い順に区画を広げます（決めていなければ東京駅）。
            決め直すと、Chiezo の収集の起点も書き換えます。
          </p>
          <p :if={@origin_note} class="warn-note">{@origin_note}</p>

          <dl class="collect-facts">
            <div>
              <dt>起点</dt>
              <dd>
                <%!-- 決めた時刻が無いのは既定（東京駅）のまま --%>
                {@plan.place}（{Float.round(@plan.lat, 4)}, {Float.round(@plan.lon, 4)}）<%!--
                **その座標を地図で確かめる口は、座標のすぐ後ろに**。地名で選んだので、
                同じ名前の別の場所（駅と交差点など）を選んでいないかは、地図で見ないと
                分からない。場所を取らないようアイコンにする（名前は読み上げとヒントで） --%><a
                  class="map-open"
                  href={google_maps_url(@plan)}
                  target="_blank"
                  rel="noreferrer"
                  title="Google マップで開く"
                  aria-label="Google マップで開く"
                ><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path
                  d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"
                  fill="currentColor"
                /></svg></a>
                <%!-- **いつ決めたかは次の行に**（狭い画面で座標の途中から折り返すと読みにくい） --%>
                <span class="muted-note origin-when">
                  {if @plan.place_set_at,
                    do: "#{Jst.format(@plan.place_set_at)} に決めました",
                    else: "既定のままです"}
                </span>
              </dd>
            </div>
          </dl>

          <form id="place-search" phx-submit="search_place" class="survey-row">
            <input
              type="search"
              name="q"
              value={@place_query}
              placeholder="起点の地名（例: 銀座、京都駅）"
              aria-label="起点の地名"
            />
            <button type="submit">探す</button>
          </form>
          <%= cond do %>
            <% @places == :loading -> %>
              <p class="muted-note">探しています…</p>
            <% match?({:error, _reason}, @places) -> %>
              <p class="warn-note">探せませんでした: {reason_text(elem(@places, 1))}</p>
            <% match?({:ok, []}, @places) -> %>
              <p class="muted-note">見つかりませんでした。別の書き方で探してください。</p>
            <% match?({:ok, _found}, @places) -> %>
              <ul class="place-candidates">
                <li :for={{place, index} <- Enum.with_index(elem(@places, 1))}>
                  <button type="button" phx-click="pick_place" phx-value-index={index}>
                    {place.name}
                  </button>
                  <span class="muted-note">{place_label(place)}</span>
                </li>
              </ul>
            <% true -> %>
          <% end %>
        </section>

        <h3>Chiezo の収集</h3>
        <p aria-live="polite">{status_message(@state)}</p>
        <p class="muted-note">{push_note(@state)}</p>

        <dl :if={collection_facts(@state) != []} class="collect-facts">
          <div :for={{label, value} <- collection_facts(@state)}>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        </dl>

        <%!-- **選んだところはサーバーが覚える**（`phx-change`）。覚えないと、状態が
           届いた拍子にフォームが描き直され、選んだ相手が元の値に戻る --%>
        <form id="collect-form" phx-submit="collect" phx-change="pick_sweep">
          <.sweep_table
            state={@state}
            picks={@picks}
            backends={@backends}
            triggered={List.wrap(@dataset[:survey_plan_sweep])}
          />

          <p class="muted-note">
            収集の名前は「{@dataset.collection}」です（Chiezo のソース名。<strong>後から変えません</strong>
            —— 変えると、それまで溜めた先を見失います）。
          </p>
          <div class="button-row">
            <button
              type="submit"
              phx-disable-with="送っています…"
              disabled={@state.pushing}
            >
              {collect_label(@state)}
            </button>
          </div>
        </form>

        <p :if={@state.collection && @state.collection.url} class="muted-note">
          <a href={@state.collection.url} target="_blank" rel="noreferrer">Chiezo で見る</a>
        </p>

        <%!-- **依頼文は「Chiezo の収集」のためのもの**なので、その節の中に置く --%>
        <%!-- **機械で引いたものと AI が書いたものの線引きが、ここでいちばん大事なところ**。
           どちらも Chiezo が持っているものなので、1 つにまとめて出す --%>
        <details class="news-prompt">
          <summary>Chiezo への依頼文</summary>

          <%!-- 抽出の指定と区画の割り方は、**持つ対象だけ**（技術書はどちらも持たない） --%>
          <% extract = extract_text(assigns) %>
          <% partition = partition_text(assigns) %>
          <%= if extract do %>
            <h3>抽出の指定（辞典から機械的に引く条件）</h3>
            <p class="news-prompt-note">
              名前・座標・住所・電話・サイト・ジャンル・紹介文は、この指定で辞典から引いています。 <strong>AI は関わりません</strong>（決まった結果が出ます）。 <strong>何本かに分けて書いてあれば、書いた順が優先の順</strong>です ——
              <code>provides</code>
              はその辞典が<strong>勝ちにいく項目</strong>で、
              そこに書いていない項目は、どの辞典も埋めなかったときだけ使われます。
            </p>
            <pre>{extract}</pre>
          <% end %>

          <%= if partition do %>
            <h3>区画の割り方</h3>
            <p class="news-prompt-note">
              巡回はここで割った区画を 1 つずつ回ります。<strong>母集団は集めたもの自身</strong>なので、
              座標が直れば区画も追随し、育ちすぎた区画・空になった区画は Chiezo が割り直します。
            </p>
            <pre>{partition}</pre>
          <% end %>

          <h3>指示文（AI に頼んでいる内容）</h3>
          <p :if={extract} class="news-prompt-note">
            AI が書くのは<strong>辞典に書いていないこと</strong>だけです ——
            まだ開いているか、食べに行く価値があるか、どんな店か。
            どこを見るかは Chiezo が区画で渡すので、指示文には書いてありません。
          </p>
          <div :for={{name, text} <- sweep_prompts(assigns)}>
            <h3>{name}</h3>
            <pre>{text}</pre>
          </div>
        </details>

        <%!-- **情報収集の時刻。** 情報収集は 1 区画に何分もかかる仕事なので、Chiezo の
           時計では走らせず、決めた時刻に tazuna が起こす（見る区画は Chiezo が選ぶ）。
           **巡回の表のすぐ下に置く** —— 表の「時計なし・頼まれたとき」が、いつ頼まれる
           のかをすぐ下で読めるように --%>
        <section :if={@plan} class="survey-plan" aria-label={"#{@dataset.survey_plan_sweep}の時刻"}>
          <h3>{@dataset.survey_plan_sweep}の時刻</h3>
          <p :if={Tazuna.Datasets.uses_origin?(@dataset)} class="muted-note">
            決めた時刻に tazuna が情報収集を 1 回起こします。見る区画は Chiezo が選びます
            （その巡回で見た古い順、同じなら起点に近い順）。
            Chiezo が取り込み中なら、次の予定の時刻まで空くのを待って頼みます。
          </p>
          <dl class="collect-facts">
            <div>
              <dt>次に頼む</dt>
              <dd>{next_survey(@plan) || "時刻が決まっていません"}</dd>
            </div>
            <div :if={@plan.last_result not in [nil, ""]}>
              <dt>前回</dt>
              <dd>{@plan.last_result}</dd>
            </div>
          </dl>

          <.form
            for={@plan_form}
            id="survey-times"
            phx-submit="save_survey_times"
            class="survey-row"
          >
            <input
              type="text"
              name={@plan_form[:run_at].name}
              value={@plan_form[:run_at].value}
              placeholder="頼む時刻（例: 03:00,15:00）"
              aria-label="頼む時刻"
            />
            <button type="submit">時刻を保存</button>
          </.form>
          <p :for={{message, _opts} <- @plan_form[:run_at].errors} class="warn-note">{message}</p>

          <div class="button-row">
            <button
              :if={Tazuna.Datasets.ready_to_survey?(@dataset, @plan)}
              type="button"
              phx-click="survey_now"
              disabled={@surveying}
              phx-disable-with="頼んでいます…"
            >
              {if @surveying, do: "頼んでいます…", else: "いま 1 回頼む"}
            </button>
          </div>
        </section>

        <%!-- **この収集から作る収集**（本棚・話題の網）。**親の下に置く** ——
           別のタブにすると、何から作られたものかが読めなくなる --%>
        <%!-- **囲まずに上に線を引くだけ**（ほかの節と同じ形）。設定の枠の中でさらに
           囲むと、枠の中に枠が入り、どこまでが 1 つの設定なのか読みにくい --%>
        <section
          :if={@dataset[:derived]}
          class="settings-block lined-block"
          aria-label="この収集から作るもの"
        >
          <h3>{@dataset.derived.name()}</h3>
          <p>
            上の収集に付いた<strong>タグから機械で作ります</strong>。
            数えるのは Chiezo で、<strong>AI がやるのは整えるところだけ</strong>です
            （言い換えを畳む・分野を付ける・技術書でない語を外す・一言で説明する）。
          </p>
          <%!-- **親の収集と同じ形で出す**（状態・巡回ごとの相手・送る）。ボタンだけだと、
             いま Chiezo にあるのか、どの相手に頼んでいるのかが読めない --%>
          <p aria-live="polite">{status_message(@derived_state)}</p>

          <dl :if={@derived_state.collection} class="collect-facts">
            <div :for={{label, value} <- collection_facts(@derived_state)}>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          </dl>

          <form
            id="derived-collect-form"
            phx-submit="collect_derived"
            phx-change="pick_derived_sweep"
          >
            <.sweep_table state={@derived_state} picks={@derived_picks} backends={@backends} />
            <p class="muted-note">
              溜め先は別の収集です（<code>{@dataset.derived.collection()}</code>）。
              <strong>止めた状態で作ります</strong>
              —— 動き出すのは Chiezo の管理画面で
              有効にしたときだけです。
            </p>
            <div class="button-row">
              <button
                type="submit"
                phx-disable-with="送っています…"
                disabled={@derived_state.pushing}
              >
                {collect_label(@derived_state)}
              </button>
            </div>
          </form>

          <p :if={@derived_state.collection && @derived_state.collection.url} class="muted-note">
            <a href={@derived_state.collection.url} target="_blank" rel="noreferrer">Chiezo で見る</a>
          </p>

          <%!-- 本棚の収集に何を頼んでいるか（親の収集と同じ形）。機械収集の回は AI を呼ばず、
             記事のタグを数えるだけなので、その指定を出す --%>
          <details class="news-prompt">
            <summary>Chiezo への依頼文</summary>
            <%= if extract = derived_extract(@dataset) do %>
              <h3>抽出の指定（記事のタグを機械で数える条件）</h3>
              <p class="news-prompt-note">
                上の収集の記事に付いた「本:」のタグを数えます。<strong>AI は関わりません</strong>。
              </p>
              <pre>{extract}</pre>
            <% end %>
            <div :for={{name, text} <- derived_prompts(@dataset)}>
              <h3>{name}</h3>
              <pre>{text}</pre>
            </div>
          </details>
        </section>

        <details :if={rows != []} class="partition-list">
          <% progress = partition_progress(rows, @dataset.partition_sweeps) %>
          <summary>
            区画（<span :if={progress}>{elem(progress, 1)} / </span>{length(rows)}）
          </summary>
          <p class="muted-note">
            <span :if={progress}>
              「/」の前は「{elem(progress, 0)}」が見終わった区画の数です（先の巡回が一周したら、次の巡回の数に変わります）。
            </span>
            まだ見ていないものが先に表示されます。
            区画は<strong>座標で</strong>切ってあります（鍵は「南西の緯度経度／北東の緯度経度」）。
            店の多いところは細かく、少ないところは粗くなります。 <strong>押すと、その区画を先に調べてもらえます</strong>（印が付くので、
            巡回が同じところをもう一度見ることはありません）。
          </p>
          <table class="partition-table">
            <thead>
              <tr>
                <th>区画</th>
                <th>件数</th>
                <th>見終わった巡回</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <tr :for={row <- Enum.take(rows, shown_partitions())}>
                <td>{row.key}</td>
                <td>{row.count}</td>
                <td>{if row.by, do: "#{row.by}（#{row.seen}）", else: "まだ"}</td>
                <td>
                  <button type="button" phx-click="pick_partition" phx-value-key={row.key}>
                    選ぶ
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
          <p :if={length(rows) > shown_partitions()} class="muted-note">
            先頭の {shown_partitions()} 区画だけ出しています（残り {length(rows) - shown_partitions()} 区画）。
            並びは「いちばん長く見ていない順」なので、上から順に回ってきます。
          </p>
        </details>

        <%!-- **travel-log からの依頼**（travel-log が読む収集だけ）。管理画面の
           「修正・追加の依頼」のテキストを貼ると、座標を含む区画の情報収集に、
           そのテキストを補足として載せて頼む。割り込みと違ってふつうの回として走るので、
           書かれていない足りないものも探しに行く --%>
        <details :if={@state.collection && @dataset.reader == "travel-log"} class="ask-more">
          <summary>travel-log からの依頼</summary>
          <form phx-submit="travel_log_request">
            <p>
              <label>
                travel-log の「修正・追加の依頼」のテキスト<br />
                <textarea
                  name="text"
                  rows="6"
                  placeholder="- [修正] 店名 (35.68123,139.76712): 閉店している&#10;- [追加] (35.68000,139.76000): うどんの名店がある"
                ></textarea>
              </label>
            </p>
            <p class="muted-note">
              travel-log の管理画面の「渡すテキスト」をそのまま貼ってください。
              座標を含む区画（1 回に {Requests.max_partitions()} まで）で「{@dataset.survey_plan_sweep}」を
              1 回走らせ、依頼を区画ごとに振り分けて、その区画に入るぶんだけを依頼文の補足として載せます。ふつうの回として走るので、
              区画には印が付きます。取り込み中なら空くまで待ちます。
            </p>
            <div class="button-row">
              <button
                type="submit"
                disabled={@requesting != nil}
                phx-disable-with="見積もっています…"
              >
                区画を引いて頼む
              </button>
            </div>
          </form>
        </details>
        <p :if={request_message(@requesting, @requested)} class="muted-note" aria-live="polite">
          {request_message(@requesting, @requested)}
        </p>

        <%!-- **依頼と、その結果を並べる。** 結果は Chiezo の変更履歴から、頼んだ後に
           同じ区画を見た回を引き当てたもの。見出しを押すと、Chiezo の画面で
           その 1 件の「直す前との違い」が開く --%>
        <section
          :if={@dataset.reader == "travel-log" and @request_results != []}
          class="request-results"
          aria-label="依頼の結果"
        >
          <header class="request-results-head">
            <h3>依頼の結果</h3>
            <button type="button" phx-click="reload_request_results">読み直す</button>
          </header>
          <details
            :for={{entry, index} <- Enum.with_index(@request_results)}
            class="request-result"
            open={index == 0}
          >
            <summary>
              <span class="request-when">{Jst.format(entry.log.requested_at)}</span>
              <span class="request-scope">
                座標 {entry.log.points} 件 → 区画 {length(entry.log.keys)} つ
              </span>
              <span class={["request-state", entry.result && "has-result"]}>
                {request_state(entry)}
              </span>
            </summary>

            <%= if entry.result && entry.result.status == "ok" do %>
              <p class="muted-note">
                {Jst.format(entry.result.at)} に終わった回{if entry.result.backend,
                  do:
                    "（#{entry.result.backend}#{if entry.result.model, do: " / #{entry.result.model}", else: ""}）",
                  else: ""}。見出しを押すと、Chiezo の画面で直す前との違いが開きます。
              </p>
              <div
                :for={
                  {label, titles, count, class} <- [
                    {"足した", entry.result.added_titles, entry.result.added, "is-added"},
                    {"直した", entry.result.updated_titles, entry.result.updated, "is-updated"},
                    {"消した", entry.result.removed_titles, entry.result.removed, "is-removed"}
                  ]
                }
                :if={count > 0}
                class={["request-changes", class]}
              >
                <h4>{label}（{count} 件）</h4>
                <ul>
                  <li :for={title <- titles}>
                    <a
                      :if={Tazuna.Chiezo.doc_page_url(@dataset.collection, title)}
                      href={Tazuna.Chiezo.doc_page_url(@dataset.collection, title)}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {title}
                    </a>
                    <span :if={!Tazuna.Chiezo.doc_page_url(@dataset.collection, title)}>{title}</span>
                  </li>
                  <li :if={more_than_shown(count, titles) > 0} class="muted-note">
                    ほか {more_than_shown(count, titles)} 件（Chiezo の控えは頭のほうだけ）
                  </li>
                </ul>
              </div>
              <p
                :if={entry.result.added + entry.result.updated + entry.result.removed == 0}
                class="muted-note"
              >
                この回では何も変わりませんでした。
              </p>
            <% end %>

            <details class="request-text">
              <summary>依頼の中身</summary>
              <pre>{entry.log.text}</pre>
            </details>
          </details>
        </section>

        <%!-- **何が溜まるのかを、使う側の項目で書く。** ここで「どの項目がどこから
           来るか」が読めないと、足りない項目に気づけない。**読む相手も単位も対象ごとに
           違う**ので、文面は定義の側が持つ --%>
        <section class="settings-block lined-block" aria-label={"#{@dataset.reader} に渡す中身"}>
          <h3>{@dataset.reader} に渡す中身</h3>
          <p>
            {@dataset.unit}で溜まります。{@dataset.reader}は <strong>タグ「{@dataset.module.kind_tag()}」</strong>で拾い、次の項目を読みます。
          </p>
          <table class="sweep-table">
            <thead>
              <tr>
                <th>項目</th>
                <th>収集の中身</th>
                <th>誰が入れるか</th>
              </tr>
            </thead>
            <tbody>
              <tr :for={row <- field_rows(@dataset)}>
                <td>{row.field}</td>
                <td>{row.stored}</td>
                <td>{row.who}</td>
              </tr>
            </tbody>
          </table>
          <p :if={@dataset[:note]} class="muted-note">{@dataset[:note]}</p>
        </section>
      </div>
    </section>

    <%!-- **本の詳細**（ほかの画面の詳細と同じくモーダル）。勧めている記事と、その本について
       Chiezo へ頼む口（本棚の整理の回への割り込み）を置く —— 頼みごとは本を見ながら
       思いつくので、設定の欄に離して置くと、どの本の話か書き直すことになる --%>
    <% book = opened_book(assigns) %>
    <div :if={book} class="artwork-backdrop" phx-window-keydown="close_book" phx-key="Escape">
      <section
        class="artwork book-detail"
        role="dialog"
        aria-modal="true"
        aria-labelledby="book-detail-title"
        phx-click-away="close_book"
      >
        <div class="artwork-head">
          <strong id="book-detail-title">
            {book.name} <span :if={book.classic} class="book-badge">定番</span>
          </strong>
          <button type="button" phx-click="close_book">閉じる</button>
        </div>
        <div class="book-detail-body">
          <span :if={book.cover_url} class="book-detail-cover">
            <img src={book.cover_url} alt="" onerror="this.classList.add('is-missing')" />
          </span>
          <div>
            <p class="book-score">
              記事 {book.docs} 本が勧めている<span :if={book.recent > 0}>（直近 {book.recent} 本）</span>
            </p>
            <p :if={book.near != []} class="book-near">★ 興味: {Enum.join(book.near, "・")}</p>
            <p :if={book.fields != []} class="book-fields">{Enum.join(book.fields, "・")}</p>
            <p :if={book.topics != []} class="book-topics">
              <span :for={topic <- book.topics} class="book-topic">{topic}</span>
            </p>
            <p :if={book.note != ""} class="book-note">{book.note}</p>
            <p :if={book.page_url} class="muted-note">
              ISBN {book.isbn}・<a href={book.page_url} target="_blank" rel="noreferrer">版元ドットコムで見る ↗</a>
            </p>
            <p :if={!book.page_url} class="muted-note">
              ISBN はまだ分かっていません（本棚の整理の回が調べると、表紙も出ます）。
            </p>
          </div>
        </div>

        <h3>勧めている記事</h3>
        <%= case @book_posts[book.title] do %>
          <% {:ok, [_ | _] = posts} -> %>
            <ul class="book-posts">
              <li :for={post <- posts}>
                <a :if={post.url} href={post.url} target="_blank" rel="noreferrer">{post.title}</a>
                <span :if={!post.url}>{post.title}</span>
                <span :if={post.published_at != ""} class="muted-note">
                  {String.slice(post.published_at, 0, 10)}
                </span>
              </li>
            </ul>
          <% {:ok, []} -> %>
            <p class="muted-note">記事が見つかりませんでした。</p>
          <% {:error, reason} -> %>
            <p class="muted-note">{reason_text(reason)}</p>
          <% _loading -> %>
            <p class="muted-note">記事を読んでいます…</p>
        <% end %>

        <form id="book-ask" phx-submit="ask_book" class="article-ask">
          <input type="hidden" name="title" value={book.title} />
          <label>
            この本を Chiezo に調べ直してもらう<br />
            <textarea
              name="note"
              rows="3"
              placeholder="例: 表紙が別の本になっている / 分野が違う / 第 2 版が出ている"
            ></textarea>
          </label>
          <p class="muted-note">
            本棚の収集（{@dataset.derived && @dataset.derived.collection()}）の「整理」の回として、
            この本だけを 1 回調べ直します（分野・タグ・説明・ISBN を確かめ、違っていれば直す）。
            定時の巡回の進み具合にも次の予定にも触りません。書き添えたことは補足として渡します。
          </p>
          <div class="button-row">
            <button type="submit" disabled={@book_asking} phx-disable-with="頼んでいます…">
              Chiezo に頼む
            </button>
          </div>
          <p :if={ask_message(@book_asked)} class="muted-note" aria-live="polite">
            {ask_message(@book_asked)}
          </p>
        </form>
      </section>
    </div>
  </div>
</main>
