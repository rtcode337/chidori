<Layouts.flash_group flash={@flash} />
<main class="news-page">
  <div>
    <header>
      <a href={~p"/"} class="brand" aria-label="tazuna トップページ">
        <span> t </span>
        <strong>tazuna</strong>
      </a>
      <nav aria-label="主要メニュー">
        <a href={~p"/news"}>最新情報</a>
        <a class="active" href={~p"/topics"}>トピック</a>
        <a href={~p"/relations"}>関連図</a>
        <a href={~p"/datasets"}>データ収集</a>
      </nav>
    </header>

    <section class="news-intro">
      <p>TOPIC MAP</p>
      <h1>{if @topic, do: "#{@topic.name}のトピック", else: "トピック"}</h1>
      <p>
        記事から育った話題の網です。<strong>育てるのは Chiezo</strong> ——
        流れてきた記事といま持っているトピックを AI が読んで、少しずつ足して整えます。
        tazuna は依頼文を渡して、できたものを読むだけです。
      </p>
    </section>

    <nav :if={@topics != []} class="relation-tabs" aria-label="話題">
      <.link
        :for={topic <- @topics}
        patch={~p"/topics?view=#{topic.collection}"}
        class={if @topic && @topic.collection == topic.collection, do: "selected"}
      >
        {topic.name}
      </.link>
    </nav>

    <p :if={@loading} class="muted-note" aria-live="polite">Chiezo から読んでいます…</p>

    <%!-- 網の図。**丸の大きさはつながりの数**（記事の件数はこの収集が持っていない）。
         先の無い線は引かない（AI が存在しないトピックを指すことはある） --%>
    <% map = graph(@state) %>
    <section :if={map.nodes != []} class="topic-map" aria-label="トピックの網">
      <svg
        viewBox={"0 0 #{map.width} #{map.height}"}
        role="img"
        aria-label="トピックのつながり"
      >
        <g class="topic-edges">
          <g :for={edge <- map.edges}>
            <line
              x1={edge.x1}
              y1={edge.y1}
              x2={edge.x2}
              y2={edge.y2}
              class={if edge.kind == :parent, do: "is-parent"}
            />
            <text :if={edge.note != ""} x={edge.label_x} y={edge.label_y} text-anchor="middle">
              {edge.note}
            </text>
          </g>
        </g>
        <g class="topic-nodes">
          <g :for={node <- map.nodes}>
            <circle
              cx={node.x}
              cy={node.y}
              r={node.r}
              style={
                node.hue && "fill: hsl(#{node.hue} 70% 92%); stroke: hsl(#{node.hue} 55% 55%)"
              }
            />
            <text x={node.label_x} y={node.label_y} text-anchor={node.anchor}>{node.name}</text>
          </g>
        </g>
      </svg>
      <p :if={map.hidden > 0} class="muted-note">
        つながりの多い {length(map.nodes)} 件を出しています（あと {map.hidden} 件は下の一覧に）。
      </p>
    </section>

    <%!-- 一覧。図に出ないものもここには並ぶ（図は置ける数に限りがある） --%>
    <section :if={@state.themes != []} class="theme-list" aria-label="トピックの一覧">
      <article :for={theme <- sorted_themes(@state)}>
        <h2>
          {theme.name}
          <span :if={theme.field} class="theme-count">{theme.field}</span>
        </h2>
        <p :if={theme.note != ""} class="news-summary">{theme.note}</p>
        <p :if={theme.parent} class="muted-note">上位: {theme.parent}</p>
        <ul :if={theme.related != []} class="theme-children">
          <li :for={related <- theme.related}>
            <strong>{related.to}</strong>
            <span :if={related.note != ""} class="muted-note">{related.note}</span>
          </li>
        </ul>
      </article>
    </section>

    <section class="collect-panel" aria-label="トピックの収集">
      <h2>Chiezo の収集</h2>
      <p aria-live="polite">{note(@state)}</p>

      <dl :if={@state.collection} class="collect-facts">
        <div :for={{label, value} <- collection_facts(@state)}>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      </dl>

      <form id="theme-collect-form" phx-submit="collect" phx-change="pick_sweep">
        <.sweep_table state={@state} picks={@picks} backends={@backends} />
        <p class="muted-note">
          <strong>育てる回は記事を読み、整える回は手元にあるものだけを読みます。</strong> 1 本にまとめると、足すたびに全部を読み直すか、畳むために毎回記事を読むかに
          なります。配信元は最新情報と同じものを使います。
        </p>
        <button type="submit" phx-disable-with="送っています…">{collect_label(@state)}</button>
      </form>

      <p>
        <button
          :if={@state.collection}
          type="button"
          phx-click="grow"
          phx-disable-with="頼んでいます…"
        >
          いま育てる
        </button>
        <button type="button" phx-click="refresh" phx-disable-with="読んでいます…">
          読み直す
        </button>
      </p>

      <p :if={@state.collection && @state.collection.url} class="muted-note">
        <a href={@state.collection.url} target="_blank" rel="noreferrer">Chiezo で見る</a>
      </p>
    </section>

    <footer>
      <p>
        トピックは
        <a href="https://github.com/rtcode337/chiezo" target="_blank" rel="noreferrer">Chiezo</a>
        の収集として溜まります（記事とは別の収集です —— 記事は 30 日で落ちますが、
        トピックは期限では落としません）。
      </p>
    </footer>
  </div>
</main>
