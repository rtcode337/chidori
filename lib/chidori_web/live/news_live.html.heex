<Layouts.flash_group flash={@flash} />
<%!-- **見た目は関連図・データ収集と同じ枠**（`relations-page`）。画面ごとに色や
     見出しの作りが違うと、同じアプリの中を移っている気がしない --%>
<%!-- 頭のメニューとタブは main の外に置き、画面の上に残す（スクロールするのは main の中だけ。root.html.heex） --%>
<div class="relations-page page-head">
  <div>
    <% hobby? = Chidori.Topics.hobby?(@topic || %{}) %>
    <ChidoriWeb.MainNav.main_nav active={
      cond do
        @collect_mode -> :collect
        hobby? -> :datasets
        true -> :news
      end
    } />
    <ChidoriWeb.CollectTabs.collect_tabs
      :if={@collect_mode}
      current={if hobby?, do: :datasets, else: :news}
    />
    <%!-- **映画・アニメは趣味の段**（データの対象と同じタブに並べる）。画面はこのまま --%>
    <ChidoriWeb.DiningTabs.dataset_tabs
      :if={hobby?}
      datasets={Chidori.Datasets.list()}
      current={@topic.collection}
      mode={if @collect_mode, do: :collect, else: :read}
      elsewhere={true}
    />

    <%!-- 話題ごとのタブ。**集めるものも溜まるものも話題ごとに別**なので、
         1 つに混ぜると、どちらの状態を見ているのか読めなくなる。
         並ぶのは `Chidori.Topics` の話題そのもの（定義はコードにある）。
         **見出しの上に置く**（関連図・データ収集と同じ）—— 見出しと説明は選んだ話題の
         ものなので、切り替える口がその下にあると、どこまでが切り替わるのかが読めない --%>
    <nav
      :if={@topics != [] and !hobby?}
      id="topic-tabs"
      class="relation-tabs"
      phx-hook="ScrollTabs"
      aria-label="話題"
    >
      <.link
        :for={topic <- @topics}
        patch={"#{@base_path}?view=#{topic.collection}"}
        class={if @topic && @topic.collection == topic.collection, do: "selected"}
        aria-current={if @topic && @topic.collection == topic.collection, do: "page"}
      >
        {topic.name}
      </.link>
      <%!-- お気に入りは話題をまたいだ 1 つの一覧なので、話題のタブの最後に置く（収集の画面には無い） --%>
      <.link
        :if={!@collect_mode}
        patch={~p"/news?view=#{favorites_view()}"}
        class={if @favorites_view, do: "selected"}
        aria-current={if @favorites_view, do: "page"}
      >
        お気に入り
      </.link>
    </nav>
  </div>
</div>

<main id="page-scroll" class="relations-page news-page" phx-hook="PageScroll">
  <div>
    <section class="relations-intro">
      <p>DAILY UPDATES</p>
      <h1>
        {cond do
          @favorites_view -> "お気に入り"
          @topic -> @topic.name
          true -> "ニュース"
        end}
      </h1>
      <p :if={!@favorites_view and !@collect_mode}>
        集めるのは Chiezo です。Chidori は収集を依頼して、溜まったものを読みます。
        <.link :if={@topic} navigate={"/collect/news?view=#{@topic.collection}"}>この話題の収集の画面へ</.link>
      </p>
      <p :if={@collect_mode}>
        この話題の収集を Chiezo に頼む画面です。依頼して作られる収集は止まった状態なので、
        動かすまで AI が勝手に動くことはありません。
        <.link :if={@topic} navigate={"/news?view=#{@topic.collection}"}>読む画面へ</.link>
      </p>
      <p :if={@favorites_view}>
        記事の詳細から ☆ を押した記事です。残しているのは見出しと URL だけで、
        記事そのものが Chiezo から消えても、ここからは原文を開けます。
      </p>
    </section>
    <%!-- **見る画面と収集の画面を分ける**（`@collect_mode`）。見る画面は集めたものを出すだけで、
         収集の設定・時刻・1 回だけ頼む口は収集の画面（`/collect/news`）に置く --%>
    <%= if !@collect_mode do %>
      <%!-- **お気に入りの一覧**（話題をまたいで、付けた日の新しい順）。話題ごとの節は出さない --%>
      <section :if={@favorites_view} class="favorite-list" aria-label="お気に入りの記事">
        <p :if={@favorite_error} class="muted-note" aria-live="polite">{@favorite_error}</p>
        <p :if={@favorites == []} class="muted-note">
          まだありません。記事の詳細の「☆ お気に入りに入れる」で足せます。
        </p>
        <ul :if={@favorites != []}>
          <li :for={favorite <- @favorites}>
            <a href={SafeUrl.href(favorite.url)} target="_blank" rel="noreferrer">{favorite.title}</a>
            <span :if={favorite.on} class="muted-note">{Date.to_iso8601(favorite.on)}</span>
            <button type="button" phx-click="remove_favorite" phx-value-url={favorite.url}>
              外す
            </button>
          </li>
        </ul>
      </section>

      <%!-- まとめ。**カレンダーと記事の一覧より先に出す**（映画の注目作の一覧は長いので、
         下に置くと要約が見えなくなっていた） —— 溜まったものをそのまま並べても
         読めないので、何が起きたかを先に言う（通知へ流れるのは、この中の要旨） --%>
      <%!-- 要約を別の収集から読む話題（市況ニュース）は、書き手ごとの要約。
         **Chidori 自身の要約は出さない**（作るのをやめる前に溜まった分が Chiezo に残っていても） --%>
      <section
        :if={@topic && Chidori.Topics.digest_from(@topic)}
        class="news-digest"
        aria-label="要約"
      >
        <h2 class="news-section-title">要約（AI ごと）</h2>
        <ChidoriWeb.AiDigests.ai_digests
          digests={@ai_digests}
          label={@topic.name}
          id_prefix="news-ai"
        />
      </section>

      <section
        :if={@news.digests != [] and !(@topic && Chidori.Topics.digest_from(@topic))}
        class="news-digest"
        aria-label="要約"
      >
        <h2 class="news-section-title">要約</h2>
        <.digest_preview
          digests={@news.digests}
          kind="main"
          label={@topic && @topic.name}
          articles={@news.articles}
          hero={hero?(@topic)}
        />
      </section>

      <%!-- 興味トピックの要約。**ふつうの要約のすぐ下** —— 同じ期間を、読む人が選んだ
         語に絞って書いた別の 1 本（興味トピックを選んでいなければ書かれない） --%>
      <section
        :if={@news.interest_digests != []}
        class="news-digest"
        aria-label="興味トピックの要約"
      >
        <h2 class="news-section-title">興味トピックの要約</h2>
        <.digest_preview
          digests={@news.interest_digests}
          kind="interest"
          label="興味トピック"
          articles={@news.articles}
          hero={hero?(@topic)}
        />
      </section>

      <%!-- 開催日のカレンダー（技術イベント）。**記事の一覧より先に出す** ——
         イベントは読み物ではなく「いつ・どこで・行く価値があるか」で選ぶもの。
         注目度の高いものを色付きで上に並べ、低いものは件数だけに畳む
         （connpass の新着は 1 日に数十件入るので、全部並べるとマスが埋まる） --%>
      <section
        :if={@topic && Chidori.Topics.calendar?(@topic)}
        class="event-calendar"
        aria-label={"#{Chidori.Topics.date_tag(@topic)}のカレンダー"}
      >
        <header class="event-calendar-head">
          <h2 class="news-section-title">{Chidori.Topics.date_tag(@topic)}のカレンダー</h2>
          <div class="event-calendar-nav">
            <button type="button" phx-click="cal_shift" phx-value-by="-1" aria-label="前の月">
              ‹
            </button>
            <strong>{cal_title(@cal_month)}</strong>
            <button type="button" phx-click="cal_shift" phx-value-by="1" aria-label="次の月">
              ›
            </button>
            <button type="button" phx-click="cal_today">今月</button>
          </div>
        </header>

        <p :if={@cal_events in [nil, :loading]} class="muted-note">読み込んでいます…</p>
        <p :if={match?({:error, _}, @cal_events)} class="muted-note">
          {cal_error(@cal_events)}
        </p>

        <%= if match?({:ok, _}, @cal_events) do %>
          <% {:ok, all} = @cal_events %>
          <% shown = Events.only_places(all, @cal_places) %>
          <div
            :if={Events.places_of(all) != []}
            class="event-places"
            role="group"
            aria-label="開催地で絞る"
          >
            <button
              type="button"
              phx-click="cal_all_places"
              class={@cal_places == [] && "selected"}
              aria-pressed={to_string(@cal_places == [])}
            >
              すべて
            </button>
            <%!-- 国内か海外かで「行けるか」の読み方がまるで違うので、まとめて選べる口を置く --%>
            <button
              :for={group <- cal_groups(all)}
              type="button"
              phx-click="cal_place"
              phx-value-place={group}
              class={["event-place-group", group in @cal_places && "selected"]}
              aria-pressed={to_string(group in @cal_places)}
            >
              {group}
            </button>
            <button
              :for={place <- Events.places_of(all)}
              type="button"
              phx-click="cal_place"
              phx-value-place={place}
              class={[
                place in @cal_places && "selected",
                Events.region(place) == :abroad && "is-abroad"
              ]}
              aria-pressed={to_string(place in @cal_places)}
            >
              {place}
            </button>
          </div>
          <p class="muted-note">
            この月に {length(shown)} 件。<span class="event-chip is-high">注目度 高</span>
            <span class="event-chip is-mid">中</span>
            を並べ、低いものは件数だけ出します。日を押すと、その日の{Chidori.Topics.item_word(@topic)}が全部並びます。
          </p>

          <table class="event-grid">
            <thead>
              <tr>
                <th :for={name <- ~w(日 月 火 水 木 金 土)} scope="col">{name}</th>
              </tr>
            </thead>
            <tbody>
              <tr :for={week <- Events.weeks(@cal_month, shown)}>
                <td
                  :for={cell <- week}
                  class={[
                    !cell.in_month && "is-outside",
                    cell.date == Chidori.Jst.today() && "is-today",
                    cell.date == @cal_day && "is-picked"
                  ]}
                >
                  <button
                    type="button"
                    class="event-day"
                    phx-click="cal_day"
                    phx-value-date={Date.to_iso8601(cell.date)}
                    disabled={cell.events == []}
                    aria-pressed={to_string(cell.date == @cal_day)}
                    aria-label={"#{cell.date.month}月#{cell.date.day}日 #{length(cell.events)} 件"}
                  >
                    <span class="event-day-num">{cell.date.day}</span>
                    <%!-- **開催地を先に出す**（どこで開かれるかで行けるかが決まる）。
                       海外は色を変えて「海外」と添える --%>
                    <span
                      :for={entry <- cal_prominent(cell.events)}
                      class={[
                        "event-chip",
                        "is-#{entry.attention}",
                        Events.abroad?(entry) && "is-abroad"
                      ]}
                      title={"#{entry.title}（#{cal_where(entry)}）"}
                    >
                      <span :if={entry.places != []} class="event-where">{cal_where(entry)}</span>
                      {entry.title}
                    </span>
                    <span :if={cal_rest(cell.events) > 0} class="event-more">
                      {if cal_prominent(cell.events) == [], do: "", else: "ほか "}{cal_rest(
                        cell.events
                      )} 件
                    </span>
                  </button>
                </td>
              </tr>
            </tbody>
          </table>

          <section
            :if={@cal_day}
            class="event-day-list"
            aria-label={"#{day_label(@cal_day)} の#{Chidori.Topics.item_word(@topic)}"}
          >
            <h3>{day_label(@cal_day)} の{Chidori.Topics.item_word(@topic)}</h3>
            <ul>
              <%!-- 作品（映画・アニメ）の札は**押すと詳細が開く**（`ChidoriWeb.WorkModal`）。
                 作品のページへのリンクは詳細の中に置く（記事の札と同じ） --%>
              <li
                :for={entry <- Events.sort(Enum.filter(shown, &(&1.date == @cal_day)))}
                class={[
                  "event-item",
                  "is-#{entry.attention}",
                  Chidori.Topics.works(@topic) && "is-work"
                ]}
                phx-click={Chidori.Topics.works(@topic) && "open_work"}
                phx-value-title={entry.title}
                role={Chidori.Topics.works(@topic) && "button"}
                tabindex={Chidori.Topics.works(@topic) && "0"}
              >
                <img
                  :if={entry_thumb(entry)}
                  class="event-thumb"
                  src={entry_thumb(entry)}
                  alt=""
                  loading="lazy"
                />
                <div class="event-item-head">
                  <span :if={entry.attention} class={["event-chip", "is-#{entry.attention}"]}>
                    注目度 {attention_label(entry.attention)}
                  </span>
                  <a
                    :if={entry.url && !Chidori.Topics.works(@topic)}
                    href={SafeUrl.href(entry.url)}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {entry.title}
                  </a>
                  <strong :if={!entry.url || Chidori.Topics.works(@topic)}>{entry.title}</strong>
                  <%!-- 見た作品は見出しの横に印（詳細を開かなくても分かる） --%>
                  <span :if={seen_work?(@work_marks, entry.title)} class="seen-badge">見た</span>
                </div>
                <%= if Chidori.Topics.works(@topic) do %>
                  <p class="event-item-facts">
                    {work_facts(entry, Chidori.Topics.works(@topic))}
                  </p>
                <% else %>
                  <p class="event-item-facts">
                    <span :if={Events.abroad?(entry)} class="event-abroad-mark">海外</span>
                    {event_facts(entry)}
                  </p>
                  <%!-- **説明は開いたまま出す**（行くかどうかを、ページを開かずに決められるように） --%>
                  <p :if={Events.description(entry) != ""} class="event-item-detail">
                    {Events.description(entry)}
                  </p>
                <% end %>
              </li>
            </ul>
          </section>
        <% end %>
      </section>

      <%!-- 注目作（映画）。**公開中とこれからに分ける** —— 公開中のものは口コミで
         観るかを決め、これからのものは公開日で予定を立てる --%>
      <section
        :if={@topic && Chidori.Topics.works(@topic)}
        class="event-calendar works-list"
        aria-label="注目作"
      >
        <h2 class="news-section-title">注目作</h2>
        <p :if={@works in [nil, :loading]} class="muted-note">読み込んでいます…</p>
        <p :if={match?({:error, _}, @works)} class="muted-note">{cal_error(@works)}</p>
        <%= if match?({:ok, _}, @works) do %>
          <% {:ok, all} = @works %>
          <p
            :if={works_groups(all, Chidori.Jst.today(), Chidori.Topics.works(@topic)) == []}
            class="muted-note"
          >
            注目度が中以上の作品はまだありません（情報収集と整理が回ると並びます）。
          </p>
          <%!-- **既定は畳んでおく**（公開中とこれからで数十本ずつあり、開いたままだと下の
             映画館の欄や設定まで長くスクロールすることになる）。見出しを押すと開く --%>
          <details
            :for={
              {label, list} <-
                works_groups(all, Chidori.Jst.today(), Chidori.Topics.works(@topic))
            }
            id={"works-group-#{:erlang.phash2(label)}"}
            class="event-day-list works-group"
          >
            <summary>
              <h3>{label}（{length(list)} 本）</h3>
            </summary>
            <ul>
              <%!-- **押すと詳細が開く**（説明・出典・上映館・見た記録。`ChidoriWeb.WorkModal`）。
                 札は見渡すためのものなので、見出しと事実の 1 行だけ --%>
              <li
                :for={entry <- list}
                class={["event-item", "is-#{entry.attention}", "is-work"]}
                phx-click="open_work"
                phx-value-title={entry.title}
                role="button"
                tabindex="0"
              >
                <img
                  :if={entry_thumb(entry)}
                  class="event-thumb"
                  src={entry_thumb(entry)}
                  alt=""
                  loading="lazy"
                />
                <div class="event-item-head">
                  <span :if={entry.attention} class={["event-chip", "is-#{entry.attention}"]}>
                    注目度 {attention_label(entry.attention)}
                  </span>
                  <strong>{entry.title}</strong>
                  <%!-- 見た作品は見出しの横に印（詳細を開かなくても分かる） --%>
                  <span :if={seen_work?(@work_marks, entry.title)} class="seen-badge">見た</span>
                </div>
                <p class="event-item-facts">{work_facts(entry, Chidori.Topics.works(@topic))}</p>
              </li>
            </ul>
          </details>
        <% end %>
      </section>

      <%!-- 映画館（映画の話題だけ）。近くの館を探してお気に入りに入れ、お気に入りの館で上映時刻を調べる。
         調べる映画は**公開中の注目作**から選ぶ（これからの作品はまだどこも上映していない） --%>
      <ChidoriWeb.TheaterPanel.panel
        :if={@topic && Chidori.Topics.works(@topic) == Chidori.News.Movies}
        search={@theater_search}
        search_form={@theater_form}
        here={@theater_here}
        favorites={@theater_favorites}
        showing={showing_works(@works)}
        backends={@showtime_backends}
        showtimes={@showtimes}
        form={@showtime_form}
      />

      <%!-- 全画面の要約。**左右のスワイプで前後の要約へ**（`digest_viewer/1`） --%>
      <.digest_viewer
        news={@news}
        open={@digest_open}
        full={@digest_full}
        kind={@digest_kind}
        section={@digest_section}
        label={if @digest_kind == :interest, do: "興味トピック", else: @topic && @topic.name}
        hero={hero?(@topic)}
        open_work_event={Chidori.Topics.works(@topic) && "open_work"}
        keys={@opened_work == nil}
      />

      <%!-- 記事から育った話題の網。**まとめのすぐ下** —— まとめが「この期間に何が
         あったか」を文で言うのに対して、図は同じことを語のつながりで見せる。
         育てるのは Chiezo で、Chidori は依頼文を渡して読むだけ --%>
      <.topic_map
        :if={@topic && Chidori.Topics.themes?(@topic)}
        state={@themes}
        interests={@interests}
        picked={@picked_theme}
        query={@theme_query}
        matches={theme_hits(@themes.themes, @theme_query)}
      />

      <%!-- 選んだトピックの記事と、興味トピックに入れる口。**図のすぐ下** —— 札を押したら
         その話題の記事を読みに行ける（押すと網の線も濃くなる） --%>
      <section :if={@picked_theme} class="theme-pick" aria-label={"「#{@picked_theme}」の記事"}>
        <header class="theme-pick-head">
          <h2 class="news-section-title">「{@picked_theme}」の記事</h2>
          <button
            type="button"
            class={["interest-toggle", @picked_theme in @interests && "is-on"]}
            phx-click="toggle_interest"
            phx-value-name={@picked_theme}
            aria-pressed={to_string(@picked_theme in @interests)}
          >
            {if @picked_theme in @interests, do: "★ 興味トピックから外す", else: "☆ 興味トピックに入れる"}
          </button>
          <button type="button" class="theme-pick-close" phx-click="pick_theme" phx-value-name="">
            閉じる
          </button>
        </header>
        <%= case @theme_articles do %>
          <% :loading -> %>
            <p class="muted-note">記事を探しています…</p>
          <% {:error, reason} -> %>
            <p class="muted-note">記事を引けませんでした（{ask_error(reason)}）</p>
          <% [] -> %>
            <p class="muted-note">この語の付いた記事は、いま溜まっていません。</p>
          <% articles when is_list(articles) -> %>
            <p class="muted-note">
              {length(articles)} 件（新しい順）。トピックの語と、畳んだ言い換えのタグで引いています。
            </p>
            <div class="news-list">
              <.article_card
                :for={article <- articles}
                article={article}
                favorite={favorite?(@favorite_urls, article)}
                interests={@interests}
                near={near_tags(@themes.themes, @interests)}
              />
            </div>
          <% _none -> %>
        <% end %>
      </section>

      <%!-- 選んでいる興味トピック。**整理の回が付ける「興味度」と、興味トピックの要約の
         材料**。札を押して選び、ここから外せる --%>
      <section :if={@interests != []} class="interest-list" aria-label="興味トピック">
        <h2 class="news-section-title">興味トピック</h2>
        <ul>
          <li :for={name <- @interests}>
            <button
              type="button"
              class="interest-chip"
              phx-click="pick_theme"
              phx-value-name={name}
            >
              ★ {name}
            </button>
            <button
              type="button"
              class="interest-remove"
              phx-click="toggle_interest"
              phx-value-name={name}
              aria-label={"「#{name}」を興味トピックから外す"}
            >
              ×
            </button>
          </li>
        </ul>
        <p class="muted-note">
          整理の回が、これから入る記事に興味度（0〜100）を付け、要約とは別に興味トピックの要約を書きます。
          選び直すと依頼文を Chiezo へ送り直します（付け終えた点は動かしません）。
        </p>
      </section>

      <%!-- 記事の一覧。**ふだんは畳んでおく** —— 読むのは要約と話題の網で、1 件ずつを
         拾いに行くのは気になったときだけ。開いたままだと画面の大半を占める --%>
      <%!-- **並び替えで閉じない**（開いているかはブラウザが持つ。描き直しで open を
         外されると、押した並び替えのたびに一覧が畳まれる） --%>
      <details
        :if={!@favorites_view and Chidori.Topics.articles?(@topic)}
        id="news-articles"
        class="news-articles"
        phx-mounted={Phoenix.LiveView.JS.ignore_attributes(["open"])}
      >
        <summary>
          <h2 class="news-section-title">記事一覧（直近 3 日・{length(@news.articles)} 件）</h2>
        </summary>
        <%!-- 並びの切り替え。**反応の多い順ははてブ数の実数**（AI の話題度ではない）。
           **興味の近い順は、興味トピックを選んでいるときだけ** --%>
        <div class="article-sort" role="group" aria-label="並び">
          <button
            :for={
              {by, label} <-
                [{"importance", "重要度順"}, {"newest", "新しい順"}, {"bookmarks", "反応の多い順"}] ++
                  if(@interests != [], do: [{"interest", "興味の近い順"}], else: [])
            }
            type="button"
            class={Atom.to_string(@article_sort) == by && "selected"}
            phx-click="sort_articles"
            phx-value-by={by}
          >
            {label}
          </button>
        </div>
        <% near = near_tags(@themes.themes, @interests) %>
        <section class="news-list" aria-live="polite">
          <.article_card
            :for={article <- sorted_articles(@news, @article_sort)}
            article={article}
            favorite={favorite?(@favorite_urls, article)}
            interests={@interests}
            near={near}
          />
        </section>
      </details>
    <% end %>

    <%!-- 設定は 1 つの枠にまとめる（関連図と同じ形）。状態を見る場所と、直す場所と、
         押す場所が離れていると、何がどこへ効くのか読めない。
         **中は仕事ごとに分ける** —— 集める設定と、知らせる設定は別のもの --%>
    <section
      :if={@collect_mode and !@favorites_view}
      class={["settings-panel", stopped_class(@news)]}
      aria-label={settings_title(@topic)}
    >
      <%!-- **見出しの行の右端に「止める」「動かす」**（`ChidoriWeb.CollectSwitch`） --%>
      <div class="settings-title-row">
        <h2>{settings_title(@topic)}</h2>
        <.live_component
          :if={@news.collection}
          module={ChidoriWeb.CollectSwitch}
          id="switch-news"
          collection={@news.collection}
        />
      </div>

      <section class="settings-block">
        <h3>Chiezo の収集</h3>
        <p aria-live="polite">{status_message(@news) || collection_note(@news)}</p>

        <dl :if={@news.collection} class="collect-facts">
          <div :for={{label, value} <- collection_facts(@news)}>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        </dl>

        <%!-- 絵の無い注目作に、絵を探させる（割り込み 1 回）。**前から入っている作品には
             絵が付かない**（整理は触った作品しか返さない）ので、まとめて埋める口を置く --%>
        <div
          :if={match?({:ok, _}, @works) and missing_images(elem(@works, 1)) > 0}
          class="button-row"
        >
          <span class="muted-note">絵の無い注目作が {missing_images(elem(@works, 1))} 本あります。</span>
          <button type="button" phx-click="fill_images" phx-disable-with="頼んでいます…">
            絵を探させる
          </button>
        </div>

        <%!-- **選んだところはサーバーが覚える**（`phx-change`）。覚えないと、収集の
             状態が届いた拍子にフォームが描き直され、選んだ相手が元の値に戻る --%>
        <form id="collect-form" phx-submit="collect" phx-change="pick_sweep">
          <.sweep_table state={@news} picks={@picks} backends={@backends} />

          <p class="muted-note">{sweep_note(@topic)}</p>
          <div class="button-row">
            <button
              type="submit"
              phx-disable-with="送っています…"
              disabled={@news.status == :loading or not @news.configured}
            >
              {collect_label(@news)}
            </button>
          </div>
        </form>

        <p :if={@news.collection && @news.collection.url} class="muted-note">
          <a href={@news.collection.url} target="_blank" rel="noreferrer">Chiezo で見る</a>
        </p>

        <%!-- AI に何を頼んでいるかは、押す前にも後にも読めるようにする。
             畳んでおくのは、ふだんは読みたいのが結果のほうだから --%>
        <details class="news-prompt">
          <summary>Chiezo への依頼文</summary>
          <p class="news-prompt-note">{prompt_note(@news)}</p>
          <pre>{prompt_text(@news, @topic)}</pre>
          <div :for={{name, text} <- sweep_prompts(@topic)}>
            <h3>{name}</h3>
            <pre>{text}</pre>
          </div>
        </details>
      </section>

      <%!-- トピックの収集。**記事とは別の収集**（記事は 30 日で落ちるが、
           トピックは期限では落とさない）。持つ話題にだけ出す --%>
      <section
        :if={Chidori.Topics.themes?(@topic)}
        class={["settings-block", stopped_class(@themes)]}
      >
        <div class="settings-title-row">
          <h3>トピックの収集</h3>
          <.live_component
            :if={@themes.collection}
            module={ChidoriWeb.CollectSwitch}
            id="switch-themes"
            collection={@themes.collection}
          />
        </div>
        <p aria-live="polite">{theme_note(@themes)}</p>

        <dl :if={@themes.collection} class="collect-facts">
          <div :for={{label, value} <- collection_facts(@themes)}>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        </dl>

        <form id="theme-collect-form" phx-submit="collect_themes" phx-change="pick_theme_sweep">
          <.sweep_table state={@themes} picks={@theme_picks} backends={@backends} />
          <p class="muted-note">
            <strong>語を拾うのは機械、精査するのが AI です。</strong> 記事に付いたタグがそのままトピックになり、件数と一緒に出てくる語も Chiezo が
            数えます（機械収集の回は AI を呼びません）。AI の回は、言い換えを畳む・親子を決める・
            話題でない語を外す・説明を書く、の 4 つだけです。
          </p>
          <div class="button-row">
            <button type="submit" phx-disable-with="送っています…">{theme_collect_label(
              @themes
            )}</button>
          </div>
        </form>

        <%!-- **押す口は増やさない。** 読み直しの口は置かず、開き直したときと
             設定を送り直したときに読む（記事のほうと同じ形） --%>
        <div :if={@themes.collection} class="button-row">
          <button type="button" phx-click="pick_themes" phx-disable-with="頼んでいます…">
            いま拾う
          </button>
        </div>

        <p :if={@themes.collection && @themes.collection.url} class="muted-note">
          <a href={@themes.collection.url} target="_blank" rel="noreferrer">Chiezo で見る</a>
        </p>

        <%!-- 整理の回に何を頼んでいるか。機械収集の回は AI を呼ばないので依頼文を持たない --%>
        <details class="news-prompt">
          <summary>Chiezo への依頼文（整理）</summary>
          <p class="news-prompt-note">{theme_prompt_note(@themes)}</p>
          <pre>{theme_prompt_text(@themes, @topic)}</pre>
        </details>
      </section>

      <%!-- 要約を作る時刻。**通知とは別の設定** —— 時刻は「要約を作る時刻」で、
           知らせる設定なら作った後に知らせる（そうでなければ作るだけ）。通知の枠の中に
           置いていた頃は、通知の時刻に読めた --%>
      <section :if={Chidori.Topics.digest?(@topic)} class="settings-block">
        <h3>要約</h3>
        <%!-- 書いたそばから覚える（`phx-change`）。覚えないと、収集の状態が届いた
             拍子にフォームが描き直され、書きかけが消える --%>
        <.form
          :let={f}
          id="digest-form"
          for={@notify_form}
          phx-submit="save_notify"
          phx-change="edit_notify"
        >
          <p>
            <label>
              要約を作る時刻（JST・空なら自分からは作りません。例: 08:00,21:00）<br />
              <input
                type="text"
                name={f[:digest_at].name}
                value={f[:digest_at].value}
                placeholder="07:00,21:00"
              />
            </label>
          </p>
          <div class="button-row">
            <button type="submit">時刻を保存</button>
          </div>
        </.form>

        <%!-- 時計を持つのは Chidori の側。Chiezo には「いま回してください」としか
             言わない（何時に読みたいかは利用者の都合なので、あちらに持たせない） --%>
        <p class="muted-note">{digest_note(@topic)}</p>
        <%!-- いまの状態と、前に走った回の記録は分けて出す。混ぜると、止まった回の
             理由（現在形で書かれる）が、いまの状態として読まれる --%>
        <p :if={digest_state_text(@news, @topic)} class="muted-note">
          {digest_state_text(@news, @topic)}
        </p>
        <p class="muted-note">{last_digest_text(@topic)}</p>
        <p :if={@digest_message} aria-live="polite">{@digest_message}</p>

        <div class="button-row">
          <button type="button" phx-click="digest_now" phx-disable-with="始めています…">
            {if can_notify?(@topic), do: "いま作って知らせる", else: "いま要約を作る"}
          </button>
        </div>
      </section>

      <%!-- 通知。**ここで決めるのは知らせるかどうかだけ** —— 宛先（トピック名と場所）は
           全部の通知で 1 つで、設定の「通知」タブにある。**畳まない** —— 知らせるのか
           どうか・どこへ届くのかを、開かずに読めることのほうが大事 --%>
      <section :if={Chidori.Topics.digest?(@topic)} class="settings-block">
        <h3>通知</h3>

        <.form
          :let={f}
          id="notify-form"
          for={@notify_form}
          phx-submit="save_notify"
          phx-change="edit_notify"
        >
          <p>
            <input type="hidden" name={f[:notify].name} value="false" />
            <label>
              <input
                type="checkbox"
                name={f[:notify].name}
                value="true"
                checked={Phoenix.HTML.Form.normalize_value("checkbox", f[:notify].value)}
              /> 要約を作ったら知らせる（ntfy・登録した端末）
            </label>
          </p>
          <div class="button-row">
            <button type="submit">保存</button>
          </div>
        </.form>
        <p :if={notify_note(@topic)} class="muted-note">
          {notify_note(@topic)}
          <.link navigate={~p"/settings?tab=notify"}>通知先の設定</.link>
        </p>

        <p class="muted-note">{last_sent_text(@topic)}</p>
        <div class="button-row">
          <button
            :if={can_notify?(@topic)}
            type="button"
            phx-click="notify"
            phx-disable-with="送っています…"
          >
            いまのまとめを知らせる
          </button>
        </div>
      </section>
    </section>

    <footer>
      <p>
        収集は
        <a href="https://github.com/rtcode337/chiezo" target="_blank" rel="noreferrer">Chiezo</a>
        の「集める」層が行い、溜まったものは Chiezo のソースとして残ります。
        見出しを押すと Chiezo の中身（要約と出典）が開きます。
      </p>
    </footer>
  </div>

  <%!-- **作品の詳細**（映画・アニメ）。札からも要約からも開く。全画面の要約より手前に出る --%>
  <ChidoriWeb.WorkModal.work_modal
    opened={@opened_work}
    marks={@work_marks}
    saved={@work_mark_saved}
    showtime={ChidoriWeb.ShowtimeAsk.for_modal(assigns)}
  />

  <%!-- **記事の詳細**（画家の図と同じくモーダル）。原文へのリンクと、その記事に
       ついて Chiezo へ頼む口（割り込み）を置く —— 頼みごとは記事を見ながら
       思いつくので、設定の欄に離して置くと、どの記事の話か書き直すことになる --%>
  <div
    :if={@opened_article}
    class="artwork-backdrop"
    phx-window-keydown="close_article"
    phx-key="Escape"
  >
    <section
      class="artwork article-detail"
      role="dialog"
      aria-modal="true"
      aria-labelledby="article-detail-title"
      phx-click-away="close_article"
    >
      <div class="artwork-head">
        <strong id="article-detail-title">{@opened_article.title}</strong>
        <button type="button" phx-click="close_article">閉じる</button>
      </div>
      <p class="news-source">
        {@opened_article.collected_at}
        <span :if={buzz_text(@opened_article)}>・{buzz_text(@opened_article)}</span>
        <span :if={interest_text(@opened_article)} class="interest-score">
          ・{interest_text(@opened_article)}
        </span>
        ・{importance_label(@opened_article.importance)}
      </p>
      <img
        :if={@opened_article.image}
        class="article-detail-image"
        src={SafeUrl.src(@opened_article.image)}
        alt=""
        loading="lazy"
      />
      <p :if={@opened_article.summary} class="news-summary">{@opened_article.summary}</p>
      <p class="news-reason">{@opened_article.reason}</p>
      <.tag_chips tags={
        article_tags(@opened_article, @interests, near_tags(@themes.themes, @interests))
      } />
      <p :if={@opened_article.url}>
        <a href={SafeUrl.href(@opened_article.url)} target="_blank" rel="noreferrer">原文を開く ↗</a>
      </p>
      <%!-- **お気に入り**。残すのは見出しと URL だけ（記事が Chiezo の期限で消えても残る） --%>
      <div :if={@opened_article.url} class="button-row">
        <button
          type="button"
          phx-click="toggle_favorite"
          phx-value-url={@opened_article.url}
          phx-value-title={@opened_article.title}
          aria-pressed={to_string(favorite?(@favorite_urls, @opened_article))}
        >
          {if favorite?(@favorite_urls, @opened_article),
            do: "★ お気に入りから外す",
            else: "☆ お気に入りに入れる"}
        </button>
      </div>
      <p :if={@favorite_error} class="muted-note" aria-live="polite">{@favorite_error}</p>

      <form id="article-ask" phx-submit="ask_article" class="article-ask">
        <label>
          この記事について Chiezo に頼む<br />
          <textarea
            name="note"
            rows="3"
            placeholder="例: この件の続報を追って / これは宣伝なので落として / タグを直して"
          ></textarea>
        </label>
        <p class="muted-note">
          定時の巡回とは別に 1 回だけ走ります（進み具合にも次の予定にも触りません）。
          走るのは「{Chidori.News.focus_sweep()}」の設定で、この記事は必ず AI に見せます。
        </p>
        <div class="button-row">
          <button type="submit" disabled={@asking} phx-disable-with="頼んでいます…">
            Chiezo に頼む
          </button>
        </div>
        <p
          :if={article_ask_message(@article_asked)}
          class="muted-note"
          aria-live="polite"
        >
          {article_ask_message(@article_asked)}
        </p>
      </form>
    </section>
  </div>
</main>
