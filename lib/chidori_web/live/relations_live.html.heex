<Layouts.flash_group flash={@flash} />

<%!-- **トップページに埋め込まれたときは、頭のメニューとタブと設定を出さない**
     （`embed=1`。図と操作だけあればよく、トップの中にもう 1 つ画面の頭が並ぶと
     どこにいるのか読めない）。
     頭のメニューとタブは main の外に置き、画面の上に残す（スクロールするのは main の中だけ。
     root.html.heex）。取り直している間は頭も止める（下の main と同じ理由） --%>
<div :if={!@embed} class="relations-page page-head" inert={busy?(@relation) || nil}>
  <div>
    <% hobby? = Chidori.Relations.hobby?(@view) %>
    <ChidoriWeb.MainNav.main_nav active={
      cond do
        @collect_mode -> :collect
        hobby? -> :datasets
        true -> :relations
      end
    } />
    <ChidoriWeb.CollectTabs.collect_tabs
      :if={@collect_mode}
      current={if hobby?, do: :datasets, else: :relations}
    />
    <%!-- **芸術家は趣味の段**（データの対象と同じタブに並べる）。画面はこのまま --%>
    <ChidoriWeb.DiningTabs.dataset_tabs
      :if={hobby?}
      datasets={Chidori.Datasets.list()}
      current={@view}
      mode={if @collect_mode, do: :collect, else: :read}
      elsewhere={true}
    />

    <%!-- **図の種類はタブで、見出しの上に置く。** 見出しと説明は選んだ図のものなので、
         切り替える口がその下にあると、どこまでが切り替わるのかが読めない --%>
    <nav
      :if={!hobby?}
      id="relation-tabs"
      class="relation-tabs"
      phx-hook="ScrollTabs"
      aria-label="関連図の種類"
    >
      <.link
        :for={{key, title} <- Chidori.Relations.relation_views()}
        patch={"#{@base_path}?view=#{key}"}
        class={if @view == key, do: "selected"}
        aria-current={if @view == key, do: "page"}
      >
        {title}
      </.link>
    </nav>
  </div>
</div>

<%!-- **取り直している最中は、ほかの操作を受け付けない。** 届いた図はいま見ている
     ものを丸ごと入れ替えるので、途中で押されたことは黙って上書きされる ——
     押せたのに効かない、という形になる。`inert` で操作ごと止め、覆いで
     押せないことを見せる（見た目だけ止めても、タブ送りでは押せてしまう） --%>
<main
  id="page-scroll"
  class={["relations-page", busy?(@relation) && "is-busy", @embed && "is-embed"]}
  inert={busy?(@relation) || nil}
  phx-hook="PageScroll"
>
  <div>
    <%!-- 埋め込まれたときは**図と取得の行だけ**（見出し・説明・図の下の節は出さない）。
         トップページの中で読むのは図で、見方や設定は関連図の画面で読む。
         **取得の行は図の下へ**（埋め込みでは図が主役。上に置くと図が押し下がる） --%>
    <%!-- 映画の図は趣味の映画のタブの中。見出しは最新・映画館・見た映画と同じもの
         （`DiningTabs.movie_intro/1`。違うと切り替えの札の位置がずれる）。図の説明は切り替えの下 --%>
    <%= if @view == "films" and !@embed do %>
      <ChidoriWeb.DiningTabs.movie_intro
        current={:graph}
        mode={if @collect_mode, do: :collect, else: :read}
      />
      <ChidoriWeb.DiningTabs.movie_tabs
        current={:graph}
        mode={if @collect_mode, do: :collect, else: :read}
      />
      <section class="relations-intro film-intro">
        <p :if={!@collect_mode}>{@relation.description}</p>
        <p :if={@collect_mode}>名簿・巡回・区画・依頼文はここで決めます。</p>
        <.checked_line :if={!@collect_mode} relation={@relation} view={@view} />
      </section>
    <% end %>
    <section :if={!@embed and @view != "films"} class="relations-intro">
      <p>{@relation.eyebrow}</p>
      <h1>{@relation.title}</h1>
      <p :if={!@collect_mode}>
        {@relation.description}
        <.link
          :if={Chidori.Relations.chiezo_view?(@view)}
          navigate={"/collect/relations?view=#{@view}"}
          class="mode-link is-collect"
        >
          この図の収集の画面へ
        </.link>
      </p>
      <p :if={@collect_mode}>
        この図の収集を Chiezo に頼む画面です。名簿・巡回・区画・依頼文はここで決めます。
        <.link navigate={"/relations?view=#{@view}"} class="mode-link is-read">図を見る画面へ</.link>
      </p>

      <%!-- **収集の画面には出さない**（図を描かないので、図を取り直す口は要らない。
           区画の未レビューの数だけは図から数えるので、その表の横で取り直す） --%>
      <.checked_line :if={!@collect_mode} relation={@relation} view={@view} />

      <%!-- 見た映画を足す口は、趣味の映画のタブの中の「見た映画」へ移した（`ChidoriWeb.SeenFilms`） --%>
    </section>

    <%!-- **図を見る画面と収集の画面を分ける**（`@collect_mode`）。収集の画面には図を出さない --%>
    <%= if !@collect_mode do %>
      <%!-- 図は地図と同じ操作にする（押し広げ・引きずり）。**全画面はブラウザの
         Fullscreen API に任せる** —— 自前で画面を覆うと、ブラウザの UI が残るぶん
         縦が削られ、Esc で閉じる作法も自分で書くことになる --%>
      <%!-- 絞り込みが掛かっていれば、その人たちだけで置き直した図を描く。
         **絞るだけでは足りない** —— 位置がもとのままだと、39 人が高さ 2,500 の面に
         散らばって拡大しないと読めず、絞った意味が無い --%>
      <% shown = shown(@relation, assigns) %>
      <%!-- 1 回押した札。その札・線・線の先を目立たせ、ほかを沈める（もう一度押すと詳細） --%>
      <%!-- 1 回押した線は、その線と両端（共通項の線ならその人の作品の鎖）を立たせる（札は選ばない） --%>
      <% pick = pick_of(shown, @picked_edge || @picked) %>
      <%!-- **器の縦横比は図に合わせる。** 画家の図は縦に長い（幅 1,200 に対して高さ
         2,000 超）ので、画面の高さで切った器では拡大しないと下が見えず、全体を
         入れようと縮めると札が小さすぎて 1 枚も描けない。図と同じ比にすれば、
         拡大していない状態で全体が入り、はみ出すぶんはページのスクロールで見られる --%>
      <section
        class={["relation-canvas", pick && "has-pick"]}
        aria-label={@relation.title}
        id={"relation-canvas-#{@view}"}
        phx-hook="RelationMap"
      >
        <%!-- 行き先を選ぶ口。**名前で探す**のと、**前に見た印から選ぶ**のを並べて置く ——
           名前を思い出せないときに使うのが後者なので、探す欄の中には入れられない --%>
        <% seen = seen_options(@relation, @marks) %>
        <%!-- **道具の段。** 普段は図の外（器の中の上）に置き、全画面では図の上に重ねる
           （図に重ねたままだと、狭い画面でボタンが重なり、いちばん上の札が裏に入った） --%>
        <div class="relation-bar">
          <div class="relation-find">
            <form
              id={"relation-search-#{@view}"}
              class="relation-search"
              phx-change="search"
              phx-submit="search"
              autocomplete="off"
            >
              <input
                type="search"
                name="q"
                value={@query}
                placeholder={"#{unit_of(@view)}を探す"}
                aria-label={"#{unit_of(@view)}を探す"}
              />
              <button
                :if={@query != ""}
                type="button"
                phx-click="clear_search"
                aria-label="検索をやめる"
              >
                ×
              </button>
              <ul :if={@matches != []} class="relation-matches">
                <li :for={match <- @matches}>
                  <button type="button" phx-click="focus" phx-value-name={match.name}>
                    {match.name}
                    <span :if={match.years || match[:rank]} class="match-years">
                      {[match[:rank] && "#{match.rank} 位", match.years]
                      |> Enum.reject(&is_nil/1)
                      |> Enum.join(" · ")}
                    </span>
                  </button>
                </li>
              </ul>
            </form>
            <form
              :if={seen != []}
              id={"relation-seen-#{@view}"}
              class="relation-seen"
              phx-change="focus_marked"
            >
              <select name="name" aria-label={"見た#{unit_of(@view)}を探す"}>
                <%!-- 先頭は行き先ではなく口の名前。**選ばれている行き先が分かる**ように、
               寄っているものはそのまま選ばれた状態で残す --%>
                <option value="">見た{unit_of(@view)}（{length(seen)}）</option>
                <option :for={{name, label} <- seen} value={name} selected={@query == name}>
                  {label}
                </option>
              </select>
            </form>
          </div>
          <div class="relation-tools">
            <button type="button" data-zoom="in" aria-label="拡大">＋</button>
            <button type="button" data-zoom="out" aria-label="縮小">−</button>
            <button type="button" data-zoom="reset" aria-label="全体を表示">全体</button>
            <ChidoriWeb.FullscreenButton.fullscreen_button />
          </div>
        </div>
        <%!-- 案内は端末で変える。押しても全画面にならない PC に「押すと全画面」と
           書くと嘘になる（全画面はボタンからいつでも入れる） --%>
        <p class="relation-hint">
          <span class="only-touch">押すと全画面。指で動かし、2 本の指でつまんで拡大縮小。</span><span class="only-mouse">引きずって移動、Ctrl+ホイールで拡大縮小。</span>
        </p>
        <%!-- **表示例の図は描かない。** 本物と見分けが付かないので、読み込みが終わるまで
           5 人の関連図が出て「これは何」になる。何を待っているかだけを出す --%>
        <div :if={@relation[:sample?]} class="canvas-empty">
          <p>{sample_message(@relation)}</p>
        </div>

        <svg
          :if={!@relation[:sample?]}
          viewBox={"0 0 #{shown.width} #{shown.height}"}
          style={canvas_style(@relation, shown)}
          role="img"
          aria-label={shown.title}
        >
          <defs>
            <marker
              id="arrow"
              viewBox="0 0 10 10"
              refX="10"
              refY="5"
              markerWidth="4"
              markerHeight="4"
              orient="auto-start-reverse"
            >
              <path d="M 0 0 L 10 5 L 0 10 z" />
            </marker>
          </defs>
          <%!-- 年表の目盛り。**間隔は一定ではない** —— 丸は年代の順に等間隔で並べてあるので、
             目盛りの側が伸び縮みする。人が多い年代ほど広がる --%>
          <%!-- 地域の帯。**丸より先に描く**ので、丸も線も帯の上に乗る。
             帯の幅は人数の比なので、広い帯にはそれだけの画家がいる --%>
          <g :for={band <- split_bands(shown)} class="relation-band">
            <rect x={band.x} y="0" width={band.width} height={shown.height} />
            <line x1={band.x} y1="0" x2={band.x} y2={shown.height} />
          </g>
          <%!-- グループの枠（芸能人の図）。**線と札より先に描く**ので、メンバーの札は
             枠の上に乗る。グループの名前は枠の上の縁にある札（グループの札そのもの）--%>
          <rect
            :for={cluster <- shown[:clusters] || []}
            class="relation-cluster"
            x={cluster.x}
            y={cluster.y}
            width={cluster.width}
            height={cluster.height}
            rx="10"
            style={cluster_style(cluster)}
          />
          <%!-- 札の無い枠（人のタグから組んだグループ）は、名前を枠の左上に書く --%>
          <text
            :for={cluster <- shown[:clusters] || []}
            :if={cluster[:labelled]}
            class="cluster-name"
            x={cluster.x + 6}
            y={cluster.y + 12}
          >
            {cluster.name}
          </text>
          <g :for={tick <- shown[:ticks] || []} class="relation-tick">
            <line x1="70" y1={tick.y} x2={shown.width} y2={tick.y} />
          </g>
          <%!-- **年代の札だけは画面の左端に貼り付ける。** 図と一緒に流すと、少し右へ
             引きずっただけで年表が画面の外へ出てしまい、拡大したときにいちばん
             知りたい「いまどのあたりの時代か」が読めなくなる。
             横の位置と字の大きさは RelationMap が当て直す（縦は図と一緒に動く）--%>
          <g class="tick-labels" data-pinned-labels>
            <text :for={tick <- shown[:ticks] || []} x="8" y={tick.y + 5}>
              {tick.year}年
            </text>
          </g>
          <%!-- 帯の名前。**上端に貼り付ける** —— 下へ引きずったときに、いま見ている
             縦の列がどの地域なのか分からなくなる（年代の札と同じ理由）。
             数は名前の下の行に置く（細い帯が並ぶと、横に続けた字が隣の帯の名前と重なる）--%>
          <g class="band-labels" data-pinned-top>
            <text :for={band <- split_bands(shown)} x={band.x + band.width / 2} y="0">
              {band.band}
              <tspan class="band-count" x={band.x + band.width / 2} dy="1.15em">
                {band.members}{counter_of(@view)}
              </tspan>
            </text>
          </g>
          <%!-- **描くのは見えているぶんだけ**（`drawn_nodes/2`）。全部を並べると
             2 万を超える要素になり、引きずるだけで固まる。端の座標は先に
             引き当ててある（`edge_lines/2`）—— ここで探すとノード数 × エッジ数の
             線形探索になる --%>
          <%!-- 目立たせている札の線の先は、小さくても描く（探して選んだ人と同じ） --%>
          <% drawn = drawn_nodes(shown, @viewport, pick || @focus) %>
          <%!-- 札の大きさの順位（図の全部の札の中で。詳細の「知名度」と同じ数え方）。年の行に添える --%>
          <% ranks = fame_ranks(@relation) %>
          <%= for edge <- edge_lines(shown, drawn) do %>
            <line
              x1={edge.x1}
              y1={edge.y1}
              x2={edge.x2}
              y2={edge.y2}
              class={[
                "relation-edge",
                to_string(edge.kind),
                lit?(pick, edge) && "is-lit"
              ]}
              marker-end={if edge.kind == :influence, do: "url(#arrow)"}
            />
            <%!-- **押す的は別に置く。** 線そのものは細いので、そのままでは指でも
               マウスでも当たらない。透明な太い線を重ねて、そちらで受ける。
               **薄い線（相互リンク）も押せる** —— 影響の線はまだ数えるほどしか
               無いので、押せるのが影響だけだと「押せない図」になる --%>
            <line
              x1={edge.x1}
              y1={edge.y1}
              x2={edge.x2}
              y2={edge.y2}
              class="edge-target"
              phx-click="show_edge"
              phx-value-from={edge.from}
              phx-value-to={edge.to}
              phx-value-kind={edge.kind}
            />
            <%!-- **画家の図では線の上に文字を置かない。** どの線の説明か読めないうえ、
               札に重なって名前を隠していた。何を受けたかは、線を押すと出る。
               芸能人の図は「親子」「メンバー」のような短い語なので置く（字の無い線は置かない） --%>
            <text
              :if={@view != "painters" and edge[:label]}
              x={edge.mid_x}
              y={edge.mid_y}
              class={["edge-label", lit?(pick, edge) && "is-lit"]}
            >
              {edge.label}
            </text>
          <% end %>
          <%!-- **押した札はいちばん上に描く**（`paint_order/2`）。鎖の相手は重なっても描くので、
             下に置くと 2 回目の押し込みが重なった相手に取られ、詳細が開かなかった --%>
          <%= for node <- paint_order(drawn, pick) do %>
            <%!-- **どの丸も押せる。** 押すと、もとになった記事・Chiezo に入っている
               タグ・（あれば）代表作の絵を出す。押せる丸と押せない丸が混じっていると、
               押しても何も起きない丸を何度も押すことになる --%>
            <g
              transform={"translate(#{node.x}, #{node.y})"}
              class={[
                "relation-node",
                to_string(node.kind),
                works_of(node) != [] && "has-work",
                node[:changed?] && "changed",
                node[:unreviewed?] && "unreviewed",
                marked?(@marks, node.name) && "marked",
                seen?(@marks, node.name) && "is-seen",
                unavailable?(@marks, node.name) && "is-unavailable",
                node.id == @focus && "focused",
                pick && node.id == pick.id && "is-picked",
                pick && MapSet.member?(pick.near, node.id) && "is-near"
              ]}
              phx-click="show_node"
              phx-value-name={node.name}
            >
              <%!-- 探して選んだ人の目印。**札の色だけでは周りに紛れる**ので、
                 広がって消える輪を重ねる（動きは止まっている図の中で目に入る） --%>
              <rect
                :if={node.id == @focus}
                class="focus-ring"
                x={-label_width_of(node) / 2}
                y={-label_height_of(node) / 2}
                width={label_width_of(node)}
                height={label_height_of(node)}
                rx={label_height_of(node) * 0.28}
              />
              <%!-- **丸ではなく札にする。** 円は角へ行くほど内側が痩せるので、
                 横に長い名前を入れるには不釣り合いに大きな円が要り、そうしないと
                 名前が外へはみ出す。四角なら名前の幅どおりに広げられる --%>
              <%!-- **様式は色で見せる。** 枠で囲うのはやめた —— 同じ様式の画家は
                 生年順に並べると飛び飛びになるので、他人を入れずに囲おうとすると
                 枠が細かく割れる（印象派 39 人が 11 枠になった）。色なら、
                 離れていても同じ派閥だと分かる --%>
              <rect
                x={-label_width_of(node) / 2}
                y={-label_height_of(node) / 2}
                width={label_width_of(node)}
                height={label_height_of(node)}
                rx={label_height_of(node) * 0.28}
                style={hue_style(node)}
              />
              <%!-- 顔写真（芸能人の図。写しのある人だけ）。札の左端に、札の高さの正方形で
                 置く（札の幅はそのぶん広げてある。`face_slot/1`）。写しは Chidori が配る --%>
              <image
                :if={node[:face]}
                class="node-face"
                href={node.face}
                x={-label_width_of(node) / 2 + face_inset(node)}
                y={-label_height_of(node) / 2 + face_inset(node)}
                width={face_slot(node) - 2 * face_inset(node)}
                height={label_height_of(node) - 2 * face_inset(node)}
                preserveAspectRatio="xMidYMin slice"
              />
              <%!-- 字の大きさは 1 人ずつ違う（知名度で決まる）ので、CSS ではなく
                 ここで当てる。**style で当てる** —— SVG の font-size 属性は
                 CSS のほうが強いので、属性で書くと class 側に負ける --%>
              <text
                text-anchor="middle"
                dominant-baseline="central"
                class="node-name"
                x={name_x(node, seen?(@marks, node.name))}
                y={node[:name_dy] || 0}
                style={"font-size: #{name_size_of(node)}px"}
              >
                {node.name}
                <tspan :if={works_of(node) != []} class="work-mark">
                  {Chidori.Relations.Graph.work_mark()}
                </tspan>
              </text>
              <%!-- **様式は札の中に入れる。** 外に置くと、隣の丸の札と重なったときに
                 どちらの様式か分からなくなる（札の中なら、札ごと重なりを避ける
                 仕組みに乗る）。札の高さはそのぶん広げてある --%>
              <text
                :if={node.note}
                text-anchor="middle"
                dominant-baseline="central"
                class="node-note"
                x={face_slot(node) / 2}
                y={node[:note_dy] || 0}
                style={"font-size: #{sub_size_of(node)}px"}
              >
                {node.note}
              </text>
              <%!-- 見た作品には黄色いしおり（札の上の縁から垂らす。下の端は山形の切り込み） --%>
              <g
                :if={seen?(@marks, node.name)}
                class="seen-flag"
                transform={flag_anchor(node)}
              >
                <path class="seen-flag-cloth" d={flag_path(flag_unit(node))} />
              </g>
              <%!-- 年代は外（下）のまま。札の中に 3 行入れると札が縦に伸びすぎる。
                 **大きさの順位も同じ行に添える**（札の大きさだけでは、どれくらい上なのか読めない） --%>
              <text
                :if={node.years || ranks[node.name]}
                text-anchor="middle"
                class="year-label"
                y={label_height_of(node) / 2 + sub_size_of(node) * 1.15}
                style={"font-size: #{sub_size_of(node)}px"}
              >
                {[node.years, ranks[node.name] && "#{ranks[node.name]} 位"]
                |> Enum.reject(&is_nil/1)
                |> Enum.join(" · ")}
              </text>
            </g>
          <% end %>
        </svg>
      </section>

      <div :if={@embed} class="relations-intro is-embedded">
        <.checked_line relation={@relation} />
      </div>

      <%!-- AI が目を通したかどうか。**薄い札が未レビュー**（機械で名簿に入っただけで、
         説明も影響元もまだ無いことが多い）。押すとその人たちだけになる --%>
      <section
        :if={
          !@embed and Chidori.Relations.chiezo_view?(@view) and is_integer(@relation[:unreviewed]) and
            @relation.unreviewed > 0
        }
        class="changed-note review-note"
      >
        <p>
          <span class="review-swatch reviewed" aria-hidden="true"></span>
          レビュー済み {length(@relation.nodes) - @relation.unreviewed} {counter_of(@view)}
          <span class="review-swatch unreviewed" aria-hidden="true"></span>
          未レビュー {@relation.unreviewed} {counter_of(@view)}（薄い札。AI がまだ目を通していません）
        </p>
        <%!-- 2 つは排他。**押しているほうをもう一度押すと全員に戻る**（凡例と同じ押し方） --%>
        <button
          :for={{only, label} <- [{"reviewed", "レビュー済みだけ"}, {"unreviewed", "未レビューだけ"}]}
          type="button"
          class={@review_filter == only && "on"}
          phx-click="filter_review"
          phx-value-only={only}
          aria-pressed={to_string(@review_filter == only)}
        >
          {label}
        </button>
      </section>

      <%!-- 直近の巡回で何が動いたか。**図の下、凡例のすぐ上に置く** —— 押すと
         その人たちだけになるので、絞り込みの仲間として並べたほうが見つかる。
         動いたものが無ければ出さない（最初の一括作成では全部が同じ刻みになる）--%>
      <section
        :if={!@embed and Chidori.Relations.chiezo_view?(@view) and changed_note(@relation)}
        class="changed-note"
      >
        <p>{changed_note(@relation)}</p>
        <button
          type="button"
          class={@changed_only && "on"}
          phx-click="filter_changed"
          aria-pressed={to_string(@changed_only)}
        >
          {if @changed_only, do: "すべて出す", else: "動いたものだけ"}
        </button>
      </section>

      <%!-- 色の凡例。**図の真下に置く** —— 色を見てから凡例を探すので、間に何かを
         挟むと目が行き来する。**押すとその様式だけになる**（もう一度押すと戻る）--%>
      <%!-- 見た作品の数（札の右上の黄色いしおりが目印） --%>
      <p
        :if={!@embed and seen_count(@marks, @relation[:nodes]) > 0}
        class="seen-legend muted-note"
      >
        <svg class="seen-legend-flag" viewBox="-12 -1 13 18" aria-hidden="true">
          <path class="seen-flag-cloth" d={flag_path(11)} />
        </svg>
        のしおりが付いているのが、見た記録のある{if @view == "films", do: "作品", else: "人"}です（{seen_count(
          @marks,
          @relation[:nodes]
        )}{counter_of(@view)}）。
        <%!-- 見た作品を除いて置き直した図にする（同じ監督・主演の線は残った作品でつなぎ直す） --%>
        <button
          type="button"
          class={["seen-toggle", @unseen_only && "is-on"]}
          phx-click="toggle_unseen"
          aria-pressed={to_string(@unseen_only)}
        >
          {if @unseen_only,
            do: "見た#{if @view == "films", do: "作品", else: "人"}も出す",
            else: "見ていない#{if @view == "films", do: "作品", else: "人"}だけにする"}
        </button>
      </p>
      <%!-- 知名度の下限。**図に出す作品を閲覧数で絞る**（目録は 2,500 本を超え、全部を描くとスマホでは重い）。
         見た記録・印のある作品と選んだ作品は下限に満たなくても出す（`below_floor/3`） --%>
      <form
        :if={!@embed and @view == "films"}
        id="fame-floor"
        class="seen-legend muted-note fame-floor"
        phx-change="fame_floor"
      >
        <label>
          知名度
          <select name="floor">
            <option :for={floor <- fame_floors()} value={floor} selected={floor == @fame_floor}>
              {fame_floor_label(floor)}
            </option>
          </select>
        </label>
        <span :if={@fame_floor > 0}>
          （閲覧数の少ない {length(below_floor(@relation, assigns))} 本を隠しています。見た作品は出します）
        </span>
      </form>
      <%!-- いまは見られない印の作品（見ていない作品だけの図では一緒に隠す。出すこともできる） --%>
      <p
        :if={!@embed and @view == "films" and unavailable_count(@marks, @relation[:nodes]) > 0}
        class="seen-legend muted-note"
      >
        いまは見られない印の作品が {unavailable_count(@marks, @relation[:nodes])} 本あります{if @unseen_only and
                                                                                !@unavailable_shown,
                                                                              do: "（いまは隠しています）",
                                                                              else: ""}。
        <button
          :if={@unseen_only}
          type="button"
          class={["seen-toggle", @unavailable_shown && "is-on"]}
          phx-click="toggle_unavailable_shown"
          aria-pressed={to_string(@unavailable_shown)}
        >
          {if @unavailable_shown, do: "見られない作品を隠す", else: "見られない作品も出す"}
        </button>
      </p>
      <%!-- **いまは見られない作品の一覧**（畳む）。付けた日の古い順（見直す順）。名前で図のその作品へ寄り、
         「サブスクを探す」で配信の有無を確かめ、見られるようになったら外す --%>
      <% unavailable = unavailable_rows(@marks, @relation[:nodes]) %>
      <details
        :if={!@embed and @view == "films" and unavailable != []}
        id="unavailable-list"
        class="seen-unavailable"
        phx-mounted={Phoenix.LiveView.JS.ignore_attributes(["open"])}
      >
        <summary>いまは見られない作品（{length(unavailable)} 本）</summary>
        <ul class="unavailable-list">
          <li :for={{name, on} <- unavailable}>
            <button
              type="button"
              class="doc-diff-link"
              phx-click="focus_marked"
              phx-value-name={name}
            >
              {name}
            </button>
            <span class="muted-note">（{Date.to_iso8601(on)} から）</span>
            <a
              href={Chidori.Relations.Films.subscription_search_url(name)}
              target="_blank"
              rel="noreferrer"
              class="sub-search-link"
            >
              サブスクを探す ↗
            </a>
            <button type="button" phx-click="toggle_unavailable" phx-value-name={name}>外す</button>
          </li>
        </ul>
      </details>
      <section
        :if={!@embed and Chidori.Relations.chiezo_view?(@view) and style_legend(@relation) != []}
        class="style-legend"
      >
        <ul>
          <li :for={{style, count, hue} <- style_legend(@relation)}>
            <button
              type="button"
              class={@style_filter == style && "on"}
              phx-click="filter_style"
              phx-value-style={style}
              aria-pressed={to_string(@style_filter == style)}
            >
              <span class="swatch" style={"background: hsl(#{hue} 62% 72%)"}></span>
              {style}<span class="muted-note">{count}{counter_of(@view)}</span>
            </button>
          </li>
          <li :if={@style_filter}>
            <button type="button" class="clear" phx-click="filter_style" phx-value-style="">
              すべて出す
            </button>
          </li>
        </ul>
      </section>

      <%!-- 出典を並べていた右半分を畳んで、説明のほうを広げた。**読むのは見方のほう**で、
         出典は表示例のものが固定で出ているだけだった --%>
      <section :if={!@embed} class="relation-guide">
        <h2>この図の見方</h2>
        <%= if @view == "painters" do %>
          <p>
            <strong>縦は時代</strong>です（上から下へ、並びは生年順）。左端の年代は図を
            動かしても貼り付いたままになります。丸を等間隔に並べているので、 <strong>画家が多い時代ほど目盛りの間隔が広がります</strong>。
          </p>
          <p>
            <strong>横は地域</strong>です（ヨーロッパ／南北アメリカ／アジア・その他）。
            帯の幅はその地域の画家の数で、名前は上端に貼り付きます。
            地域が取れていない画家は「その他」に入ります。
          </p>
          <p>
            <strong>札の大きさは知られている度合い</strong>（日本語版 Wikipedia の月間閲覧数）、 <strong>色は様式</strong>です。様式は札の中の 2 行目にも書いてあります。 <strong>複数の様式を持つ画家は、そのうち 1 つの色</strong>になります
            （丸は 1 つしかないので、どれを選んでも同じくらい正しくない）。
            下の凡例を押すと<strong>その様式だけを大きく並べ直します</strong>。
          </p>
          <p>
            <strong>直近の巡回で動いた画家は、緑の破線で囲みます</strong> （Chiezo が足したか直したかしたもの）。図の下の「動いたものだけ」を押すと、
            その人たちだけを大きく並べ直します。<strong>最初の一括作成では出ません</strong> ——
            全部が同じ時刻になるので、比べる先がありません。
          </p>
          <p>
            <strong>どの名前も押せます。</strong> 1 回押すとその人と線と線の先が立ち、もう一度押すと、もとになった記事・Chiezo に入っているタグ・
            代表作の絵（最大 3 枚）が出て、その場で <strong>「この画家を詳しく調べて」を Chiezo に頼めます</strong>。
            名前のうしろの <strong>{Chidori.Relations.Graph.work_mark()}</strong> は
            代表作が入っている印です。
          </p>
          <p>
            <strong>線も押せます。</strong>
            濃い矢印は AI が調べた影響関係で、 <strong>何をもってそう言えるのかは AI の判断そのもの</strong>です
            （影響関係は記事に書いていないので機械では引けません）。
            薄い線は記事どうしが互いにリンクしているというだけの関係で、 <strong>Wikipedia から機械的に引いたもの</strong>です。
            どちらを押しても、その線の根拠と両者の記事へのリンクが出ます。
          </p>
          <p>
            図は<strong>引きずって移動、Ctrl+ホイールで拡大縮小</strong>できます
            （素のホイールはページのスクロールに使います）。 <strong>小さすぎる札と、見えていないところは描きません</strong> ——
            8,000 人を一度に並べると読めないので、拡大すると出てきます。
          </p>
        <% else %>
          <%= if @view == "films" do %>
            <p>
              <strong>縦は公開年</strong>（上から下へ）、 <strong>横は国</strong>です（日本・アメリカ・ほかの国。合作は先に書いた順に当たる帯へ、国の分類が無い作品は「その他」へ）。 <strong>札の大きさは知られている度合い</strong>（日本語版 Wikipedia の月間閲覧数）、 <strong>色は国</strong>です。
            </p>
            <p>
              <strong>青の線は同じ監督の作品どうし、橙の線は同じ俳優が主演した作品どうし</strong>で、どちらも公開年の順に隣どうしを結んでいます（線の字が監督・俳優の名前）。
              名簿・監督・公開年・国は Wikipedia の分類から機械的に引き、 <strong>主演だけは AI が書いています</strong>（主演の分類は Wikipedia に無いため）。
              薄い線は記事どうしが互いにリンクしている（続編など）というだけの関係です。
            </p>
            <p>
              <strong>名簿は知名度で下を切っています</strong>（主な映画賞の受賞作は知名度に関わらず入れます）。設定の「名簿の広さ」で下げると広がります。
              <strong>どの作品も、どの線も押せます。</strong>
              作品は 1 回押すと線と線の先（同じ監督・同じ主演の作品は隣どうしでなくても全部）が立ち、もう一度押すと詳細が開きます（余白を押すと戻る）。
            </p>
          <% else %>
            <p>
              <strong>縦は年代</strong>です（上から下へ。人は生年）。 <strong>札の大きさは知られている度合い</strong>（日本語版 Wikipedia の月間閲覧数）、 <strong>色は種別</strong>（俳優・歌手・タレント・お笑いなど）です。写真のある人は札に顔写真が出ます（Wikimedia Commons。押すと出典とライセンス）。
            </p>
            <p>
              <strong>太い赤の線は夫婦</strong>（元夫婦も）、 <strong>橙の線は家族</strong>（親子・きょうだい）、 <strong>青の線は同じグループ</strong>（コンビ・アイドルグループ・バンド。生年の順に隣どうしを結び、線の字がグループの名前）です。どれも AI が公表されている情報から書いたもので、
              未成年の家族と、芸能人でない家族は載せていません。
              薄い線は記事どうしが互いにリンクしているというだけの関係で、Wikipedia から機械的に引いたものです。
            </p>
            <p>
              <strong>どの名前も、どの線も押せます。</strong>
              名前は 1 回押すと線と線の先（同じグループの人は隣どうしでなくても全員）が立ち、もう一度押すと、もとになった記事・Chiezo に入っているタグが出ます。線を押すと根拠が出ます。
            </p>
          <% end %>
        <% end %>
      </section>
    <% end %>

    <%!-- Chiezo の状態と、そこへ送る設定を **1 つの枠にまとめる**。
         状態を見る場所と、直す場所と、押す場所が離れていると、何がどこへ効くのか
         読めない --%>
    <%!-- 設定はページの名前を冠した 1 つの枠にまとめる（他の画面と同じ形）--%>
    <section
      :if={!@embed and @collect_mode}
      class={[
        "settings-panel",
        settings_ready?(@settings) && stopped_class(with_settings(@relation, @settings))
      ]}
      aria-label={"#{@relation.title}の設定"}
    >
      <%!-- **見出しそのものを開閉の口にする。** 設定は見たいときだけ見るもので、
           開いたときに Chiezo から読む（図を開くたびに巡回・区画・依頼文まで
           運んでいた頃は、見もしない設定のために待たされた）。
           <details> にしないのは、開いたことをサーバーが知る必要があるため
           （開閉はサーバーが持ち、描き直しで勝手に閉じないようにする） --%>
      <%!-- **見出しの行の右端に「止める」「動かす」**（`ChidoriWeb.CollectSwitch`。設定を読み終えてから） --%>
      <% loaded = settings_ready?(@settings) && with_settings(@relation, @settings) %>
      <div class="settings-title-row">
        <h2>{@relation.title}の設定</h2>
        <.live_component
          :if={loaded && loaded.collection}
          module={ChidoriWeb.CollectSwitch}
          id="switch-relation"
          collection={loaded.collection}
        />
      </div>

      <div :if={@settings_open} id="chiezo-settings">
        <%!-- 最新情報からの引き継ぎ（映画の図だけ）。収集の画面に置く --%>
        <section :if={@view == "films"} class="settings-block seen-mark">
          <%!-- 最新情報からの引き継ぎ。**時計の動きを画面で読めるようにする** —— 見えないと、
             頼んだのか・いつ頼むのか・何が残っているのかを確かめようがない --%>
          <div :if={@carry_setting} class="film-carry">
            <p class="seen-mark-title">最新情報からの引き継ぎ</p>
            <p class="muted-note">
              最新情報の映画のうち、見た記録を付けた作品と、注目度が高く公開された作品を、決めた時刻に
              まとめて図へ足すよう頼みます（まだのものがあるときだけ。AI を 1 回使います）。時刻と 1 回に頼む数は
              <.link navigate={~p"/collect"}>収集</.link>
              の「映画のつながり」の行で決めます。時刻を決めていない Chidori からは頼みません。
            </p>
            <p>
              前回:
              <%= if @carry_setting.last_at do %>
                {Jst.format(@carry_setting.last_at)}（{@carry_setting.last_by}） {@carry_setting.last_result}
                <span :if={@carry_setting.last_titles != []} class="muted-note">
                  — {Enum.join(@carry_setting.last_titles, "・")}
                </span>
              <% else %>
                まだ頼んでいません
              <% end %>
            </p>
            <p>次の予定: {FilmCarry.next_text(@carry_next)}</p>
            <p>
              <button
                type="button"
                phx-click="carry_pending"
                disabled={@carry_pending == :loading}
              >
                {if @carry_pending == :loading,
                  do: "Chiezo に聞いています…",
                  else: "まだ引き継いでいない作品を読む"}
              </button>
              <button
                type="button"
                phx-click="carry_batch"
                data-confirm={"時計を待たずに、上から #{@carry_setting.batch} 本まで図に足すよう頼みます（AI を 1 回使います）。よろしいですか？"}
              >
                いま頼む
              </button>
              <span :if={@carry_message} class="muted-note">{@carry_message}</span>
            </p>
            <%= case @carry_pending do %>
              <% {:error, reason} -> %>
                <p class="muted-note">読めませんでした: {reason}</p>
              <% [] -> %>
                <p class="muted-note">まだ引き継いでいない作品はありません。</p>
              <% items when is_list(items) -> %>
                <p class="muted-note">
                  見た記録を付けた作品と、注目度が高く公開された作品のうち、まだ図に無いもの {length(items)} 本（最新情報の全部ではありません）。見た作品（見た日の新しい順）→ 注目度の高い作品（公開日の新しい順）に並び、次の回に頼むのは上から {@carry_setting.batch} 本です（頼むのをやめた作品は数えません）
                </p>
                <ul>
                  <li :for={item <- items}>
                    {item.title}
                    <span :if={item[:date]} class="muted-note">（公開 {Date.to_iso8601(item.date)}）</span>
                    <span :if={item.tries >= CarrySetting.max_attempts()} class="muted-note">
                      — {item.tries} 回頼んでも載らなかったので、時計からは頼みません
                    </span>
                    <button
                      :if={item.tries >= CarrySetting.max_attempts()}
                      type="button"
                      phx-click="carry_one"
                      phx-value-title={item.title}
                      data-confirm={"「#{item.title}」を図に足すよう頼みます（AI を 1 回使います）。よろしいですか？"}
                    >
                      この作品を頼む
                    </button>
                    <span
                      :if={item.tries > 0 and item.tries < CarrySetting.max_attempts()}
                      class="muted-note"
                    >
                      — {item.tries} 回頼みました
                    </span>
                  </li>
                </ul>
              <% _ -> %>
            <% end %>
          </div>
        </section>
        <p class="muted-note origin-note">{origin_note(@view)}</p>
        <p :if={trouble_message(@relation)} class="warn-note" aria-live="polite">
          {trouble_message(@relation)}
        </p>
        <p :if={step_note(@relation)} class="muted-note">{step_note(@relation)}</p>
        <p :if={busy_note(@relation)} class="muted-note">{busy_note(@relation)}</p>

        <%!-- **読み終えるまでは何も出さない。** 途中のものを出すと、読めた欄と
             まだの欄が混ざり、空いている欄が「設定が無い」のか「まだ読んでいない」のか
             見分けられない --%>
        <%= cond do %>
          <% match?({:error, _reason}, @settings) -> %>
            <p class="warn-note">
              Chiezo から設定を読めませんでした: {relation_reason(elem(@settings, 1))}
            </p>
          <% !settings_ready?(@settings) -> %>
            <p class="muted-note" aria-live="polite">Chiezo から情報を取得しています…</p>
          <% true -> %>
            <% cfg = with_settings(@relation, @settings) %>
            <dl :if={collection_facts(cfg) != []} class="collect-facts">
              <div :for={{label, value} <- collection_facts(cfg)}>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            </dl>

            <%!-- **選んだところはサーバーが覚える**（`phx-change`）。覚えないと、図や状態が
                 届いた拍子にフォームが描き直され、選んだ相手が元の値に戻る ——
                 選んだつもりで押すと、いま入っている値がそのまま送り返される --%>
            <form id="collect-form" phx-submit="collect" phx-change="pick_sweep">
              <%!-- 巡回ごとに 1 行。**相手も進み具合も巡回ごとに違う**ので、収集に 1 つだけ
                   出すと、そこに出る値はどちらか片方のものにしかならない --%>
              <.sweep_table state={cfg} picks={@picks} backends={@settings.backends} />

              <p class="muted-note">{source_note(@view)}</p>
              <div class="button-row">
                <button
                  type="submit"
                  phx-disable-with="送っています…"
                  disabled={collecting?(@relation)}
                >
                  {collect_label(@relation)}
                </button>
              </div>
            </form>

            <%!-- 名簿の広さ（芸能人の図）。**知名度で下を切って始め、落ち着いたら広げる**。
                 引き直す回は足すだけなので、下限を上げても名簿からは消えない --%>
            <form :if={@view in ["people", "films"]} id="roster-form" phx-submit="reroster">
              <% now = Chidori.Relations.Settings.min_pageviews(@view) %>
              <label>
                名簿の広さ（Wikipedia の月の閲覧数の下限）
                <select name="min">
                  <option
                    :for={value <- Chidori.Relations.Settings.choices()}
                    value={value}
                    selected={value == now}
                  >
                    月 {delimit(value)} 以上
                  </option>
                </select>
              </label>
              <button type="submit" phx-disable-with="頼んでいます…">名簿を引き直す</button>
              <p class="muted-note">
                いまは月 {delimit(now)} 以上の人とグループを名簿にしています。下げると名簿が広がります（足すだけで、上げても名簿からは消えません）。
              </p>
              <p :if={@reroster_message} class="muted-note" aria-live="polite">
                {@reroster_message}
              </p>
            </form>

            <%!-- **区画の一覧は全部出す。** どこがまだ見られていないかは、ここにしか
                 無い —— 「ここを先に見てほしい」を頼む口でもある。
                 未レビューの人が残る区画は、「ざっと見る」の回としても頼める --%>
            <%!-- **巡回ごとに列を出す。** 1 本の巡回の印だけを出していた頃は、まだ回っていない
                 巡回のほうの「まだ」が全区画に並び、ざっと見るがどこまで済んだのか読めなかった --%>
            <% sweeps = [Chidori.Relations.rough_sweep(), Chidori.Relations.survey_sweep()] %>
            <% rows = partition_rows(cfg, sweeps) %>
            <% target = target_partition(cfg, @partition_of, @view) %>
            <%!-- 詳細の「この作品の区画を見る」から来たら、その区画の行を開いて目立たせる --%>
            <p :if={@partition_of && rows != []} class="muted-note partition-target-note">
              {if target,
                do: "「#{@partition_of.name}」は区画「#{target}」に入っています（下の表で目立たせています）。",
                else:
                  if(is_list(@partition_of.tags),
                    do: "「#{@partition_of.name}」の区画が見つかりませんでした。",
                    else: "「#{@partition_of.name}」の区画を調べています…"
                  )}
            </p>
            <details :if={rows != []} class="partition-list" open={target != nil}>
              <% progress = partition_progress(rows, sweeps) %>
              <summary>
                区画（<span :if={progress}>{elem(progress, 1)} / </span>{length(rows)}）
              </summary>
              <p class="muted-note">
                <span :if={progress}>
                  「/」の前は「{elem(progress, 0)}」が見終わった区画の数です（ざっと見るが一周したら、整理の数に変わります）。
                </span>
                まだ見ていないものが先に表示されます。
                <%!-- **未レビューの数だけは古いことがある。** 見た印は設定欄を開いたときに
                     読み直すが、未レビューの数は図を取得したときの画家から数える ——
                     図を取り直さないと、見た印だけが進んで数が食い違って見える --%>
                <strong>未レビューの数は、図を最後に取得した時点（{unreviewed_as_of(@relation)}）のものです。</strong>
                <button
                  type="button"
                  class="inline-reload"
                  phx-click="reload"
                  disabled={reloading?(@relation)}
                >
                  {if reloading?(@relation), do: "取り直しています…", else: "未レビューの数を取り直す"}
                </button>
                区画は「地域 × 生年」で切ってあります。 <strong>「ざっと見る」</strong>
                は未レビューの人に目を通して空欄を埋める回、 <strong>「整理」</strong>
                は漏れ探しと磨きの回として、その区画を先に見てもらいます（印が付くので、巡回が同じところをもう一度見ることはありません）。
                見終わった区画も、もう一度頼めます。
              </p>
              <table class="partition-table">
                <thead>
                  <tr>
                    <th>区画</th>
                    <th>人数</th>
                    <th title="図を最後に取得した時点の数です">未レビュー（取得時点）</th>
                    <th :for={sweep <- sweeps}>{sweep}</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <tr
                    :for={row <- rows}
                    id={if row.key == target, do: "partition-target"}
                    class={row.key == target && "is-target"}
                    phx-mounted={row.key == target && JS.dispatch("chidori:reveal")}
                  >
                    <% asked = partition_state(@relation, row.key) %>
                    <td>{row.key}</td>
                    <td>{row.count}</td>
                    <td>{unreviewed_in(cfg, row.key)}</td>
                    <td :for={sweep <- sweeps}>{row.seen_at[sweep] || "まだ"}</td>
                    <td class="partition-actions">
                      <span :if={asked && asked.state == :sent} class="muted-note">頼みました</span>
                      <span :if={asked && asked.state == :failed} class="warn-note">
                        {focus_error(asked)}
                      </span>
                      <%!-- 並びは列と同じ（ざっと見る → 整理）。**どちらも常に出す** ——
                           見終わった区画を見直したいこともある --%>
                      <form :for={sweep <- sweeps} phx-submit="focus_partition">
                        <input type="hidden" name="key" value={row.key} />
                        <input type="hidden" name="sweep" value={sweep} />
                        <button type="submit" phx-disable-with="頼んでいます…">{sweep}</button>
                      </form>
                    </td>
                  </tr>
                </tbody>
              </table>
            </details>

            <%!-- **消えた画家。** 図に丸が無いので、戻すよう頼む口はここにしか無い --%>
            <details
              :if={Chidori.Relations.chiezo_view?(@view) and (@relation[:removed] || []) != []}
              class="partition-list"
            >
              <summary>消えた{unit_of(@view)}（{length(@relation[:removed])}）</summary>
              <p class="muted-note">
                Chiezo の整理が「対象ではない」「重複」などの理由で消した人です。新しく消えた順に並びます。
                消し間違いなら「戻すよう頼む」を押すと、その人を名指しして Chiezo に確かめ直してもらいます（定時の巡回には影響しません）。
              </p>
              <%!-- **表にしない。** 理由は長い文なので、列に並べると横へはみ出す --%>
              <ul class="removed-list">
                <li :for={gone <- @relation[:removed]}>
                  <% asked = focus_state(@relation, gone.name) %>
                  <p class="removed-head">
                    <strong>{gone.name}</strong>
                    <span class="muted-note">{Chidori.Jst.format(gone.removed_at)}</span>
                  </p>
                  <p class="removed-reason">{blank_dash(gone.reason)}</p>
                  <p :if={asked && asked.state == :failed} class="warn-note">
                    {focus_error(asked)}
                  </p>
                  <%= if @focus_sent == gone.name and (asked == nil or asked.state != :failed) do %>
                    <p class="muted-note">頼みました</p>
                  <% else %>
                    <form phx-submit="restore_painter" class="removed-form">
                      <input type="hidden" name="name" value={gone.name} />
                      <input type="text" name="note" placeholder="補足（空でもよい）" />
                      <button type="submit" phx-disable-with="頼んでいます…">戻すよう頼む</button>
                    </form>
                  <% end %>
                </li>
              </ul>
            </details>

            <%!-- **どちらも Chiezo が持っているもの**なので、1 つにまとめる。
                 機械で引いたものと AI が書いたものの線引きが、この図でいちばん大事なところ --%>
            <details :if={Chidori.Relations.chiezo_view?(@view)} class="news-prompt">
              <summary>Chiezo への依頼文</summary>
              <p class="news-prompt-note">{prompt_note(cfg)}</p>

              <h3>抽出の指定（Wikipedia から機械的に引く条件）</h3>
              <p class="news-prompt-note">
                名簿・年代・様式・地域・代表作・相互リンクは、この指定で日本語版 Wikipedia から
                引いています。<strong>AI は関わりません</strong>（決まった結果が出ます）。
              </p>
              <pre :if={extract_text(cfg)}>{extract_text(cfg)}</pre>
              <p :if={!extract_text(cfg)} class="muted-note">まだ指定が入っていません。</p>

              <h3>指示文（AI に頼んでいる内容）</h3>
              <p class="news-prompt-note">
                AI が書くのは<strong>影響関係と説明</strong>と、カテゴリに無い様式です。
                誰を見るかは Chiezo が区画で渡すので、指示文には書いてありません。
              </p>
              <pre>{prompt_text(cfg, @view)}</pre>
            </details>
        <% end %>

        <%!-- 最近の回の見出しを押したときの、1 件の変更（この画面の上に重ねて開く） --%>
        <.live_component module={ChidoriWeb.DocDiff} id="doc-diff" />
        <%!-- **最近の回**（Chiezo の変更履歴。収集の画面を開いたときに読む。`ChidoriWeb.RecentRuns`） --%>
        <.recent_runs
          runs={@recent_runs}
          collection={Chidori.Relations.collection_of(@view)}
          reload="reload_recent_runs"
        />
      </div>
    </section>

    <%!-- 押した人のこと。**絵は持たず、Wikipedia のものを指すだけ**。
         図の外に重ねて出す —— 図の下に足すと、押した人が画面の外にいることがある --%>
    <%!-- 影響の線を押したとき。**何をもって影響元としたかを正直に出す** ——
         影響関係は Wikipedia に書いていないので機械では引けず、ここは AI の判断
         そのもの。根拠を確かめたい人が記事へ行けるようにする --%>
    <div
      :if={@edge}
      class="artwork-backdrop"
      phx-window-keydown="close_work"
      phx-key="Escape"
    >
      <section
        class="artwork"
        role="dialog"
        aria-modal="true"
        aria-labelledby="edge-name"
        phx-click-away="close_work"
      >
        <%!-- **映画の図の同じ監督・同じ主演の線は、その人を出す**（線が言えるのは「2 本が同じ人の作品」だけ） --%>
        <%= if @edge[:people] do %>
          <div class="artwork-head">
            <span class="head-title">
              <strong id="edge-name">
                {Enum.map_join(@edge.people, "・", & &1.name)}（{hd(@edge.people).role}）
              </strong>
              <%!-- 1 人なら記事へのアイコンを題名の右に（2 人なら各人の見出しの右） --%>
              <.wiki_link
                :if={length(@edge.people) == 1}
                href={"https://ja.wikipedia.org/wiki/" <> URI.encode(hd(@edge.people).name)}
                label={hd(@edge.people).name}
              />
            </span>
            <button type="button" phx-click="close_work">閉じる</button>
          </div>
          <section :for={person <- @edge.people} class="edge-person">
            <h3 :if={length(@edge.people) > 1} class="edge-heading">
              {person.name}
              <.wiki_link
                href={"https://ja.wikipedia.org/wiki/" <> URI.encode(person.name)}
                label={person.name}
              />
            </h3>
            <%= case @edge_people[person.name] do %>
              <% :loading -> %>
                <p class="muted-note">説明を読んでいます…</p>
              <% text when is_binary(text) -> %>
                <p class="artwork-extract">{text}</p>
              <% _none -> %>
                <p class="muted-note">Wikipedia の説明が見つかりませんでした。</p>
            <% end %>
            <%!-- 芸能人の図でその人を探す（図に載っていればその人へ寄り、無ければ名前で探した形で開く） --%>
            <p>
              <.link patch={"/relations?" <> URI.encode_query(%{"view" => "people", "focus" => person.name})}>
                芸能人の図で探す
              </.link>
            </p>
            <h4 class="edge-heading">図にある{person.role}作品（{length(person.films)} 本）</h4>
            <ul class="edge-person-films">
              <%!-- 押すと詳細を閉じて、その作品を探して選んだときと同じにする --%>
              <li :for={{title, years} <- person.films}>
                <button
                  type="button"
                  class="doc-diff-link"
                  phx-click="focus_film"
                  phx-value-name={title}
                >
                  {title}
                </button>
                <span :if={years} class="muted-note">（{years}）</span>
              </li>
            </ul>
          </section>
        <% else %>
          <div class="artwork-head">
            <strong id="edge-name">{@edge.from.name} → {@edge.to.name}</strong>
            <button type="button" phx-click="close_work">閉じる</button>
          </div>
          <%= if @edge.kind == :influence do %>
            <p class="edge-reason">
              <strong>{@edge.to.name}</strong>は<strong>{@edge.from.name}</strong>から影響を受けた、と AI が書いています。
            </p>
            <h3 class="edge-heading">何を受けたか</h3>
            <p :if={@edge.label} class="edge-label-text">{@edge.label}</p>
            <p :if={!@edge.label} class="muted-note">AI は中身を書いていません（線だけがあります）。</p>
          <% else %>
            <p :if={@edge.kind == :spouse} class="edge-reason">
              <strong>{@edge.from.name}と{@edge.to.name}は{if @edge.label == "元配偶者", do: "以前夫婦でした", else: "夫婦です"}</strong>（{@edge.label ||
                "配偶者"}）。AI が公表されている情報から書いています。
            </p>
            <p :if={@edge.kind == :family} class="edge-reason">
              <strong>{@edge.from.name}と{@edge.to.name}は家族です</strong>（{@edge.label || "家族"}）。AI が公表されている情報から書いています。
            </p>
            <p :if={@edge.kind == :group} class="edge-reason">
              <strong>{@edge.from.name}と{@edge.to.name}は、どちらも{@edge.label}のメンバーです。</strong>AI が公表されている情報から書いています。
            </p>
            <p :if={@edge.kind == :duo} class="edge-reason">
              <strong>{@edge.to.name}は{@edge.from.name}の{@edge.label || "メンバー"}です。</strong>AI が公表されている情報から書いています。
            </p>
            <p :if={@edge.kind == :related} class="edge-reason">
              <strong>{@edge.from.name}と{@edge.to.name}は、記事どうしが互いにリンクしています。</strong>
            </p>
          <% end %>

          <%!-- **説明の中で相手に触れているところ。** AI の一言だけでは根拠が読めない
             ので、本文から相手の名前が出てくる文を拾って出す --%>
          <%= if @edge.excerpt != [] do %>
            <h3 class="edge-heading">
              {if @edge.kind == :influence, do: @edge.to.name, else: @edge.from.name}の説明より
            </h3>
            <blockquote class="edge-excerpt">
              <p :for={sentence <- @edge.excerpt}>{sentence}</p>
            </blockquote>
          <% end %>

          <%!-- 2 人を並べて比べる。**時代と地域と様式が並ぶと、線の意味が読める**
             （同じ国の師弟なのか、時代を越えた私淑なのか） --%>
          <table class="edge-compare">
            <thead>
              <tr>
                <th></th>
                <th>{@edge.from.name}</th>
                <th>{@edge.to.name}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th>年代</th>
                <td>{@edge.from[:years] || "—"}</td>
                <td>{@edge.to[:years] || "—"}</td>
              </tr>
              <tr :if={@view == "painters"}>
                <th>地域</th>
                <td>{regions_of(@edge.from) |> Enum.join("、") |> blank_dash()}</td>
                <td>{regions_of(@edge.to) |> Enum.join("、") |> blank_dash()}</td>
              </tr>
              <tr>
                <th>{style_heading(@view)}</th>
                <td>{Enum.join(@edge.from[:styles] || [], "、") |> blank_dash()}</td>
                <td>{Enum.join(@edge.to[:styles] || [], "、") |> blank_dash()}</td>
              </tr>
            </tbody>
          </table>
          <p :if={shared_styles(@edge) != []} class="muted-note">
            共通する様式: {Enum.join(shared_styles(@edge), "、")}
          </p>
          <p :if={@edge.kind == :influence and @edge.mutual} class="muted-note">
            逆向き（{@edge.to.name} → {@edge.from.name}）の影響も書かれています。互いに影響し合った組です。
          </p>
          <p :if={@edge.kind == :influence and @edge.others != []} class="muted-note">
            {@edge.to.name}の影響元はほかに: {Enum.join(@edge.others, "、")}
          </p>

          <p :if={@edge.kind == :director} class="muted-note">
            どちらも<strong>{@edge.label}</strong>が監督した作品です（Wikipedia の分類から機械的に引いたもの）。
          </p>
          <p :if={@edge.kind == :costar} class="muted-note">
            どちらも<strong>{@edge.label}</strong>が主演した作品です。
          </p>
          <%= if @edge.kind in [:spouse, :family, :duo, :group, :costar] do %>
            <p class="muted-note">
              <strong>AI が書いたものです。</strong> 確かめるには、それぞれの記事を読んでください。
            </p>
          <% end %>
          <%= if @edge.kind == :influence do %>
            <p class="muted-note">
              <strong>これは AI の判断です。</strong>
              名簿・年代・様式・相互リンクは Wikipedia から機械的に引いていますが、 <strong>誰が誰から何を受けたのかは記事に書いていない</strong>ので引けません。
              確かめるには、それぞれの記事を読んでください。
            </p>
          <% end %>
          <%= if @edge.kind == :related do %>
            <p class="muted-note">
              これは Wikipedia から機械的に引いた線で、<strong>{related_not(@view)}ではありません</strong>。
              <strong>片側だけのリンクは採りません</strong>
              —— 有名な人は多くの記事から
              名前を出されるので、片側で繋ぐと有名どうしが軒並み繋がって図が読めなくなります。
              互いに名前を出している組だけを残しています。 <strong>何の関係かまでは、リンクの有無からは分かりません</strong>。
            </p>
          <% end %>
          <ul class="edge-links">
            <li :if={article_url(@edge.from)}>
              {@edge.from.name}
              <.wiki_link href={article_url(@edge.from)} label={@edge.from.name} />
            </li>
            <li :if={article_url(@edge.to)}>
              {@edge.to.name} <.wiki_link href={article_url(@edge.to)} label={@edge.to.name} />
            </li>
          </ul>
        <% end %>
      </section>
    </div>

    <div
      :if={@detail}
      class="artwork-backdrop"
      phx-window-keydown="close_work"
      phx-key="Escape"
    >
      <section
        class="artwork"
        role="dialog"
        aria-modal="true"
        aria-labelledby="artwork-name"
        phx-click-away="close_work"
      >
        <div class="artwork-head">
          <span class="head-title">
            <strong id="artwork-name">{@detail.name}</strong>
            <%!-- 映画の題名をコピーする（題名のすぐ右上の小さなアイコン。配信サービスなどで探すため、
               記事名の「(映画)」の札は外す）。写すのは見る人のブラウザ（app.js の chidori:copy） --%>
            <span :if={@view == "films"} class="copy-title">
              <button
                type="button"
                data-copy={Chidori.Relations.Films.plain_title(@detail.name)}
                phx-click={Phoenix.LiveView.JS.dispatch("chidori:copy")}
                aria-label="題名をコピー"
                title="題名をコピー"
              >
                <svg class="copy-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="9" y="9" width="11" height="11" rx="2" />
                  <path d="M5 15V5a2 2 0 0 1 2-2h10" />
                </svg>
                <svg class="check-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 12.5 9.5 18 20 6.5" />
                </svg>
              </button>
              <span class="copy-status" role="status"></span>
            </span>
            <%!-- 記事へのリンクは題名の右にアイコンで。**行き先は押した人・作品の記事**（代表作の記事へ
               飛ばすと「この人のことを知りたい」に答えていない） --%>
            <.wiki_link
              :if={article_url(@detail)}
              href={article_url(@detail)}
              label={@detail[:article] || @detail.name}
            />
          </span>
          <span :if={@detail[:unreviewed?]} class="review-badge">未レビュー</span>
          <button type="button" phx-click="close_work">閉じる</button>
        </div>

        <%!-- **未レビューの人は、区画ごと先にざっと見てもらえる。** 1 人だけ頼むより、
             同じ地域・同じ時代の未レビューの人がまとめて片付く --%>
        <div :if={@detail[:unreviewed?]} class="review-ask">
          <p class="muted-note">
            AI がまだ目を通していない{unit_of(@view)}です（機械で名簿に入っただけで、説明やつながりが空のことがあります）。
          </p>
          <%!-- 区画は押したときに割り出す（区画の一覧は設定なので、開いただけでは読まない） --%>
          <% asked = focus_state(@relation, Chidori.Relations.partition_focus_id(@detail.name)) %>
          <p :if={asked && asked.state == :sending} class="muted-note">区画を調べて頼んでいます…</p>
          <p :if={asked && asked.state == :sent} class="muted-note">
            区画「{asked[:partition]}」を先にざっと見るよう頼みました。
          </p>
          <p :if={asked && asked.state == :failed} class="warn-note">{focus_error(asked)}</p>
          <button
            :if={!asked or asked.state == :failed}
            type="button"
            phx-click="focus_painter_partition"
            phx-value-name={@detail.name}
            phx-disable-with="頼んでいます…"
          >
            この{unit_of(@view)}の区画を先にざっと見てもらう
          </button>
        </div>

        <%!-- **その画家の姿。** 記事の先頭画像は、たいてい自画像か肖像写真。
             説明の横に小さく置く（主役は代表作のほうなので、大きくしない）。
             無ければ何も出さない —— 探している最中の文言も出さない（無い人のほうが多い） --%>
        <%!-- 芸能人の顔写真。**写真ごとにライセンスが違う**ので、Commons のファイルの
             ページ（出典とライセンスが書いてある）へのリンクを添える --%>
        <figure :if={@detail[:face]} class="portrait">
          <img src={@detail.face} alt={"#{@detail.name}の写真"} />
          <figcaption>
            <a
              :if={Chidori.Relations.Faces.file_page(@detail[:image])}
              href={Chidori.Relations.Faces.file_page(@detail[:image])}
              target="_blank"
              rel="noreferrer"
            >
              Wikimedia Commons（出典・ライセンス）
            </a>
          </figcaption>
        </figure>
        <figure :if={is_map(@portrait) and is_binary(@portrait[:image])} class="portrait">
          <img src={SafeUrl.src(@portrait.image)} alt={"#{@detail.name}の肖像"} />
          <figcaption>Wikipedia より</figcaption>
        </figure>

        <%!-- その画家の短い説明（記事の冒頭）。**絵の説明だけが出て、描いた人の
             説明が出ないのは片手落ち** —— 押したのは画家のほう --%>
        <p :if={@detail[:summary]} class="artwork-extract">{@detail.summary}</p>
        <%!-- **その 1 件の区画へ飛ぶ**（収集の画面の区画の表。その行を開いて目立たせる）。巡回がどこまで
             見たか・先に見てもらうかを、その 1 件から辿れるように --%>
        <p :if={!@embed and Chidori.Relations.chiezo_view?(@view)} class="partition-jump">
          <.link navigate={"/collect/relations?" <> URI.encode_query(%{"view" => @view, "partition_of" => @detail.name})}>
            この{unit_of(@view)}の区画を見る
          </.link>
        </p>
        <%!-- 上映時間（映画の図。整理の回に AI が確かめて書く） --%>
        <p :if={@detail[:runtime]} class="muted-note runtime-note">上映時間 {@detail.runtime} 分</p>

        <%!-- Chiezo に入っているタグ。**どういう条件でこの人が名簿に入り、
             何が分かっているのか**が、ここを見ないと読み取れない --%>
        <dl :if={tag_groups(@detail) != []} class="artwork-tags">
          <%= for {label, values} <- tag_groups(@detail) do %>
            <dt>{label}</dt>
            <%!-- 主演は押せる名前にする。芸能人の図に載っている人はその人へ飛び、
                 載っていない人は Wikipedia の記事へ --%>
            <%!-- 映画の図の主演・監督は、押すと詳細を閉じてその人の作品の鎖を立たせる
                 （その人の線を 1 回押したときと同じ）。その人のことは線をもう一度押すと開く --%>
            <dd :if={@view == "films" and label in ["主演", "監督"]} class="star-links">
              <%= for {name, index} <- Enum.with_index(values) do %>
                {if index > 0, do: "、"}
                <button
                  type="button"
                  class="doc-diff-link"
                  phx-click="pick_person"
                  phx-value-prefix={label}
                  phx-value-name={name}
                >
                  {name}
                </button>
              <% end %>
            </dd>
            <dd :if={@view != "films" and label == "主演"} class="star-links">
              <%= for {name, index} <- Enum.with_index(values) do %>
                {if index > 0, do: "、"}
                <%= case star_href(name, @star_people) do %>
                  <% {:inside, href} -> %>
                    <.link patch={href}>{name}</.link>
                  <% {:outside, href} -> %>
                    <a href={href} target="_blank" rel="noreferrer">{name} ↗</a>
                <% end %>
              <% end %>
            </dd>
            <dd :if={label != "主演" and not (@view == "films" and label == "監督")}>
              {Enum.join(values, "、")}
            </dd>
            <%!-- **知名度は主演の下に**（札の大きさの順位と、その閲覧数・決め方） --%>
            <.fame_rank_row
              :if={label == "主演"}
              rank={fame_rank(@relation, @detail)}
              counter={counter_of(@view)}
            />
          <% end %>
          <%!-- 主演の無い札は、タグの最後に --%>
          <.fame_rank_row
            :if={not List.keymember?(tag_groups(@detail), "主演", 0)}
            rank={fame_rank(@relation, @detail)}
            counter={counter_of(@view)}
          />
        </dl>

        <%= cond do %>
          <% @artwork == :loading -> %>
            <p class="muted-note">代表作を探しています…</p>
          <% is_list(@artwork) and @artwork != [] -> %>
            <%!-- **何枚もあるなら全部出す。** 多作の画家を 1 枚で代表させると、
                 どれを選んでも「その人らしさ」を外す --%>
            <%= for work <- @artwork do %>
              <figure :if={work.image} class="artwork-figure">
                <img src={SafeUrl.src(work.image)} alt={work.title} />
                <figcaption>
                  <span class="artwork-title">{work.title}</span>
                  <span :if={work[:extract]} class="artwork-extract">{work.extract}</span>
                  <.wiki_link :if={work[:page]} href={SafeUrl.href(work.page)} label={work.title} />
                </figcaption>
              </figure>
              <%!-- **Wikipedia に絵が無い作品は、画像検索へつなぐ。** 記事の無い作品の
                   ほうが多く、落とすと代表作が入っているのに何も見られない --%>
              <p :if={!work.image} class="artwork-search">
                <span class="artwork-title">{work.title}</span>
                <a
                  href={image_search_url(@detail.name, work.title)}
                  target="_blank"
                  rel="noreferrer"
                >
                  Google 画像検索で見る
                </a>
              </p>
            <% end %>
          <% works_of(@detail) == [] and @view != "painters" -> %>
            <%!-- 代表作を持たない図（芸能人）では何も出さない --%>
          <% works_of(@detail) == [] -> %>
            <p class="muted-note">この画家には、まだ代表作が入っていません。</p>
          <% true -> %>
            <p class="muted-note">代表作を読み込めませんでした。</p>
        <% end %>

        <% mark = mark_of(@marks, @detail.name) %>
        <%!-- **いまは見られない**（映画。配信にも上映にも無い作品を、見ていない作品だけの図から隠す）。
           押すたびに付ける・外す。付けた日は図の下の「いまは見られない作品」に出る。見た記録の上に置く --%>
        <p :if={@view == "films" and not mark.seen} class="unavailable-row">
          <button
            type="button"
            class={["seen-toggle", unavailable?(@marks, @detail.name) && "is-on"]}
            phx-click="toggle_unavailable"
            phx-value-name={@detail.name}
            aria-pressed={to_string(unavailable?(@marks, @detail.name))}
          >
            {if unavailable?(@marks, @detail.name),
              do: "見られない印を外す",
              else: "いまは見られない（候補から外す）"}
          </button>
          <span :if={mark.unavailable_on} class="muted-note">
            {Date.to_iso8601(mark.unavailable_on)} に付けた印
          </span>
          <%!-- 配信の有無は「題名 サブスク」で Google を引くとたいてい出る（見る人のブラウザで開く） --%>
          <a
            href={Chidori.Relations.Films.subscription_search_url(@detail.name)}
            target="_blank"
            rel="noreferrer"
            class="sub-search-link"
          >
            サブスクを探す ↗
          </a>
        </p>

        <%!-- 見に行った記録。**図に出ているのは Chiezo から読んだものだけ**で、
             利用者が自分で書いたことはどこにも残せなかった。展覧会で実物を見た、
             という記録は Chiezo には置けない（あちらは題材も好みも持たない側） --%>
        <details class="seen-mark" open={marked?(@marks, @detail.name)}>
          <summary>
            見た記録 <span :if={mark_summary(mark)} class="seen-badge">{mark_summary(mark)}</span>
          </summary>
          <form phx-submit="save_mark">
            <input type="hidden" name="name" value={@detail.name} />
            <p class="seen-row">
              <label>
                <input type="checkbox" name="seen" checked={mark.seen} /> 見た
              </label>
              <label>
                見た日 <input type="date" name="seen_on" value={seen_on_value(mark)} />
              </label>
            </p>
            <p>
              <label>
                メモ（どこで、何を見たか）<br />
                <textarea
                  name="note"
                  rows="3"
                  placeholder="例: 〇〇美術館の回顧展。晩年の風景画がまとめて出ていた"
                >{mark.note}</textarea>
              </label>
            </p>
            <p class="muted-note">
              ここに書いたことは Chidori の置き場（Chiezo の chidori_data）に残ります（収集には書きません）。
              <strong>印もメモも空にして保存すると、記録ごと消えます。</strong>
            </p>
            <button type="submit" phx-disable-with="保存しています…">記録を保存</button>
            <span :if={@mark_saved == @detail.name} class="muted-note">保存しました。</span>
          </form>
        </details>

        <%!-- **この人を詳しく調べて、を頼める。** 巡回は 8,000 人を順に回るので、
             気になった 1 人に当たるのは何日も先になる。割り込みは定時の巡回の
             進み具合にも次の予定にも触らない --%>
        <details :if={Chidori.Relations.chiezo_view?(@view)} class="ask-more">
          <summary>この{unit_of(@view)}を詳しく調べてもらう</summary>
          <% asked = focus_state(@relation, @detail.name) %>
          <%= if asked && asked.state == :failed do %>
            <%!-- **断られたことは必ず出す。** 黙って捨てると「頼んだのに何も
                 起きない」だけが残り、押した人には確かめようがない --%>
            <p class="warn-note">{focus_error(asked)}</p>
          <% end %>
          <%= if @focus_sent == @detail.name and (asked == nil or asked.state != :failed) do %>
            <p class="muted-note">
              Chiezo に頼みました。<strong>結果が図に出るのは、次に Chiezo が集めたあと</strong>です。
            </p>
          <% else %>
            <form phx-submit="focus_painter">
              <input type="hidden" name="name" value={@detail.name} />
              <p>
                <label>
                  どこを調べてほしいか（空でもよい）<br />
                  <textarea
                    name="note"
                    rows="2"
                    placeholder="例: 誰から影響を受けたのかが空のままなので調べて"
                  ></textarea>
                </label>
              </p>
              <p class="muted-note">
                定時の巡回とは別の道で頼みます（進み具合も次の予定も動きません）。
                名指しするので、この{unit_of(@view)}は必ず AI に見せられます。
              </p>
              <button type="submit" phx-disable-with="頼んでいます…">この{unit_of(@view)}を頼む</button>
            </form>
          <% end %>
        </details>
      </section>
    </div>
  </div>
</main>

<%!-- 図の操作（引きずり・押し広げ）は `assets/js/relation_map.js`。**区画の地図と
     同じ仕組み**（`pan_zoom.js`）に、この図だけの事情 —— 年代と地域の札を画面の端へ
     留める、見ている範囲をサーバーへ知らせる、探した人へ寄る —— を足してある。

     図ごとに写しを持つと、片方だけ直した操作の違いがそのまま残る。 --%>
