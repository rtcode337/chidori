<Layouts.flash_group flash={@flash} />
<main class="relations-page collect-page">
  <div>
    <ChidoriWeb.MainNav.main_nav active={:datasets} />

    <%!-- データ収集の画面と同じタブ。**この画面は「食事処」のタブ**として出す
         （別の画面へ飛んだように見えると、戻る口を探すことになる）。範囲ごとのタブは
         並べず、下の「作った範囲」の名前から開く --%>
    <nav
      id="dataset-tabs"
      class="relation-tabs"
      phx-hook="ScrollTabs"
      aria-label="集めるもの"
    >
      <.link
        :for={dataset <- Enum.reject(@datasets, & &1[:area])}
        navigate={~p"/datasets?view=#{dataset.key}"}
      >
        {dataset.name}
      </.link>
      <.link patch={~p"/datasets/areas"} class="selected" aria-current="page">
        食事処
      </.link>
    </nav>

    <section class="relations-intro">
      <p>EATERIES IN AN AREA</p>
      <h1>食事処の範囲</h1>
      <p>
        食事処は、範囲を決めてその中だけを集めます。範囲 1 つにつき Chiezo の収集が 1 つで、下の「作った範囲」の名前を押すと、その範囲の収集を開きます。離れた場所は、別の範囲にしてください（1 つの四角で囲むと、あいだの見たくない土地まで AI が回ります）。
      </p>
    </section>

    <section class="settings-block" aria-label="作った範囲">
      <h3>作った範囲</h3>
      <p :if={@areas == []} class="muted-note">まだありません。下の地図で四角を描いて足してください。</p>
      <ul :if={@areas != []} class="area-list">
        <li :for={area <- @areas} class={@editing && @editing.id == area.id && "is-editing"}>
          <.link navigate={~p"/datasets?view=#{Chidori.Datasets.Dining.definition(area).key}"}>
            {area.name}
          </.link>
          <span class="muted-note">{bbox_text(area)}</span>
          <%!-- 控えている依頼の数（travel-log からの依頼を配った先）。頼むのは範囲の画面から --%>
          <.link
            :if={Map.get(@pending_counts, area.id, 0) > 0}
            navigate={~p"/datasets?view=#{Chidori.Datasets.Dining.definition(area).key}"}
            class="area-pending"
          >
            控えている依頼 {Map.get(@pending_counts, area.id)} 件
          </.link>
          <span class="area-actions">
            <button type="button" phx-click="show_area" phx-value-id={area.id}>地図で見る</button>
            <button type="button" phx-click="edit_area" phx-value-id={area.id}>範囲を直す</button>
            <button
              type="button"
              phx-click="delete"
              phx-value-id={area.id}
              data-confirm={"範囲「#{area.name}」を外します。Chiezo の収集は消えません。よろしいですか？"}
            >
              外す
            </button>
          </span>
        </li>
      </ul>
      <%!-- 動かす場所を変えたとき、描き直さずに Chiezo に残っている収集へつなぎ直す --%>
      <div class="button-row">
        <button type="button" phx-click="restore">Chiezo から範囲を戻す</button>
        <span class="muted-note">
          Chiezo に残っている範囲の収集のうち、ここに無いものを読み戻します（Chiezo へは何も送りません）。
        </span>
      </div>
    </section>

    <%!-- **全範囲を 1 つの ZIP に**（travel-log では範囲によらず 1 つの種別に読み込む）。
         範囲ごとの ZIP は範囲の画面にある --%>
    <section :if={@areas != []} class="settings-block" aria-label="全範囲の書き出し">
      <h3>travel-log 用の ZIP</h3>
      <a
        id="download-dining-all"
        class="download-link"
        href={~p"/datasets/areas/travel-log.zip"}
        download
        phx-hook="DownloadLink"
        data-status="download-status-dining-all"
      >
        ⬇ 全範囲をまとめて書き出す
      </a>
      <span
        id="download-status-dining-all"
        class="download-status"
        role="status"
        phx-update="ignore"
      ></span>
      <p class="muted-note">
        全部の範囲の店を 1 つの ZIP にします（travel-log では範囲によらず「食事処」の 1 つの種別に読み込みます）。範囲が重なったところで同じ店が 2 つの範囲に居るときは、先に作った範囲のほうだけを入れ、もう片方は exclude.txt に回します。範囲の数だけ取り出すので、十数秒ずつかかります。
      </p>
    </section>

    <%!-- **travel-log からの依頼を、範囲ごとに配る**。依頼のテキストにはどの範囲の店かが
         書いていないので、1 件ずつ座標の入る範囲へ控える。頼むのは範囲の画面から --%>
    <section :if={@areas != []} class="settings-block" aria-label="travel-log からの依頼">
      <h3>travel-log からの依頼</h3>
      <form phx-submit="route_requests">
        <p>
          <label>
            travel-log の「修正・追加の依頼」のテキスト<br />
            <textarea
              name="text"
              rows="6"
              placeholder="- [修正] 店名 (35.68123,139.76712): 閉店している&#10;- [追加] (35.68000,139.76000): うどんの名店がある"
            ></textarea>
          </label>
        </p>
        <p class="muted-note">
          travel-log の管理画面の「渡すテキスト」をそのまま貼ってください。1 件ずつ、座標の入る範囲に控えます（範囲が重なっていれば狭いほう）。頼むのは範囲の画面（上の範囲の名前から開く）の「控えている依頼」から、区画ごとにどうぞ。「[位置確認]」「[位置修正]」の行は AI を使わないので、貼った時点でその範囲の収集に座標を固定させます。
        </p>
        <div class="button-row">
          <button type="submit" phx-disable-with="配っています…">範囲ごとに控える</button>
        </div>
      </form>
      <%= if @routed do %>
        <p :if={@routed.empty} class="muted-note" aria-live="polite">
          座標の入った依頼がありませんでした（「(緯度,経度)」の形の座標を含む行が要ります）。
        </p>
        <p :for={line <- routed_lines(@routed)} class="muted-note" aria-live="polite">{line}</p>
        <div :if={outside_lines(@routed) != []} class="muted-note" aria-live="polite">
          どの範囲にも入らなかったので控えていません（範囲を広げるか足してから、貼り直してください）:
          <ul>
            <li :for={line <- outside_lines(@routed)}>{line}</li>
          </ul>
        </div>
      <% end %>
      <p :for={line <- held_lines(@held)} class="muted-note" aria-live="polite">{line}</p>
      <%!-- 固定できた範囲ごとに、AI を使わずにいま反映する口（範囲の画面と同じもの） --%>
      <div :for={area <- held_areas(@held)} class="button-row">
        <button
          type="button"
          phx-click="apply_locks"
          phx-value-id={area.id}
          phx-disable-with="頼んでいます…"
        >
          {area.name}: AI を使わずにいま反映する
        </button>
        <span :if={@applied[area.id]} class="muted-note" aria-live="polite">
          {ChidoriWeb.DatasetsLive.applied_message(@applied[area.id])}
        </span>
      </div>
    </section>

    <section
      class="settings-block"
      aria-label={if @editing, do: "範囲を直す", else: "範囲を足す"}
    >
      <h3 :if={!@editing}>範囲を足す</h3>
      <h3 :if={@editing}>範囲「{@editing.name}」を直す</h3>
      <p :if={@editing} class="warn-note">
        四角を変えて保存すると、Chiezo の区画を新しい範囲で割り直し、機械収集から走らせ直します。前の範囲で見終わった区画の印は残り、広げたところだけをざっと見るが見に行きます。
        外した場所の店は、travel-log へは書き出さなくなります。
      </p>
      <p class="muted-note">
        地名で探して寄り（寄ると地理院の地図に切り替わります）、「四角を描く」を押してから地図の上をドラッグしてください。描いた四角は、四辺と四隅を引っ張って大きさを変えられます。数でも直せます。探した場所のまわりで手早く作ることもできます。
      </p>

      <div class="map-canvas area-canvas" id="area-canvas" phx-hook="AreaDraw">
        <%!-- **地理院タイル**（国土地理院の標準地図）を図の下に敷く。白地図だけでは駅や道が
             分からず、四角を決められない。置くのは台本（`area_draw.js`）で、寄ったときだけ
             出す。**参照元は送らない**（`referrerpolicy`。この画面のアドレスを外へ出さない） --%>
        <div id="area-tiles" class="tile-layer" phx-update="ignore" aria-hidden="true"></div>
        <div class="relation-find">
          <form
            id="area-search"
            class="relation-search"
            phx-submit="search_place"
            phx-change="search_place"
            autocomplete="off"
          >
            <input
              type="search"
              name="q"
              value={@query}
              placeholder="地名で探す"
              aria-label="地名で探す"
              phx-debounce="400"
            />
            <%= case @places do %>
              <% {:ok, [_ | _] = places} -> %>
                <ul class="relation-matches">
                  <li :for={{place, index} <- Enum.with_index(places)}>
                    <button type="button" phx-click="focus_place" phx-value-index={index}>
                      {place.name}
                      <span class="match-years">{ChidoriWeb.DatasetsLive.place_label(place)}</span>
                    </button>
                  </li>
                </ul>
              <% {:ok, []} -> %>
                <ul class="relation-matches">
                  <li class="muted-note">見つかりませんでした</li>
                </ul>
              <% :loading -> %>
                <ul class="relation-matches">
                  <li class="muted-note">探しています…</li>
                </ul>
              <% {:error, _reason} -> %>
                <ul class="relation-matches">
                  <li class="muted-note">地名を引けませんでした</li>
                </ul>
              <% _none -> %>
            <% end %>
          </form>
        </div>
        <div class="map-tools">
          <button type="button" data-zoom="draw" class="draw-toggle" aria-pressed="false">
            四角を描く
          </button>
          <button type="button" data-zoom="in" aria-label="拡大">＋</button>
          <button type="button" data-zoom="out" aria-label="縮小">−</button>
          <button type="button" data-zoom="reset" aria-label="全体を表示">全体</button>
        </div>
        <svg
          viewBox={"0 0 #{@map.width} #{@map.height}"}
          role="img"
          aria-label="範囲を描く地図"
          data-west={@map.frame.west}
          data-top={@map.frame.top}
          data-scale={@map.frame.scale}
        >
          <path :for={ring <- @map.coast} d={ring} class="coast" />

          <%!-- 作った範囲。**名前の札は倍率で割り戻して置く**（日本全体を見ているときは
               四角が点より小さくなるので、札が無いとどこに作ったのか分からない）。
               札を押すと、その範囲を直し始める。直している範囲は下の四角が代わりに出る --%>
          <% rects =
            for area <- @areas,
                !(@editing && @editing.id == area.id),
                do: {area, rect(@map, area)} %>
          <rect
            :for={{area, r} <- rects}
            x={r.x}
            y={r.y}
            width={r.width}
            height={r.height}
            class="area-rect"
          >
            <title>{area.name}</title>
          </rect>
          <g
            :for={{area, r} <- rects}
            class="area-label"
            data-pin
            data-area-label
            data-x={r.x + r.width / 2}
            data-y={r.y}
            transform={"translate(#{r.x + r.width / 2} #{r.y})"}
            phx-click="edit_area"
            phx-value-id={area.id}
          >
            <title>{area.name}（押すと直せます）</title>
            <path d="M0 0 C-4 -6 -7 -9.5 -7 -14 A7 7 0 1 1 7 -14 C7 -9.5 4 -6 0 0 Z" />
            <circle cx="0" cy="-14" r="2.6" />
            <text x="9" y="-11">{area.name}</text>
          </g>

          <%!-- いま決めている四角 --%>
          <% draft = draft_rect(@map, @draft) %>
          <rect
            :if={draft}
            x={draft.x}
            y={draft.y}
            width={draft.width}
            height={draft.height}
            class="draft-rect"
          />

          <g
            :if={@marker}
            class="find-pin"
            data-pin
            data-x={@marker.x}
            data-y={@marker.y}
            transform={"translate(#{@marker.x} #{@marker.y})"}
          >
            <title>{@marker.label}</title>
            <path d="M0 0 C-4 -6 -7 -9.5 -7 -14 A7 7 0 1 1 7 -14 C7 -9.5 4 -6 0 0 Z" />
            <circle cx="0" cy="-14" r="2.6" />
          </g>

          <%!-- 描いている最中の四角（台本が描く。LiveView に描き直させない） --%>
          <g id="area-draw-layer" phx-update="ignore"></g>
          <%!-- 決めた四角の取っ手（四辺と四隅）。引っ張ると大きさを変えられる。
               これも台本が置く（決めた四角に合わせて、倍率で割り戻した太さで描く） --%>
          <g id="area-handles" phx-update="ignore"></g>
        </svg>
      </div>
      <p class="muted-note map-hint">
        <span class="only-touch">指で動かし、2 本の指でつまんで拡大縮小。</span><span class="only-mouse">引きずって移動、Ctrl+ホイールで拡大縮小。</span>
        寄ったときの地図は<a
          href="https://maps.gsi.go.jp/development/ichiran.html"
          target="_blank"
          rel="noreferrer"
        >地理院タイル</a>（出典：国土地理院）。全体の白地図の海岸線は {Chidori.Geo.Japan.source()}。
      </p>
      <div :if={@marker} class="button-row">
        <button type="button" phx-click="around_marker">
          「{@marker.label}」のまわり 3 km ほどで四角を作る
        </button>
      </div>

      <form
        id="area-form"
        phx-change="edit"
        phx-submit={if @editing, do: "save", else: "create"}
        class="area-form"
      >
        <label>
          <span>名前</span>
          <input
            type="text"
            name="area[name]"
            value={@draft["name"]}
            maxlength="20"
            placeholder="東京駅"
          />
        </label>
        <div class="area-box">
          <label :for={
            {key, label} <- [{"north", "北"}, {"west", "西"}, {"east", "東"}, {"south", "南"}]
          }>
            <span>{label}</span>
            <input
              type="text"
              inputmode="decimal"
              name={"area[#{key}]"}
              value={@draft[key]}
              phx-debounce="600"
            />
          </label>
        </div>

        <div :if={@estimate} class="area-estimate" aria-live="polite">
          <%= case @estimate do %>
            <% :loading -> %>
              <p class="muted-note">数えています…</p>
            <% {:ok, estimate} -> %>
              <p>
                中にある飲食店: <strong>{estimate.total} 件</strong>（{Enum.map_join(
                  estimate.counts,
                  "・",
                  fn {source, count} -> "#{source_label(source)} #{count || "?"}" end
                )}。同じ店が 2 つの辞典に居れば 2 と数えるので、実際はこれより少なくなります）
              </p>
              <p>
                区画の見込み: <strong>{estimate.partitions} 区画</strong>（1 区画 {Chidori.Datasets.Dining.area_partition_target()} 件の目安）
              </p>
            <% {:error, _reason} -> %>
              <p class="muted-note">Chiezo から数えられませんでした。</p>
          <% end %>
        </div>

        <ul :if={@errors != []} class="area-errors">
          <li :for={line <- @errors}>{line}</li>
        </ul>
        <div class="button-row">
          <button :if={!@editing} type="submit" phx-disable-with="作っています…">この範囲を作る</button>
          <button :if={@editing} type="submit" phx-disable-with="直しています…">この範囲に直す</button>
          <button :if={@editing} type="button" phx-click="cancel_edit">直すのをやめる</button>
        </div>
      </form>
    </section>
  </div>
</main>
