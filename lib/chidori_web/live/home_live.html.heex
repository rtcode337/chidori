<Layouts.flash_group flash={@flash} />
<%!-- 頭のメニューとタブは main の外に置き、画面の上に残す（スクロールするのは main の中だけ。root.html.heex） --%>
<div class="relations-page page-head">
  <div>
    <ChidoriWeb.MainNav.main_nav active={:home} />

    <%!-- 大きなタブ（ニュース・イベント・関連図・データ収集）と、その中の枠。**中の枠はタブの形に
         しない** —— 2 段ともタブにすると、どちらが上の階層なのか読み取れない。中の枠は 1 行に並べ、
         収まらなければ横へ送る（折り返すと頭の帯が伸びる）。押すと大きなタブの最初の枠が開く --%>
    <% groups = Chidori.Home.grouped(@panels) %>
    <% current =
      @panel && Enum.find(groups, fn {group, _name, _members} -> group == @panel.group end) %>
    <nav
      :if={length(groups) > 1}
      id="home-tabs"
      class="relation-tabs"
      phx-hook="ScrollTabs"
      aria-label="トップページの大きなタブ"
    >
      <.link
        :for={{group, name, [first | _]} <- groups}
        patch={~p"/?panel=#{first.key}"}
        class={if @panel && @panel.group == group, do: "selected"}
        aria-current={if @panel && @panel.group == group, do: "page"}
      >
        {name}
      </.link>
    </nav>
    <nav
      :if={current && length(elem(current, 2)) > 1}
      id="home-subtabs"
      class="home-subtabs"
      phx-hook="ScrollTabs"
      aria-label={"#{elem(current, 1)}の中の枠"}
    >
      <.link
        :for={panel <- elem(current, 2)}
        patch={~p"/?panel=#{panel.key}"}
        class={if @panel.key == panel.key, do: "selected"}
        aria-current={if @panel.key == panel.key, do: "page"}
      >
        {panel.short}
      </.link>
    </nav>
  </div>
</div>

<main id="page-scroll" class="relations-page home-page" phx-hook="PageScroll">
  <div>
    <%!-- 枠の中を左右に払うと、隣のタブへ（`PanelSwipe`）。タブの列・表・関連図の中では払わない --%>
    <div id="home-panels" phx-hook="PanelSwipe">
      <%!-- 話題の要約と、興味トピックの要約。**全文を見せ、右上のアイコンで全画面に開く**
         （全画面では左右のスワイプで前後の要約へ。最新情報の画面と同じ部品） --%>
      <section
        :if={@panel && @panel.kind in [:topic, :interest]}
        class="home-panel"
        aria-label={@panel.name}
      >
        <% kind = digest_kind(@panel) %>
        <% digests = if @news, do: NewsLive.digests_of(@news, kind), else: [] %>
        <p :if={@news == nil or (@news.status == :loading and digests == [])} class="muted-note">
          読み込んでいます…
        </p>
        <%= if digest = List.first(digests) do %>
          <%!-- **全文をそのまま見せる**（押さなくても読める）。全画面は右上のアイコンから ——
             本文を押して開く形にすると、本文の中のリンクや目次を押す動きと取り合う --%>
          <div class="home-digest">
            <ChidoriWeb.FullscreenButton.fullscreen_button
              zoom={nil}
              class="home-digest-full"
              phx-click="open_digest"
              phx-value-index="0"
            />
            <ChidoriWeb.Report.report
              title={digest.title}
              at={digest.collected_at}
              body={digest.summary}
              label={if kind == :interest, do: "興味トピック", else: @panel.name}
              articles={@news.articles}
              cited={digest.cited}
              id_prefix="home"
              hero={NewsLive.hero?(@panel.topic)}
              open_work_event={Chidori.Topics.works(@panel.topic) && "open_work"}
            />
          </div>
        <% else %>
          <p :if={(@news && @news.status != :loading) and kind == :main} class="muted-note">
            まだ要約がありません（{@panel.name}の画面で、要約を作る時刻を決めると溜まっていきます）。
          </p>
          <p :if={(@news && @news.status != :loading) and kind == :interest} class="muted-note">
            まだ興味トピックの要約がありません（{@panel.topic.name}の画面で、トピックの網の札から興味トピックを選ぶと書かれるようになります）。
          </p>
        <% end %>
        <%!-- 公開中（放送中）の注目作。**要約の下に**（要約は 1 日 1 本で、いま観られる作品の
           顔ぶれは見渡せない）。押すと詳細が開く（最新情報の画面の注目作と同じ） --%>
        <% group = if kind == :main, do: started_works(@works, @panel.topic) %>
        <%= if group do %>
          <% {label, list} = group %>
          <%!-- 既定は畳む（数十本あり、開いたままだと下の見た作品まで遠い）。見出しを押すと開く --%>
          <details id="home-works-started" class="event-day-list home-works works-group">
            <summary>
              <h2 class="news-section-title">{label}の注目作（{length(list)} 本）</h2>
            </summary>
            <ul>
              <li
                :for={entry <- list}
                class={["event-item", "is-#{entry.attention}", "is-work"]}
                phx-click="open_work"
                phx-value-title={entry.title}
                role="button"
                tabindex="0"
              >
                <img
                  :if={NewsLive.entry_thumb(entry)}
                  class="event-thumb"
                  src={NewsLive.entry_thumb(entry)}
                  alt=""
                  loading="lazy"
                />
                <div class="event-item-head">
                  <span :if={entry.attention} class={["event-chip", "is-#{entry.attention}"]}>
                    注目度 {NewsLive.attention_label(entry.attention)}
                  </span>
                  <strong>{entry.title}</strong>
                  <%!-- 見た作品は見出しの横に印（最新情報の画面の注目作と同じ） --%>
                  <span :if={NewsLive.seen_work?(@work_marks, entry.title)} class="seen-badge">見た</span>
                </div>
                <p class="event-item-facts">
                  {NewsLive.work_facts(entry, Chidori.Topics.works(@panel.topic))}
                </p>
              </li>
            </ul>
          </details>
        <% end %>
        <%!-- 見た作品（見た記録の付いたもの。見た日の新しい順）。これも既定は畳む。
           注目作から外れた古い作品も並ぶ（押すと詳細が開き、記録を読み書きできる） --%>
        <% seen = if kind == :main, do: seen_works(@work_marks), else: [] %>
        <details
          :if={seen != []}
          id="home-works-seen"
          class="event-day-list home-works works-group"
        >
          <summary>
            <h2 class="news-section-title">{seen_label(@panel.topic)}（{length(seen)} 本）</h2>
          </summary>
          <ul>
            <li
              :for={mark <- seen}
              class={["event-item", "is-work"]}
              phx-click="open_work"
              phx-value-title={mark.node_name}
              role="button"
              tabindex="0"
            >
              <div class="event-item-head">
                <strong>{mark.node_name}</strong>
                <span class="seen-badge">{NewsLive.mark_summary(mark)}</span>
              </div>
              <p :if={mark.note not in [nil, ""]} class="event-item-facts">{mark.note}</p>
            </li>
          </ul>
        </details>
        <p><a href={~p"/news?view=#{@panel.topic.collection}"}>{@panel.topic.name}の画面へ</a></p>
      </section>

      <%!-- 書き手ごとの要約（市況ニュース。売買提案の AI がそれぞれ自分で書いたもの） --%>
      <section
        :if={@panel && @panel.kind == :ai_digests}
        class="home-panel"
        aria-label={@panel.name}
      >
        <ChidoriWeb.AiDigests.ai_digests
          digests={@ai_digests}
          label={@panel.name}
          id_prefix="home-ai"
        />
        <p><a href={~p"/news?view=#{@panel.topic.collection}"}>{@panel.topic.name}の画面へ</a></p>
      </section>

      <%!-- 関連図は画面ごと埋め込む（操作も同じ。頭のメニューと設定は出さない） --%>
      <section
        :if={@panel && @panel.kind == :relations}
        class="home-panel"
        aria-label={@panel.name}
      >
        <%!-- **高さは中身に合わせる**（`AutoHeight`）。決め打ちにすると枠の中にもう 1 つ
           スクロールができて、ページのスクロールと二重になる --%>
        <iframe
          id={"home-embed-#{@panel.view}"}
          phx-hook="AutoHeight"
          scrolling="no"
          allowfullscreen
          allow="fullscreen"
          class="home-embed"
          src={~p"/relations?view=#{@panel.view}&embed=1"}
          title={@panel.name}
          loading="lazy"
        ></iframe>
        <p><a href={~p"/relations?view=#{@panel.view}"}>関連図の画面へ</a></p>
      </section>

      <section :if={@panel && @panel.kind == :events} class="home-panel" aria-label={@panel.name}>
        <h2 class="news-section-title">これからの注目イベント</h2>
        <p :if={@events in [nil, :loading]} class="muted-note">読み込んでいます…</p>
        <p :if={match?({:error, _}, @events)} class="muted-note">イベントを読めませんでした。</p>
        <%= if match?({:ok, _}, @events) do %>
          <% list = upcoming(elem(@events, 1), Chidori.Topics.home_attention(@panel.topic)) %>
          <p :if={list == []} class="muted-note">これから 2 か月の、注目度の高いイベントはまだありません。</p>
          <ul :if={list != []} class="event-day-list home-events">
            <li :for={entry <- list} class={["event-item", "is-#{entry.attention}"]}>
              <img
                :if={ChidoriWeb.NewsLive.entry_thumb(entry)}
                class="event-thumb"
                src={ChidoriWeb.NewsLive.entry_thumb(entry)}
                alt=""
                loading="lazy"
              />
              <div class="event-item-head">
                <span class={["event-chip", "is-#{entry.attention}"]}>
                  {ChidoriWeb.NewsLive.day_label(entry.date)}
                </span>
                <a :if={entry.url} href={SafeUrl.href(entry.url)} target="_blank" rel="noreferrer">{entry.title}</a>
                <strong :if={!entry.url}>{entry.title}</strong>
              </div>
              <p class="event-item-facts">
                <span :if={Chidori.News.Events.abroad?(entry)} class="event-abroad-mark">海外</span>
                {ChidoriWeb.NewsLive.event_facts(entry)}
              </p>
              <p :if={Chidori.News.Events.description(entry) != ""} class="event-item-detail">
                {Chidori.News.Events.description(entry)}
              </p>
            </li>
          </ul>
        <% end %>
        <p><a href={~p"/news?view=#{@panel.topic.collection}"}>{@panel.name}の画面へ</a></p>
      </section>

      <%!-- レシピ集（データ収集の画面と同じ部品。名簿の設定はデータ収集の画面だけ） --%>
      <section :if={@panel && @panel.kind == :recipes} class="home-panel" aria-label={@panel.name}>
        <p :if={@recipes in [nil, :loading]} class="muted-note">読み込んでいます…</p>
        <p :if={match?({:error, _}, @recipes)} class="muted-note">レシピ集を読めませんでした。</p>
        <ChidoriWeb.RecipeBook.book
          :if={match?({:ok, _}, @recipes)}
          recipes={elem(@recipes, 1)}
          filter={@recipe_filter}
          opened={@recipe_open}
          roster={false}
        />
        <p><a href={~p"/datasets?view=recipes"}>レシピ集の画面へ</a></p>
      </section>

      <section :if={@panel && @panel.kind == :books} class="home-panel" aria-label={@panel.name}>
        <p :if={@books in [nil, :loading]} class="muted-note">読み込んでいます…</p>
        <p :if={match?({:error, _}, @books)} class="muted-note">本棚を読めませんでした。</p>
        <%= if match?({:ok, _}, @books) do %>
          <h2 class="news-section-title">
            オライリー以外の未読の上位 {ChidoriWeb.TopBooks.count()} 冊
          </h2>
          <ChidoriWeb.TopBooks.top_books
            books={elem(@books, 1)}
            read={ChidoriWeb.BookModal.read_titles(@book_marks)}
            open_event="open_book"
          />
          <%!-- **オライリーの本は別の枠に**（Kindle で読めないので、上の順位とは分けて数える） --%>
          <h2 class="news-section-title">オライリーの未読の上位 {ChidoriWeb.TopBooks.count()} 冊</h2>
          <ChidoriWeb.TopBooks.top_books
            books={elem(@books, 1)}
            read={ChidoriWeb.BookModal.read_titles(@book_marks)}
            oreilly
            open_event="open_book"
          />
        <% end %>

        <p :if={match?({:ok, _}, @books)}><a href={~p"/datasets?view=books"}>本棚をぜんぶ見る</a></p>
        <%!-- 本の詳細（技術書の画面と同じもの）。読んだ記録はここで付ける --%>
        <% book = opened_book(assigns) %>
        <ChidoriWeb.BookModal.book_modal
          :if={book}
          book={book}
          mark={ChidoriWeb.BookModal.mark_of(@book_marks, book.title)}
          saved={@book_mark_saved == book.title}
          posts={@book_posts}
        />
      </section>
    </div>

    <%!-- 全画面の要約（左右のスワイプで前後の要約へ） --%>
    <NewsLive.digest_viewer
      :if={@news && @panel && @panel.kind in [:topic, :interest]}
      news={@news}
      open={@digest_open}
      full={@digest_full}
      kind={digest_kind(@panel)}
      section={@digest_section}
      label={if @panel.kind == :interest, do: "興味トピック", else: @panel.name}
      hero={NewsLive.hero?(@panel.topic)}
      open_work_event={Chidori.Topics.works(@panel.topic) && "open_work"}
      keys={@opened_work == nil}
    />

    <%!-- 要約が紹介した作品の詳細（映画・アニメ）。全画面の要約より手前に出る --%>
    <ChidoriWeb.WorkModal.work_modal
      opened={@opened_work}
      marks={@work_marks}
      saved={@work_mark_saved}
      showtime={ChidoriWeb.ShowtimeAsk.for_modal(assigns)}
    />
  </div>
</main>
