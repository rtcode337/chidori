<Layouts.flash_group flash={@flash} />
<%!-- 頭のメニューとタブは main の外に置き、画面の上に残す（スクロールするのは main の中だけ。root.html.heex） --%>
<div class="relations-page page-head">
  <div>
    <ChidoriWeb.MainNav.main_nav active={
      if @live_action == :collect, do: :collect, else: :settings
    } />
    <ChidoriWeb.CollectTabs.collect_tabs :if={@live_action == :collect} current={:list} />

    <nav
      :if={@live_action != :collect}
      id="settings-tabs"
      class="relation-tabs"
      phx-hook="ScrollTabs"
      aria-label="設定"
    >
      <.link
        :for={{key, label} <- @tabs}
        patch={~p"/settings?tab=#{key}"}
        class={if @tab == key, do: "selected"}
        aria-current={if @tab == key, do: "page"}
      >
        {label}
      </.link>
    </nav>
  </div>
</div>

<main id="page-scroll" class="relations-page settings-page" phx-hook="PageScroll">
  <div>
    <%!-- 写真と表紙の取得。**Chidori の列と Chiezo の具合を並べる** —— 頼みが Chidori の列で
         待っているのか、休んでいるのか、Chiezo へ届いて断られているのかを 1 か所で読むため --%>
    <section :if={@tab == "photos"} class="settings-panel" aria-label="写真と表紙">
      <section class="relations-intro">
        <p>SETTINGS</p>
        <h1>写真と表紙</h1>
        <p>
          関連図の顔写真・レシピの写真・技術書の表紙は、Chidori が 1 枚ずつ Chiezo に頼み、Chiezo が外から取って縮めたものを写して配っています。ここでは、頼みの列の様子と、Chiezo で何が起きているかを並べます（開いたときに読むだけで、自動では読み直しません）。
        </p>
      </section>
      <p class="relation-checked">
        <button type="button" phx-click="reload_photos">最新の情報を取得</button>
      </p>

      <h2>Chidori の頼みの列</h2>
      <p :if={@photo_status == nil} class="muted-note">頼みの列が動いていません。</p>
      <%= if @photo_status do %>
        <p :if={@photo_status.paused_until} class="stale">
          ⚠️ Chiezo が取りに行けなかったので、{Chidori.Jst.format(@photo_status.paused_until)} まで頼みません（その間は列にも並べません）。
        </p>
        <p>
          待っているもの: 写真 {@photo_status.waiting.photo} 枚・表紙 {@photo_status.waiting.cover} 冊
          <span class="muted-note">（写真は 1 分に 1 枚、表紙は 5 秒に 1 冊）</span>
        </p>
      <% end %>
      <p :if={@photo_counts}>
        持っている写し: 写真 {@photo_counts.photo["ok"] || 0} 枚（無かった {@photo_counts.photo["missing"] || 0}）・表紙 {@photo_counts.cover[
          "ok"
        ] || 0} 冊（無かった {@photo_counts.cover["missing"] || 0}）
      </p>
      <%= if @photo_status && @photo_status.recent != [] do %>
        <h3>直近の結果（Chidori）</h3>
        <table class="collect-overview">
          <thead>
            <tr>
              <th>時刻</th><th>種類</th><th>対象</th><th>結果</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={entry <- @photo_status.recent}>
              <td>{Chidori.Jst.format(entry.at)}</td>
              <td>{if entry.kind == :cover, do: "表紙", else: "写真"}</td>
              <td>{photo_target(entry.key)}</td>
              <td class={entry.result == :retry && "stale"}>{photo_result(entry.result)}</td>
            </tr>
          </tbody>
        </table>
      <% end %>

      <h2>Chiezo での取得</h2>
      <p :if={@chiezo_thumbs in [nil, :loading]} class="muted-note">読み込んでいます…</p>
      <p :if={match?({:error, _}, @chiezo_thumbs)} class="muted-note">
        Chiezo から読めませんでした（外の絵の具合を返す口を持たない版かもしれません）。
      </p>
      <%= if match?({:ok, _}, @chiezo_thumbs) do %>
        <% {:ok, health} = @chiezo_thumbs %>
        <p class={health["failing_now"] && "stale"}>
          最後に取れたのは {Chidori.Jst.format(health["last_ok_at"]) || "まだ無し"}<span :if={
            (health["failing"] || 0) > 0
          }>・続けて {health["failing"]} 回取れていません（最後は「{health["last_reason"]}」）</span>
        </p>
        <p :for={{host, until} <- resting_now(health)} class="stale">
          ⚠️ {host} に断られたので、{Chidori.Jst.format(until)} まで頼みません（Chiezo が休んでいます）。
        </p>
        <h3 :if={(health["recent"] || []) != []}>直近の依頼（Chiezo）</h3>
        <table :if={(health["recent"] || []) != []} class="collect-overview">
          <thead>
            <tr>
              <th>時刻</th><th>誰の頼み</th><th>絵</th><th>結果</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={entry <- health["recent"]}>
              <td>{Chidori.Jst.format(entry["at"])}</td>
              <td>{entry["caller"]}</td>
              <td title={entry["target"]}>{chiezo_target(entry["target"])}</td>
              <td class={!entry["ok"] && "stale"}>{entry["result"]}</td>
            </tr>
          </tbody>
        </table>
      <% end %>
    </section>

    <%!-- Chiezo 収集。**待ち行列が溜まってきたときに見る表** —— 巡回の間隔だけでは、
         ワーカーが何分おきに何本流すのかが読めないので、両方を並べる --%>
    <section :if={@tab == "chiezo"} class="settings-panel" aria-label="収集">
      <section class="relations-intro">
        <p>COLLECT</p>
        <h1>収集</h1>
        <p>
          Chidori が Chiezo に頼んでいる収集と、その回り方です。設定そのものは Chiezo にあり、開くたびに読み直します。
          収集ごとの細かい設定・区画・1 回だけ頼む口は、各収集の「収集の画面を開く」から。
        </p>
      </section>

      <%!-- ほかの画面と同じ「最後に取得」の行。**開いたときに 1 回読むだけで、自動では
           読み直さない**（いつのものを見ているかを出して、取り直すかは読む人が決める） --%>
      <p class="relation-checked">
        <span class="muted-note">
          <%= if @checked_at do %>
            最後に取得:
            <strong>{Chidori.Jst.format(@checked_at)}（{Chidori.Jst.ago(@checked_at)}）</strong>
          <% else %>
            まだ取得していません
          <% end %>
        </span>
        <button
          type="button"
          phx-click="reload"
          disabled={@reloading}
          aria-busy={if @reloading, do: "true"}
          class={if @reloading, do: "is-loading"}
        >
          {if @reloading, do: "取得しています…", else: "最新の情報を取得"}
        </button>
      </p>

      <p :if={@overview in [nil, :loading]} class="muted-note">読み込んでいます…</p>
      <p :if={match?({:error, _}, @overview)} class="muted-note">{error_text(@overview)}</p>

      <%= if match?({:ok, _}, @overview) do %>
        <% {:ok, overview} = @overview %>

        <section class="settings-block">
          <h3>ワーカー</h3>
          <p :if={overview.queue_error} class="muted-note">
            {queue_error_text(overview.queue_error)}
          </p>
          <p class="muted-note">
            巡回は、ワーカーの待ち行列に積まれ、ワーカーが起きたときに 1 回に決まった数ずつ流します。次に起きるのは、前の塊を流し終えてから間隔が空いたとき。
          </p>
          <table :if={overview.workers != []} class="collect-overview">
            <thead>
              <tr>
                <th>ワーカー</th>
                <th>起きる間隔</th>
                <th>1 回に流す数</th>
                <th>次に起きる（JST）</th>
                <th>流している / 待っている</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <tr :for={worker <- overview.workers}>
                <td>
                  {worker.name}<span :if={worker.paused} class="muted-note">（止めています）</span>
                </td>
                <td>{worker.every}</td>
                <td>{worker.per_run}</td>
                <td>
                  {cond do
                    worker.flowing != [] -> "流し終えてから"
                    true -> at(worker.next_at)
                  end}
                </td>
                <td>
                  <span :if={worker.flowing == [] and worker.queued == []}>なし</span>
                  <ul :if={worker.flowing != [] or worker.queued != []} class="queue-list">
                    <li :for={entry <- worker.flowing}>
                      <strong>流している</strong> {entry["collection"]} / {entry["sweep"]}
                    </li>
                    <li :for={entry <- worker.queued}>
                      待ち {entry["collection"]} / {entry["sweep"]}
                      <span class="muted-note">（{at(entry["at"])} から）</span>
                    </li>
                  </ul>
                </td>
                <%!-- **止める・動かす・今すぐ起こす**（Chiezo の管理画面と同じ。作る・直すは Chiezo で） --%>
                <td :if={worker.id} class="worker-ops">
                  <button
                    type="button"
                    phx-click="worker"
                    phx-value-id={worker.id}
                    phx-value-op={if worker.paused, do: "resume", else: "pause"}
                  >
                    {if worker.paused, do: "動かす", else: "止める"}
                  </button>
                  <button
                    :if={!worker.paused and worker.queued != []}
                    type="button"
                    phx-click="worker"
                    phx-value-id={worker.id}
                    phx-value-op="wake"
                  >
                    今すぐ起こす
                  </button>
                  <p :if={@worker_sent[worker.id]} class="muted-note" aria-live="polite">
                    {@worker_sent[worker.id]}
                  </p>
                </td>
                <td :if={!worker.id}></td>
              </tr>
            </tbody>
          </table>
          <p :if={overview.workers == [] and !overview.queue_error} class="muted-note">
            ワーカーはありません。
          </p>
        </section>

        <section :if={overview.waiting != []} class="settings-block">
          <h3>取り込みの待ち行列（{length(overview.waiting)} 本）</h3>
          <ol class="queue-list">
            <li :for={entry <- overview.waiting}>
              {entry["collection"]} / {entry["sweep"]}
              <span class="muted-note">（{at(entry["at"])} から）</span>
            </li>
          </ol>
        </section>

        <section class="settings-block">
          <h3>収集（{length(overview.collections)} 本）</h3>
          <p class="muted-note">
            Chidori の画面の並びで、各画面が Chiezo に送る収集を並べます（Chiezo にまだ送っていないものも出ます）。巡回ごとに頼む相手を選び、収集ごとの「Chiezo に送る」で送ります。送るのは各画面の「収集の設定を更新」と同じもので、Chidori の今の依頼文も一緒に届きます。整理の「自動で回さない」にチェックを入れて送ると、整理だけが自動では回らなくなります（巡回は消さないので、割り込みや travel-log からの依頼では今までどおり走ります）。これは Chidori も覚えていて、収集の設定を送り直すたびに載せ直します。
          </p>
          <% {plain, hands} = by_kind(overview.backends) %>
          <table class="collect-overview">
            <thead>
              <tr>
                <th>収集</th>
                <th>巡回</th>
                <th>間隔</th>
                <th>相手</th>
                <th>前回（JST）</th>
                <th>次回（JST）</th>
              </tr>
            </thead>
            <%!-- **収集ごとに 1 つのフォーム。** 表の行をフォームで囲めないので、欄は
                 `form` 属性でそのフォームにつなぐ --%>
            <%!-- **止まっている収集は塊ごと色を付ける**（「止まっています」の一言だけでは並びに埋もれる） --%>
            <tbody
              :for={collection <- overview.collections}
              class={(collection.in_chiezo and !collection.enabled) && "is-stopped"}
            >
              <% form_id = "send-#{collection.name}" %>
              <tr :for={{sweep, index} <- Enum.with_index(collection.sweeps)}>
                <td :if={index == 0} rowspan={max(length(collection.sweeps), 1)}>
                  <strong>{collection.label}</strong>
                  <br /><span class="muted-note">{collection.name}</span>
                  <br :if={collection.screen} /><a
                    :if={collection.screen}
                    href={collection.screen}
                    class="muted-note"
                  >収集の画面を開く</a>
                  <br :if={!collection.in_chiezo} /><span
                    :if={!collection.in_chiezo}
                    class="muted-note"
                  >Chiezo にまだありません（送ると、止まった状態で作られます）</span>
                  <br :if={collection.in_chiezo and !collection.enabled} /><span
                    :if={collection.in_chiezo and !collection.enabled}
                    class="stopped-mark"
                  >止まっています</span>
                  <%!-- **止める・動かす**（Chiezo の `POST /v1/collect/{name}/enabled`）。動かすのは
                       Chiezo の管理画面で外部からの有効化を許可したときだけ通る。Chidori の画面に無い収集
                       （Chidori が依頼していない収集）には出さない --%>
                  <button
                    :if={collection.in_chiezo and collection.push}
                    type="button"
                    class="collection-switch"
                    phx-click="switch_collection"
                    phx-value-collection={collection.name}
                    phx-value-enabled={to_string(!collection.enabled)}
                    data-confirm={
                      !collection.enabled &&
                        "#{collection.label} を動かします。Chiezo の時計で AI が回り始めます。よろしいですか？"
                    }
                  >
                    {if collection.enabled, do: "止める", else: "動かす"}
                  </button>
                  <br :if={!collection.push} /><span
                    :if={!collection.push}
                    class="muted-note"
                  >Chidori の画面に無い収集です（相手と整理だけを送ります）</span>
                  <%!-- **Chidori の定義と違うところ**（直した依頼文や設定がまだ届いていない）。
                       「Chiezo に送る」で揃う --%>
                  <details :if={collection[:drift] not in [nil, []]} class="collect-drift">
                    <summary>Chidori の定義と違います（{length(collection.drift)} 項目）</summary>
                    <ul>
                      <li :for={item <- collection.drift}>{item}</li>
                    </ul>
                    <p class="muted-note">
                      「Chiezo に送る」で Chidori の今の定義に揃います（Chiezo の管理画面で直したものも上書きされます）。
                    </p>
                  </details>
                  <%!-- **Chiezo の管理画面のボタンと同じ操作**（Chiezo の REST。取り消せない操作 ——
                       削除・世代を戻す・名前を変える —— は Chiezo の管理画面だけ） --%>
                  <details :if={collection.in_chiezo} class="collect-ops">
                    <summary>ほかの操作</summary>
                    <ul>
                      <li :if={collection[:redo_sweep]}>
                        <button
                          type="button"
                          phx-click="operate"
                          phx-value-collection={collection.name}
                          phx-value-op="redo"
                          data-confirm={"#{collection.label} の最後の 1 回（#{collection[:redo_sweep]}）を巻き戻して、もう一度走らせます。AI を 1 回使います。よろしいですか？"}
                        >
                          最後の 1 回をやり直す
                        </button>
                        <span class="muted-note">
                          進み具合と区画の印だけを戻して走り直します（焼いた中身と消したものは戻しません）。
                        </span>
                      </li>
                      <%!-- Chidori の時計が起こす行（`virtual`）は Chiezo の巡回ではないので出さない --%>
                      <li
                        :for={sweep <- Enum.reject(collection.sweeps, & &1[:virtual])}
                        :if={(collection[:partitions] || 0) > 0}
                      >
                        <button
                          type="button"
                          phx-click="operate"
                          phx-value-collection={collection.name}
                          phx-value-op="restart"
                          phx-value-sweep={sweep.name}
                          data-confirm={"「#{sweep.name}」の区画の印を全部外します。よろしいですか？"}
                        >
                          「{sweep.name}」の一周をやり直す
                        </button>
                      </li>
                      <li :if={(collection[:partitions] || 0) > 0}>
                        <button
                          type="button"
                          phx-click="operate"
                          phx-value-collection={collection.name}
                          phx-value-op="repartition"
                        >
                          区画を割り直す
                        </button>
                        <span class="muted-note">AI も焼きも動かしません（いま {collection[:partitions]} 区画）。</span>
                      </li>
                      <li>
                        <button
                          type="button"
                          phx-click="operate"
                          phx-value-collection={collection.name}
                          phx-value-op="requeue"
                          disabled={collection[:requeue_at] != nil}
                        >
                          全部を未確認に戻す
                        </button>
                        <span :if={collection[:requeue_at]} class="muted-note">
                          頼んであります（次に焼く回で効きます）。
                        </span>
                      </li>
                      <li>
                        <button
                          type="button"
                          phx-click="operate"
                          phx-value-collection={collection.name}
                          phx-value-op="stop"
                        >
                          走っている取り込みを止める
                        </button>
                      </li>
                    </ul>
                    <%!-- **検索文の控え**（検索文を考えさせる巡回を持つ収集だけ。開いたときだけ読む） --%>
                    <div :if={collection[:thinks_queries]} class="collect-queries">
                      <% queries = @queries[collection.name] %>
                      <button
                        :if={queries == nil}
                        type="button"
                        phx-click="load_queries"
                        phx-value-collection={collection.name}
                      >
                        検索文の控えを見る
                      </button>
                      <p :if={queries == :loading} class="muted-note">読んでいます…</p>
                      <p :if={match?({:error, _}, queries)} class="muted-note">
                        {reason_text(elem(queries, 1))}
                      </p>
                      <%= if match?({:ok, _}, queries) do %>
                        <p :if={elem(queries, 1) == []} class="muted-note">
                          まだ 1 回も引いていません。
                        </p>
                        <table :if={elem(queries, 1) != []} class="collect-overview">
                          <thead>
                            <tr>
                              <th>検索文</th>
                              <th>使った（JST）</th>
                              <th>入った / 残った</th>
                              <th></th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr :for={row <- elem(queries, 1)}>
                              <td>{row["query"]}</td>
                              <td>{at(row["used_at"])}</td>
                              <td>{row["found"] || "—"} / {row["kept"] || "—"}</td>
                              <td>
                                <button
                                  type="button"
                                  phx-click="forget_query"
                                  phx-value-collection={collection.name}
                                  phx-value-query={row["query"]}
                                >
                                  消す
                                </button>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                        <button
                          :if={elem(queries, 1) != []}
                          type="button"
                          phx-click="forget_query"
                          phx-value-collection={collection.name}
                          phx-value-query=""
                          data-confirm="検索文の控えを全部消します（次の回は最初の組から始まります）。よろしいですか？"
                        >
                          全部消す
                        </button>
                      <% end %>
                    </div>
                  </details>
                  <form
                    id={form_id}
                    class="collection-send"
                    phx-change="pick"
                    phx-submit="send_collection"
                  >
                    <input type="hidden" name="collection" value={collection.name} />
                    <button type="submit" phx-disable-with="送っています…">Chiezo に送る</button>
                  </form>
                  <p :if={@sent[collection.name]} class="muted-note" aria-live="polite">
                    {@sent[collection.name]}
                  </p>
                </td>
                <td>
                  {sweep.name}<span
                    :if={!sweep.enabled and !sweep.by_caller}
                    class="muted-note"
                  >（止めています）</span>
                  <%!-- **整理だけは、ここで自動で回すかを決められる**（AI の枠の節約）。
                       時計を外すだけなので、割り込みや依頼の行き先としては走る --%>
                  <label :if={tidy_sweep?(sweep)} class="tidy-toggle">
                    <input type="hidden" name="tidy" value="false" form={form_id} />
                    <input
                      type="checkbox"
                      name="tidy"
                      value="true"
                      form={form_id}
                      checked={picked_tidy(@picks, collection.name, sweep)}
                    /> 自動で回さない
                  </label>
                </td>
                <td>
                  {sweep.clock}
                  <%!-- **Chidori が起こす回は、ここで時刻を直せる**（要約の回は各話題の画面と
                       同じ値）。Chiezo には送らない —— 時計を持つのは chidori --%>
                  <form
                    :if={sweep[:wake]}
                    id={"wake-#{collection.name}-#{index}"}
                    class="wake-form"
                    phx-submit="save_wake"
                  >
                    <input type="hidden" name="collection" value={collection.name} />
                    <input type="hidden" name="kind" value={elem(sweep.wake, 0)} />
                    <input
                      type="text"
                      name="times"
                      value={elem(sweep.wake, 1)}
                      placeholder="07:00,19:00"
                      aria-label={"#{collection.label}の#{sweep.name}を起こす時刻"}
                    />
                    <%!-- 引き継ぎは 1 回に頼む数も決める（AI が 1 回で返し切れる数に抑える） --%>
                    <select
                      :if={elem(sweep.wake, 0) == :carry}
                      name="batch"
                      aria-label="1 回に頼む数"
                    >
                      <option
                        :for={n <- Chidori.Relations.CarrySetting.batch_choices()}
                        value={n}
                        selected={n == elem(sweep.wake, 2)}
                      >
                        1 回 {n} 本まで
                      </option>
                    </select>
                    <button type="submit" phx-disable-with="保存しています…">時刻を保存</button>
                  </form>
                </td>
                <td class="pick">
                  <span :if={sweep[:virtual]} class="muted-note">{sweep.virtual}</span>
                  <span :if={sweep.mechanical} class="muted-note">AI を使いません</span>
                  <%= if !sweep.mechanical and !sweep[:virtual] do %>
                    <% backend = picked_backend(@picks, collection.name, sweep) %>
                    <% models = models_for(overview.backends, backend) %>
                    <select name={"sweep|#{sweep.name}|backend"} form={form_id}>
                      <option value="">Chiezo の既定にまかせる</option>
                      <option :for={b <- plain} value={b.id} selected={b.id == backend}>
                        {b.label}
                      </option>
                      <optgroup
                        :if={hands != []}
                        label="ワーカー（枠を見て振り替える）"
                      >
                        <option :for={b <- hands} value={b.id} selected={b.id == backend}>
                          {b.label}
                        </option>
                      </optgroup>
                    </select>
                    <select :if={models != []} name={"sweep|#{sweep.name}|model"} form={form_id}>
                      <option value="">モデルは相手の既定</option>
                      <option
                        :for={m <- models}
                        value={m}
                        selected={m == picked_model(@picks, collection.name, sweep)}
                      >
                        {m}
                      </option>
                    </select>
                  <% end %>
                </td>
                <td>
                  {at(sweep.last_run_at)}<span
                    :if={sweep.last_status && sweep.last_status != "ok"}
                    class="muted-note"
                  >{if sweep.last_status == "error", do: "失敗", else: sweep.last_status}</span>
                </td>
                <td>
                  {at(sweep.next_run_at)}<br :if={sweep.blocked} /><span
                    :if={sweep.blocked}
                    class="muted-note"
                  >{sweep.blocked}</span>
                </td>
              </tr>
            </tbody>
          </table>
        </section>
      <% end %>

      <%!-- **一番下に置く**（めったに触らない。収集の表を先に読む） --%>
      <%!-- 巡回の間隔。**枠の減り方と回復の速さを釣り合わせるつまみ**。保存すると
           Chiezo にも送る（間隔だけ。相手や依頼文には触らない） --%>
      <section class="settings-block">
        <h3>巡回の間隔</h3>
        <p class="muted-note">
          どの収集にも共通の速さです。AI の枠が回復より速く減るときは延ばしてください。区画を回る巡回（関連図・食事処）は、一周の日数も同じ比で伸ばして、1 回に見る量を変えません。整理を延ばすと、AI が目を通すまで画面に出ないニュース類は、そのぶん遅れて出ます。
        </p>
        <form id="collect-pace" phx-submit="save_pace" class="pace-form">
          <%!-- **ざっと見るを先に**（回る順。ざっと見るが一周してから整理が回る） --%>
          <label :for={kind <- pace_kinds()}>
            <span>
              {CollectPace.sweep_name(kind)}
              <span :if={pace_count(@overview, kind)} class="muted-note">
                {pace_count(@overview, kind)}
              </span>
            </span>
            <select name={"pace[#{kind}]"}>
              <option
                :for={minutes <- CollectPace.choices(kind)}
                value={minutes}
                selected={minutes == CollectPace.minutes(kind)}
              >
                {CollectPace.label(minutes)}ごと{if minutes == CollectPace.default(kind),
                  do: "（既定）",
                  else: ""}
              </option>
            </select>
          </label>
          <button type="submit" phx-disable-with="送っています…">保存して Chiezo に送る</button>
        </form>
        <p :if={@pace_message} class="muted-note" aria-live="polite">{@pace_message}</p>
      </section>

      <%!-- 動かす場所を変えたとき・DB を作り直したときに、Chiezo に残っている設定から戻す
           （`Chidori.SettingsRestore`。Chiezo へは何も送らない） --%>
      <section class="settings-block">
        <h3>Chiezo から設定を戻す</h3>
        <p class="muted-note">
          巡回の間隔・整理を自動で回さない収集・芸能人の図の知名度の下限を、Chiezo の収集に残っている設定に合わせます。Chiezo へは何も送りません。食事処の範囲は範囲の画面から戻します。
        </p>
        <div class="button-row">
          <button
            type="button"
            phx-click="restore_settings"
            phx-disable-with="読んでいます…"
          >
            Chiezo から戻す
          </button>
        </div>
        <p :if={@restore_message} class="muted-note" aria-live="polite">{@restore_message}</p>
      </section>
    </section>

    <%!-- トップページに並べる枠。**選んだ枠がタブになり、最初の枠が開いたときに出る** --%>
    <%!-- 通知。**宛先は全部の通知で 1 つ** —— 話題ごとに書いていた頃は、同じトピックを
         画面ごとに書き写していた。話題ごとに決めるのは知らせるかどうかだけ（各画面） --%>
    <section :if={@tab == "notify"} class="settings-panel" aria-label="通知">
      <section class="relations-intro">
        <p>SETTINGS</p>
        <h1>通知</h1>
        <p>
          要約ができたときの知らせ先です。ntfy と、通知を受け取るように登録した端末の両方へ送ります（どちらか一方だけでも構いません）。全部の通知で共通で、知らせるかどうかは話題ごとに決めます。
        </p>
      </section>

      <%!-- 端末へ直接知らせる（Web Push）。**ntfy のアプリが無くても受け取れる** ——
           iPhone ではホーム画面に入れた Chidori が通知を受け取れる --%>
      <section id="web-push-section" class="settings-block">
        <h3>この端末に通知を送る</h3>
        <p class="muted-note">
          通知を押すと、その話題のいちばん新しいまとめを開きます。iPhone では、Safari の共有メニューから「ホーム画面に追加」し、ホーム画面の Chidori から開いてここで登録してください。
        </p>
        <div
          :if={@push_key}
          id="web-push"
          phx-hook="WebPush"
          phx-update="ignore"
          data-key={@push_key}
          class="web-push"
        >
          <p data-role="state" aria-live="polite">この端末の様子を確かめています…</p>
          <div class="button-row">
            <button type="button" data-role="enable" hidden>この端末で受け取る</button>
            <button type="button" data-role="disable" hidden>この端末では受け取らない</button>
          </div>
        </div>
        <p :if={!@push_key} class="muted-note">
          端末を登録する表がまだありません（DB の更新を済ませると使えます）。
        </p>
        <%!-- 送り手の名乗り（VAPID の sub）。**https でないと iPhone への通知が断られる**
             （配信元が 403 BadJwtToken を返す）ので、ここで目に見えるようにする --%>
        <p class={["muted-note", !Chidori.WebPush.subject_ok?() && "push-subject-bad"]}>
          送り手の名乗り: <code>{Chidori.WebPush.subject()}</code>
          <span :if={!Chidori.WebPush.subject_ok?()}>
            —— https の URL ではないので、iPhone への通知は断られます。PHX_HOST を外から開く名前に、PHX_SCHEME を https にして起動し直してください。
          </span>
        </p>

        <ul :if={@push_devices != []} id="push-devices" class="notify-topics">
          <li :for={device <- @push_devices}>
            <span>
              {if device.label == "", do: "端末", else: device.label}
              <span class="muted-note">{Chidori.Jst.format(device.inserted_at)} に登録</span>
            </span>
            <button type="button" phx-click="remove_device" phx-value-id={device.id}>外す</button>
          </li>
        </ul>
        <p :if={@push_key && @push_devices == []} class="muted-note">登録してある端末はありません。</p>
        <div :if={@push_devices != []} class="button-row">
          <button type="button" id="test-push" phx-click="test_push" disabled={@push_testing}>
            テスト通知を送る
          </button>
        </div>
        <p :if={@push_message} id="push-message" class="muted-note" aria-live="polite">
          {@push_message}
        </p>
      </section>

      <.form
        :let={f}
        id="ntfy-form"
        for={@ntfy_form}
        phx-submit="save_ntfy"
        phx-change="edit_ntfy"
        class="settings-block"
      >
        <h3>ntfy に送る</h3>
        <%!-- **送る・送らないはトピック名と別に切り替える**（名前を消して止めると、
             戻すときに名前を覚えておく羽目になる）。外したときも値が届くよう、隠し欄を先に置く --%>
        <p>
          <input type="hidden" name={f[:enabled].name} value="false" />
          <label>
            <input
              type="checkbox"
              name={f[:enabled].name}
              value="true"
              checked={Phoenix.HTML.Form.normalize_value("checkbox", f[:enabled].value)}
            /> ntfy に送る
          </label>
        </p>
        <p>
          <label>
            通知先（ntfy のトピック名）<br />
            <input type="text" name={f[:topic].name} value={f[:topic].value} />
          </label>
        </p>
        <p>
          <label>
            ntfy の場所（空なら {Chidori.Ntfy.default_base_url()}）<br />
            <input
              type="text"
              name={f[:base_url].name}
              value={f[:base_url].value}
              placeholder="https://ntfy.example.com"
            />
          </label>
        </p>
        <p class="muted-note">
          <strong>「ntfy に送る」を外すと、ntfy へは送らなくなります</strong>（トピック名は残ります。登録した端末には送ります。要約は時刻どおりに作ります）。通知先が空のときも送りません。
          既定の通知先は持ちません —— 公開の ntfy では、推測できる名前は誰でも読めるので、<strong>推測されない名前</strong>にしてください。場所は書かなければ公式の公開サーバーへ送ります。
        </p>
        <div class="button-row">
          <button type="submit">ntfy の設定を保存</button>
        </div>
      </.form>

      <section class="settings-block">
        <h3>知らせる話題</h3>
        <p class="muted-note">チェックを入れた話題は、要約ができたら ntfy と登録した端末へ知らせます（押したらすぐ反映します）。</p>
        <%!-- **ここで切り替えられる**（各話題の画面の「通知」と同じ値）。話題ごとの画面を
             渡り歩かないと、どれを知らせているかを揃えられなかった --%>
        <ul id="notify-topics" class="notify-topics">
          <li :for={topic <- @notify_topics}>
            <label>
              <input
                type="checkbox"
                checked={topic.notify}
                phx-click="toggle_notify"
                phx-value-collection={topic.collection}
              />
              {topic.name}
            </label>
            <.link navigate={~p"/news?view=#{topic.collection}"} class="muted-note">話題の画面へ</.link>
          </li>
        </ul>
      </section>
    </section>
  </div>
</main>
