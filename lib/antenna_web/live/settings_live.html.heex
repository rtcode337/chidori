<Layouts.flash_group flash={@flash} />
<main class="news-page">
  <div>
    <header>
      <a href={~p"/"} class="brand" aria-label="antenna トップページ">
        <span> a </span>
        <strong>antenna</strong>
      </a>
      <nav aria-label="主要メニュー">
        <a href={~p"/news"}>ニュース</a>
        <a href={~p"/relations"}>関連図</a>
        <a class="active" href={~p"/settings"}>設定</a>
      </nav>
    </header>

    <section class="news-intro">
      <p>SETTINGS</p>
      <h1>話題ごとの設定</h1>
      <p>
        話題ごとに、<strong>集める相手</strong>と<strong>選ぶ相手</strong>を別に決められます。
        役割が違うので、速さと質の釣り合いも別に決めたいためです —— 集めるのは web を歩く仕事、
        選ぶのは溜まったものを読む仕事です。どちらも未指定なら Chiezo の既定にまかせます。
      </p>
      <p :if={@saved} class="news-message">「{@saved}」の設定を保存しました。</p>
      <p :if={@backends == []} class="news-message">
        Chiezo に相手を聞けませんでした。選べるのは「既定にまかせる」だけです。
      </p>
    </section>

    <section class="news-list">
      <article :for={topic <- @topics} class="topic">
        <div class="topic-body">
          <h2>{topic.name}</h2>
          <p class="news-source">Chiezo の収集: {topic.collection}</p>
          <p class="news-reason">関心: {topic.interest}</p>

          <%= if @editing == topic.id do %>
            <%!-- 話題ごとに 1 枚出るので、id も話題ごとに分ける
                  （同じ id が並ぶと、切断からの復帰でフォームを取り違える） --%>
            <.form
              for={@form}
              id={"topic-form-#{topic.id}"}
              phx-submit="save"
              phx-change="validate"
              class="topic-form"
            >
              <p :if={@error} class="news-message">{@error}</p>

              <label>関心（何を集めて、何を選んでほしいか）</label>
              <.input field={@form[:interest]} type="textarea" rows="3" />

              <fieldset>
                <legend>集める相手</legend>
                <.input
                  field={@form[:collect_backend]}
                  type="select"
                  options={backend_options(@backends)}
                />
                <.input
                  field={@form[:collect_model]}
                  type="select"
                  label="モデル"
                  options={
                    candidate_options(
                      @backends,
                      field_value(@form, :collect_backend),
                      "models",
                      field_value(@form, :collect_model)
                    )
                  }
                />
                <.input
                  field={@form[:collect_effort]}
                  type="select"
                  label="考える量"
                  options={
                    candidate_options(
                      @backends,
                      field_value(@form, :collect_backend),
                      "efforts",
                      field_value(@form, :collect_effort)
                    )
                  }
                />
              </fieldset>

              <fieldset>
                <legend>選ぶ相手</legend>
                <.input
                  field={@form[:select_backend]}
                  type="select"
                  options={backend_options(@backends)}
                />
                <.input
                  field={@form[:select_model]}
                  type="select"
                  label="モデル"
                  options={
                    candidate_options(
                      @backends,
                      field_value(@form, :select_backend),
                      "models",
                      field_value(@form, :select_model)
                    )
                  }
                />
                <.input
                  field={@form[:select_effort]}
                  type="select"
                  label="考える量"
                  options={
                    candidate_options(
                      @backends,
                      field_value(@form, :select_backend),
                      "efforts",
                      field_value(@form, :select_effort)
                    )
                  }
                />
              </fieldset>

              <dl class="backend-hint">
                <div :for={{label, detail} <- backend_hint(@backends)}>
                  <dt>{label}</dt>
                  <dd>{detail}</dd>
                </div>
              </dl>

              <div class="news-actions">
                <button type="submit">保存する</button>
                <button type="button" class="news-secondary" phx-click="cancel">やめる</button>
              </div>
            </.form>
          <% else %>
            <dl class="collect-facts">
              <div>
                <dt>集める相手</dt>
                <dd>
                  {backend_text(topic.collect_backend, topic.collect_model, topic.collect_effort)}
                </dd>
              </div>
              <div>
                <dt>選ぶ相手</dt>
                <dd>
                  {backend_text(topic.select_backend, topic.select_model, topic.select_effort)}
                </dd>
              </div>
            </dl>
            <div class="news-actions">
              <button type="button" phx-click="edit" phx-value-id={topic.id}>設定を変える</button>
            </div>
          <% end %>
        </div>
      </article>
    </section>
  </div>
</main>
