<Layouts.flash_group flash={@flash} />

<main class="relations-page">
  <div>
    <header>
      <a href={~p"/"} class="brand" aria-label="antenna トップページ"><span>a</span>antenna</a>
      <nav aria-label="主要メニュー">
        <a href={~p"/news"}>最新情報</a>
        <a class="active" href={~p"/relations"}>関連図</a>
        <a href={~p"/settings"}>設定</a>
      </nav>
    </header>

    <section class="relations-intro">
      <p>{@relation.eyebrow}</p>
      <h1>{@relation.title}</h1>
      <p>{@relation.description}</p>

      <%!-- **開くたびには取りに行かない。** 8,000 人ぶんを読むので数秒かかるのに、
           Chiezo の側は数時間に 1 度しか動かない。いつのものを見ているかを出して、
           取り直すかは読む人に決めてもらう --%>
      <p class="relation-checked">
        <span class="muted-note">{checked_text(@relation)}</span>
        <button type="button" phx-click="reload" disabled={@relation[:step] != nil}>
          {if @relation[:step], do: "読んでいます…", else: "最新の情報を取得"}
        </button>
      </p>
    </section>

    <nav class="relation-tabs" aria-label="関連図の種類">
      <.link patch={~p"/relations?view=people"} class={if @view == "people", do: "selected"}>
        人物のつながり
      </.link>
      <.link patch={~p"/relations?view=painters"} class={if @view == "painters", do: "selected"}>
        画家の影響と時代
      </.link>
    </nav>

    <%!-- 図は地図と同じ操作にする（押し広げ・引きずり）。**全画面はブラウザの
         Fullscreen API に任せる** —— 自前で画面を覆うと、ブラウザの UI が残るぶん
         縦が削られ、Esc で閉じる作法も自分で書くことになる --%>
    <section
      class="relation-canvas"
      aria-label={@relation.title}
      id={"relation-canvas-#{@view}"}
      phx-hook=".PanZoom"
    >
      <%!-- 行き先を選ぶ口。**名前で探す**のと、**前に見た印から選ぶ**のを並べて置く ——
           名前を思い出せないときに使うのが後者なので、探す欄の中には入れられない --%>
      <% seen = seen_options(@relation, @marks) %>
      <div class="relation-find">
      <form
        id={"relation-search-#{@view}"}
        class="relation-search"
        phx-change="search"
        phx-submit="search"
        autocomplete="off"
      >
        <input
          type="search"
          name="q"
          value={@query}
          placeholder="画家を探す"
          aria-label="画家を探す"
        />
        <button
          :if={@query != ""}
          type="button"
          phx-click="clear_search"
          aria-label="検索をやめる"
        >
          ×
        </button>
        <ul :if={@matches != []} class="relation-matches">
          <li :for={match <- @matches}>
            <button type="button" phx-click="focus" phx-value-name={match.name}>
              {match.name}
              <span :if={match.years} class="match-years">{match.years}</span>
            </button>
          </li>
        </ul>
      </form>
      <form
        :if={seen != []}
        id={"relation-seen-#{@view}"}
        class="relation-seen"
        phx-change="focus_marked"
      >
        <select name="name" aria-label={"見た#{unit_of(@view)}を探す"}>
          <%!-- 先頭は行き先ではなく口の名前。**選ばれている行き先が分かる**ように、
               寄っているものはそのまま選ばれた状態で残す --%>
          <option value="">見た{unit_of(@view)}（{length(seen)}）</option>
          <option :for={{name, label} <- seen} value={name} selected={@query == name}>
            {label}
          </option>
        </select>
      </form>
      </div>
      <div class="relation-tools">
        <button type="button" data-zoom="in" aria-label="拡大">＋</button>
        <button type="button" data-zoom="out" aria-label="縮小">−</button>
        <button type="button" data-zoom="reset" aria-label="全体を表示">全体</button>
        <button type="button" data-zoom="full" aria-label="全画面で見る">全画面</button>
      </div>
      <%!-- 案内は端末で変える。押しても全画面にならない PC に「押すと全画面」と
           書くと嘘になる（全画面はボタンからいつでも入れる） --%>
      <p class="relation-hint">
        <span class="only-touch">押すと全画面。指で動かし、2 本の指でつまんで拡大縮小。</span><span class="only-mouse">引きずって移動、Ctrl+ホイールで拡大縮小。</span>
      </p>
      <%!-- **表示例の図は描かない。** 本物と見分けが付かないので、読み込みが終わるまで
           5 人の関連図が出て「これは何」になる。何を待っているかだけを出す --%>
      <div :if={@relation[:sample?]} class="canvas-empty">
        <p>{sample_message(@relation)}</p>
      </div>

      <%!-- 絞り込みが掛かっていれば、その人たちだけで置き直した図を描く。
           **絞るだけでは足りない** —— 位置がもとのままだと、39 人が高さ 2,500 の面に
           散らばって拡大しないと読めず、絞った意味が無い --%>
      <% shown = shown(@relation, assigns) %>
      <svg
        :if={!@relation[:sample?]}
        viewBox={"0 0 #{shown.width} #{shown.height}"}
        role="img"
        aria-label={shown.title}
      >
        <defs>
          <marker
            id="arrow"
            viewBox="0 0 10 10"
            refX="10"
            refY="5"
            markerWidth="4"
            markerHeight="4"
            orient="auto-start-reverse"
          >
            <path d="M 0 0 L 10 5 L 0 10 z" />
          </marker>
        </defs>
        <%!-- 年表の目盛り。**間隔は一定ではない** —— 丸は年代の順に等間隔で並べてあるので、
             目盛りの側が伸び縮みする。人が多い年代ほど広がる --%>
        <%!-- 地域の帯。**丸より先に描く**ので、丸も線も帯の上に乗る。
             帯の幅は人数の比なので、広い帯にはそれだけの画家がいる --%>
        <g :for={band <- shown[:bands] || []} class="relation-band">
          <rect x={band.x} y="0" width={band.width} height={shown.height} />
          <line x1={band.x} y1="0" x2={band.x} y2={shown.height} />
        </g>
        <g :for={tick <- shown[:ticks] || []} class="relation-tick">
          <line x1="70" y1={tick.y} x2={shown.width} y2={tick.y} />
        </g>
        <%!-- **年代の札だけは画面の左端に貼り付ける。** 図と一緒に流すと、少し右へ
             引きずっただけで年表が画面の外へ出てしまい、拡大したときにいちばん
             知りたい「いまどのあたりの時代か」が読めなくなる。
             横の位置と字の大きさは PanZoom が当て直す（縦は図と一緒に動く）--%>
        <g class="tick-labels" data-pinned-labels>
          <text :for={tick <- shown[:ticks] || []} x="8" y={tick.y + 5}>
            {tick.year}年
          </text>
        </g>
        <%!-- 帯の名前。**上端に貼り付ける** —— 下へ引きずったときに、いま見ている
             縦の列がどの地域なのか分からなくなる（年代の札と同じ理由）--%>
        <g class="band-labels" data-pinned-top>
          <text :for={band <- shown[:bands] || []} x={band.x + band.width / 2} y="0">
            {band.band}
            <tspan class="band-count">{band.members}人</tspan>
          </text>
        </g>
        <%!-- **描くのは見えているぶんだけ**（`drawn_nodes/2`）。全部を並べると
             2 万を超える要素になり、引きずるだけで固まる。端の座標は先に
             引き当ててある（`edge_lines/2`）—— ここで探すとノード数 × エッジ数の
             線形探索になる --%>
        <% drawn = drawn_nodes(shown, @viewport, @focus) %>
        <%= for edge <- edge_lines(shown, drawn) do %>
          <line
            x1={edge.x1}
            y1={edge.y1}
            x2={edge.x2}
            y2={edge.y2}
            class={"relation-edge #{edge.kind}"}
            marker-end={if edge.kind == :influence, do: "url(#arrow)"}
          />
          <%!-- **押す的は別に置く。** 線そのものは細いので、そのままでは指でも
               マウスでも当たらない。透明な太い線を重ねて、そちらで受ける。
               **薄い線（相互リンク）も押せる** —— 影響の線はまだ数えるほどしか
               無いので、押せるのが影響だけだと「押せない図」になる --%>
          <line
            x1={edge.x1}
            y1={edge.y1}
            x2={edge.x2}
            y2={edge.y2}
            class="edge-target"
            phx-click="show_edge"
            phx-value-from={edge.from}
            phx-value-to={edge.to}
            phx-value-kind={edge.kind}
          />
          <text x={edge.mid_x} y={edge.mid_y} class="edge-label">{edge.label}</text>
        <% end %>
        <%= for node <- drawn do %>
          <%!-- **どの丸も押せる。** 押すと、もとになった記事・Chiezo に入っている
               タグ・（あれば）代表作の絵を出す。押せる丸と押せない丸が混じっていると、
               押しても何も起きない丸を何度も押すことになる --%>
          <g
            transform={"translate(#{node.x}, #{node.y})"}
            class={[
              "relation-node",
              to_string(node.kind),
              works_of(node) != [] && "has-work",
              node[:changed?] && "changed",
              marked?(@marks, node.name) && "marked",
              node.id == @focus && "focused"
            ]}
            phx-click="show_node"
            phx-value-name={node.name}
          >
            <%!-- 探して選んだ人の目印。**札の色だけでは周りに紛れる**ので、
                 広がって消える輪を重ねる（動きは止まっている図の中で目に入る） --%>
            <rect
              :if={node.id == @focus}
              class="focus-ring"
              x={-label_width_of(node) / 2}
              y={-label_height_of(node) / 2}
              width={label_width_of(node)}
              height={label_height_of(node)}
              rx={label_height_of(node) * 0.28}
            />
            <%!-- **丸ではなく札にする。** 円は角へ行くほど内側が痩せるので、
                 横に長い名前を入れるには不釣り合いに大きな円が要り、そうしないと
                 名前が外へはみ出す。四角なら名前の幅どおりに広げられる --%>
            <%!-- **様式は色で見せる。** 枠で囲うのはやめた —— 同じ様式の画家は
                 生年順に並べると飛び飛びになるので、他人を入れずに囲おうとすると
                 枠が細かく割れる（印象派 39 人が 11 枠になった）。色なら、
                 離れていても同じ派閥だと分かる --%>
            <rect
              x={-label_width_of(node) / 2}
              y={-label_height_of(node) / 2}
              width={label_width_of(node)}
              height={label_height_of(node)}
              rx={label_height_of(node) * 0.28}
              style={hue_style(node)}
            />
            <%!-- 字の大きさは 1 人ずつ違う（知名度で決まる）ので、CSS ではなく
                 ここで当てる。**style で当てる** —— SVG の font-size 属性は
                 CSS のほうが強いので、属性で書くと class 側に負ける --%>
            <text
              text-anchor="middle"
              dominant-baseline="central"
              class="node-name"
              y={node[:name_dy] || 0}
              style={"font-size: #{name_size_of(node)}px"}
            >
              {node.name}<tspan :if={works_of(node) != []} class="work-mark">
                {Antenna.Relations.Graph.work_mark()}
              </tspan>
            </text>
            <%!-- **様式は札の中に入れる。** 外に置くと、隣の丸の札と重なったときに
                 どちらの様式か分からなくなる（札の中なら、札ごと重なりを避ける
                 仕組みに乗る）。札の高さはそのぶん広げてある --%>
            <text
              :if={node.note}
              text-anchor="middle"
              dominant-baseline="central"
              class="node-note"
              y={node[:note_dy] || 0}
              style={"font-size: #{sub_size_of(node)}px"}
            >
              {node.note}
            </text>
            <%!-- 年代は外（下）のまま。札の中に 3 行入れると札が縦に伸びすぎる --%>
            <text
              :if={node.years}
              text-anchor="middle"
              class="year-label"
              y={label_height_of(node) / 2 + sub_size_of(node) * 1.15}
              style={"font-size: #{sub_size_of(node)}px"}
            >
              {node.years}
            </text>
          </g>
        <% end %>
      </svg>
    </section>

    <%!-- 直近の巡回で何が動いたか。**図の下、凡例のすぐ上に置く** —— 押すと
         その人たちだけになるので、絞り込みの仲間として並べたほうが見つかる。
         動いたものが無ければ出さない（最初の一括作成では全部が同じ刻みになる）--%>
    <section :if={@view == "painters" and changed_note(@relation)} class="changed-note">
      <p>{changed_note(@relation)}</p>
      <button
        type="button"
        class={@changed_only && "on"}
        phx-click="filter_changed"
        aria-pressed={to_string(@changed_only)}
      >
        {if @changed_only, do: "すべて出す", else: "動いたものだけ"}
      </button>
    </section>

    <%!-- 色の凡例。**図の真下に置く** —— 色を見てから凡例を探すので、間に何かを
         挟むと目が行き来する。**押すとその様式だけになる**（もう一度押すと戻る）--%>
    <section :if={@view == "painters" and style_legend(@relation) != []} class="style-legend">
      <ul>
        <li :for={{style, count, hue} <- style_legend(@relation)}>
          <button
            type="button"
            class={@style_filter == style && "on"}
            phx-click="filter_style"
            phx-value-style={style}
            aria-pressed={to_string(@style_filter == style)}
          >
            <span class="swatch" style={"background: hsl(#{hue} 62% 72%)"}></span>
            {style}<span class="muted-note">{count}人</span>
          </button>
        </li>
        <li :if={@style_filter}>
          <button type="button" class="clear" phx-click="filter_style" phx-value-style="">
            すべて出す
          </button>
        </li>
      </ul>
    </section>

    <%!-- 出典を並べていた右半分を畳んで、説明のほうを広げた。**読むのは見方のほう**で、
         出典は表示例のものが固定で出ているだけだった --%>
    <section class="relation-guide">
      <h2>この図の見方</h2>
      <%= if @view == "painters" do %>
        <p>
          <strong>縦は時代</strong>です（上から下へ、並びは生年順）。左端の年代は図を
          動かしても貼り付いたままになります。丸を等間隔に並べているので、
          <strong>画家が多い時代ほど目盛りの間隔が広がります</strong>。
        </p>
        <p>
          <strong>横は地域</strong>です（ヨーロッパ／南北アメリカ／アジア・その他）。
          帯の幅はその地域の画家の数で、名前は上端に貼り付きます。
          地域が取れていない画家は「その他」に入ります。
        </p>
        <p>
          <strong>札の大きさは知られている度合い</strong>（日本語版 Wikipedia の月間閲覧数）、
          <strong>色は様式</strong>です。様式は札の中の 2 行目にも書いてあります。
          <strong>複数の様式を持つ画家は、そのうち 1 つの色</strong>になります
          （丸は 1 つしかないので、どれを選んでも同じくらい正しくない）。
          下の凡例を押すと<strong>その様式だけを大きく並べ直します</strong>。
        </p>
        <p>
          <strong>直近の巡回で動いた画家は、緑の破線で囲みます</strong>
          （Chiezo が足したか直したかしたもの）。図の下の「動いたものだけ」を押すと、
          その人たちだけを大きく並べ直します。<strong>最初の一括作成では出ません</strong> ——
          全部が同じ時刻になるので、比べる先がありません。
        </p>
        <p>
          <strong>どの名前も押せます。</strong> もとになった記事・Chiezo に入っているタグ・
          代表作の絵（最大 3 枚）が出て、その場で
          <strong>「この画家を詳しく調べて」を Chiezo に頼めます</strong>。
          名前のうしろの <strong>{Antenna.Relations.Graph.work_mark()}</strong> は
          代表作が入っている印です。
        </p>
        <p>
          <strong>線も押せます。</strong> 濃い矢印は AI が調べた影響関係で、
          <strong>何をもってそう言えるのかは AI の判断そのもの</strong>です
          （影響関係は記事に書いていないので機械では引けません）。
          薄い線は記事どうしが互いにリンクしているというだけの関係で、
          <strong>Wikipedia から機械的に引いたもの</strong>です。
          どちらを押しても、その線の根拠と両者の記事へのリンクが出ます。
        </p>
        <p>
          図は<strong>引きずって移動、Ctrl+ホイールで拡大縮小</strong>できます
          （素のホイールはページのスクロールに使います）。
          <strong>小さすぎる札と、見えていないところは描きません</strong> ——
          8,000 人を一度に並べると読めないので、拡大すると出てきます。
        </p>
      <% else %>
        <p>実線は家族、点線はコンビとメンバーの関係です。</p>
      <% end %>
    </section>

    <%!-- Chiezo の状態と、そこへ送る設定を **1 つの枠にまとめる**。
         状態を見る場所と、直す場所と、押す場所が離れていると、何がどこへ効くのか
         読めない --%>
    <section class="collect-panel" aria-label="関連図の情報収集">
      <h2>Chiezo の収集</h2>
      <p aria-live="polite">{step_text(@relation) || status_message(@relation)}</p>
      <p :if={step_note(@relation)} class="muted-note">{step_note(@relation)}</p>
      <p :if={busy_note(@relation)} class="muted-note">{busy_note(@relation)}</p>

      <dl :if={collection_facts(@relation) != []} class="collect-facts">
        <div :for={{label, value} <- collection_facts(@relation)}>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      </dl>

      <%!-- **選んだところはサーバーが覚える**（`phx-change`）。覚えないと、図や状態が
           届いた拍子にフォームが描き直され、選んだ相手が元の値に戻る ——
           選んだつもりで押すと、いま入っている値がそのまま送り返される --%>
      <form id="collect-form" phx-submit="collect" phx-change="pick_sweep">
        <%!-- 巡回ごとに 1 行。**相手も進み具合も巡回ごとに違う**ので、収集に 1 つだけ
             出すと、そこに出る値はどちらか片方のものにしかならない --%>
        <.sweep_table state={@relation} picks={@picks} backends={@backends} />

        <p class="muted-note">{source_note(@view)}</p>
        <button type="submit" phx-disable-with="送っています…" disabled={collecting?(@relation)}>
          {collect_label(@relation)}
        </button>
      </form>

      <%!-- **どちらも Chiezo が持っているもの**なので、1 つにまとめる。
           機械で引いたものと AI が書いたものの線引きが、この図でいちばん大事なところ --%>
      <details :if={@view == "painters"} class="news-prompt">
        <summary>Chiezo への依頼文</summary>
        <p class="news-prompt-note">{prompt_note(@relation)}</p>

        <h3>抽出の指定（Wikipedia から機械的に引く条件）</h3>
        <p class="news-prompt-note">
          名簿・年代・様式・地域・代表作・相互リンクは、この指定で日本語版 Wikipedia から
          引いています。<strong>AI は関わりません</strong>（決まった結果が出ます）。
        </p>
        <pre :if={extract_text(@relation)}>{extract_text(@relation)}</pre>
        <p :if={!extract_text(@relation)} class="muted-note">まだ指定が入っていません。</p>

        <h3>指示文（AI に頼んでいる内容）</h3>
        <p class="news-prompt-note">
          AI が書くのは<strong>影響関係と説明</strong>と、カテゴリに無い様式です。
          誰を見るかは Chiezo が区画で渡すので、指示文には書いてありません。
        </p>
        <pre>{prompt_text(@relation)}</pre>
      </details>
    </section>

    <%!-- 押した人のこと。**絵は持たず、Wikipedia のものを指すだけ**。
         図の外に重ねて出す —— 図の下に足すと、押した人が画面の外にいることがある --%>
    <%!-- 影響の線を押したとき。**何をもって影響元としたかを正直に出す** ——
         影響関係は Wikipedia に書いていないので機械では引けず、ここは AI の判断
         そのもの。根拠を確かめたい人が記事へ行けるようにする --%>
    <div
      :if={@edge}
      class="artwork-backdrop"
      phx-window-keydown="close_work"
      phx-key="Escape"
    >
      <section
        class="artwork"
        role="dialog"
        aria-modal="true"
        aria-labelledby="edge-name"
        phx-click-away="close_work"
      >
        <div class="artwork-head">
          <strong id="edge-name">{@edge.from.name} → {@edge.to.name}</strong>
          <button type="button" phx-click="close_work">閉じる</button>
        </div>
        <%= if @edge.kind == :influence do %>
          <p class="edge-reason">
            {@edge.to.name}は{@edge.from.name}から
            <strong>{@edge.label || "影響を受けた"}</strong>、と AI が書いています。
          </p>
          <p class="muted-note">
            <strong>これは AI の判断です。</strong>
            名簿・年代・様式・相互リンクは Wikipedia から機械的に引いていますが、
            <strong>誰が誰から何を受けたのかは記事に書いていない</strong>ので引けません。
            確かめるには、それぞれの記事を読んでください。
          </p>
        <% else %>
          <p class="edge-reason">
            <strong>{@edge.from.name}と{@edge.to.name}は、記事どうしが互いにリンクしています。</strong>
          </p>
          <p class="muted-note">
            これは Wikipedia から機械的に引いた線で、<strong>影響関係ではありません</strong>。
            <strong>片側だけのリンクは採りません</strong> —— 有名な画家は多くの記事から
            名前を出されるので、片側で繋ぐと有名どうしが軒並み繋がって図が読めなくなります。
            互いに名前を出している組だけを残しています。
            <strong>何の関係かまでは、リンクの有無からは分かりません</strong>。
          </p>
        <% end %>
        <ul class="edge-links">
          <li :if={article_url(@edge.from)}>
            <a href={article_url(@edge.from)} target="_blank" rel="noreferrer">
              {@edge.from.name} を Wikipedia で見る
            </a>
          </li>
          <li :if={article_url(@edge.to)}>
            <a href={article_url(@edge.to)} target="_blank" rel="noreferrer">
              {@edge.to.name} を Wikipedia で見る
            </a>
          </li>
        </ul>
      </section>
    </div>

    <div
      :if={@detail}
      class="artwork-backdrop"
      phx-window-keydown="close_work"
      phx-key="Escape"
    >
      <section
        class="artwork"
        role="dialog"
        aria-modal="true"
        aria-labelledby="artwork-name"
        phx-click-away="close_work"
      >
        <div class="artwork-head">
          <strong id="artwork-name">{@detail.name}</strong>
          <button type="button" phx-click="close_work">閉じる</button>
        </div>

        <%!-- **行き先は画家の記事。** 押したのは画家なので、代表作の記事へ飛ばすと
             「この人のことを知りたい」に答えていない --%>
        <p :if={article_url(@detail)} class="artwork-source">
          <a href={article_url(@detail)} target="_blank" rel="noreferrer">
            {@detail[:article] || @detail.name} を Wikipedia で見る
          </a>
        </p>

        <%!-- その画家の短い説明（記事の冒頭）。**絵の説明だけが出て、描いた人の
             説明が出ないのは片手落ち** —— 押したのは画家のほう --%>
        <p :if={@detail[:summary]} class="artwork-extract">{@detail.summary}</p>

        <%!-- Chiezo に入っているタグ。**どういう条件でこの人が名簿に入り、
             何が分かっているのか**が、ここを見ないと読み取れない --%>
        <dl :if={tag_groups(@detail) != []} class="artwork-tags">
          <%= for {label, values} <- tag_groups(@detail) do %>
            <dt>{label}</dt>
            <dd>{Enum.join(values, "、")}</dd>
          <% end %>
        </dl>

        <%= cond do %>
          <% @artwork == :loading -> %>
            <p class="muted-note">代表作を探しています…</p>
          <% is_list(@artwork) and @artwork != [] -> %>
            <%!-- **何枚もあるなら全部出す。** 多作の画家を 1 枚で代表させると、
                 どれを選んでも「その人らしさ」を外す --%>
            <figure :for={work <- @artwork} class="artwork-figure">
              <img src={work.image} alt={work.title} />
              <figcaption>
                <span class="artwork-title">{work.title}</span>
                <span :if={work.extract} class="artwork-extract">{work.extract}</span>
                <a :if={work.page} href={work.page} target="_blank" rel="noreferrer">
                  この絵を Wikipedia で見る
                </a>
              </figcaption>
            </figure>
          <% works_of(@detail) == [] -> %>
            <p class="muted-note">この画家には、まだ代表作が入っていません。</p>
          <% true -> %>
            <p class="muted-note">代表作の絵は見つかりませんでした。</p>
        <% end %>

        <%!-- 見に行った記録。**図に出ているのは Chiezo から読んだものだけ**で、
             利用者が自分で書いたことはどこにも残せなかった。展覧会で実物を見た、
             という記録は Chiezo には置けない（あちらは題材も好みも持たない側） --%>
        <% mark = mark_of(@marks, @detail.name) %>
        <details class="seen-mark" open={marked?(@marks, @detail.name)}>
          <summary>
            見た記録
            <span :if={mark_summary(mark)} class="seen-badge">{mark_summary(mark)}</span>
          </summary>
          <form phx-submit="save_mark">
            <input type="hidden" name="name" value={@detail.name} />
            <p class="seen-row">
              <label>
                <input type="checkbox" name="seen" checked={mark.seen} /> 見た
              </label>
              <label>
                見た日
                <input type="date" name="seen_on" value={seen_on_value(mark)} />
              </label>
            </p>
            <p>
              <label>
                メモ（どこで、何を見たか）<br />
                <textarea
                  name="note"
                  rows="3"
                  placeholder="例: 〇〇美術館の回顧展。晩年の風景画がまとめて出ていた"
                >{mark.note}</textarea>
              </label>
            </p>
            <p class="muted-note">
              ここに書いたことは antenna にだけ残ります（Chiezo へは送りません）。
              <strong>印もメモも空にして保存すると、記録ごと消えます。</strong>
            </p>
            <button type="submit" phx-disable-with="保存しています…">記録を保存</button>
            <span :if={@mark_saved == @detail.name} class="muted-note">保存しました。</span>
          </form>
        </details>

        <%!-- **この人を詳しく調べて、を頼める。** 巡回は 8,000 人を順に回るので、
             気になった 1 人に当たるのは何日も先になる。割り込みは定時の巡回の
             進み具合にも次の予定にも触らない --%>
        <details :if={@view == "painters"} class="ask-more">
          <summary>この画家を詳しく調べてもらう</summary>
          <% asked = focus_state(@relation, @detail.name) %>
          <%= if asked && asked.state == :failed do %>
            <%!-- **断られたことは必ず出す。** 黙って捨てると「頼んだのに何も
                 起きない」だけが残り、押した人には確かめようがない --%>
            <p class="warn-note">{focus_error(asked)}</p>
          <% end %>
          <%= if @focus_sent == @detail.name and (asked == nil or asked.state != :failed) do %>
            <p class="muted-note">
              Chiezo に頼みました。<strong>結果が図に出るのは、次に Chiezo が集めたあと</strong>です。
            </p>
          <% else %>
            <form phx-submit="focus_painter">
              <input type="hidden" name="name" value={@detail.name} />
              <p>
                <label>
                  どこを調べてほしいか（空でもよい）<br />
                  <textarea
                    name="note"
                    rows="2"
                    placeholder="例: 誰から影響を受けたのかが空のままなので調べて"
                  ></textarea>
                </label>
              </p>
              <p class="muted-note">
                定時の巡回とは別の道で頼みます（進み具合も次の予定も動きません）。
                名指しするので、この画家は必ず AI に見せられます。
              </p>
              <button type="submit" phx-disable-with="頼んでいます…">この画家を頼む</button>
            </form>
          <% end %>
        </details>
      </section>
    </div>
  </div>
</main>

<%!-- 図の押し広げと引きずり。**地図アプリと同じ操作**にしてある。

     状態（倍率と位置）はフックが持ち、`updated` で当て直す。LiveView が図を
     描き直すのは収集のあとなどで、そのたびに見ていた位置へ戻されると、
     どこを見ていたのか分からなくなる。

     **引きずったときは押したことにしない。** 丸を押すと代表作が出る作りなので、
     移動のつもりの操作で毎回ダイアログが開いてしまう。動いた距離で見分ける。 --%>
<script :type={Phoenix.LiveView.ColocatedHook} name=".PanZoom">
  // 倍率の下限と上限。全体表示より小さくしても読めるものが増えないので下は 1 倍
  const MIN_SCALE = 1
  const MAX_SCALE = 8
  // これ以上動いたら「引きずった」とみなす（押したことにしない）
  const DRAG_SLOP = 5

  // 端を越えたあとの動きの重さ（1 が抵抗なし）と、伸びきるまでの px。
  // **止まるのではなく重くする** —— 端で完全に動かなくなると、行き止まりなのか
  // 操作が効いていないのかが区別できない
  // 年代の札を画面のどれだけ内側に置くか（px）と、画面上での字の大きさ（px）
  const LABEL_INSET = 8
  const LABEL_PX = 11
  // 地域の札を画面の上端からどれだけ下に置くか（px）
  const LABEL_TOP = 16

  // 器に収まっている軸の置き場所。**真ん中に寄せる** —— 上や左に寄せると、
  // 短い図（様式で絞ったとき）で下半分が空白になり、壊れているように見える
  const centre = (slack) => [slack / 2, slack / 2]

  const RUBBER = 0.45
  const RUBBER_MAX = 110

  // 離したあと、はみ出したぶんが戻るまでの時間（ミリ秒）
  const SETTLE_MS = 220

  // 見ている範囲を知らせるまでの落ち着き待ち（ミリ秒）。引きずっている最中に
  // 毎フレーム送ると、往復のたびに描き直しが挟まってかえって固まる
  const REPORT_DELAY = 140

  // 探した人へ寄るときの最低倍率。**全体表示のままでは寄った意味が無い**
  // （周りの関連図を読むために探しているので、線の相手まで見える近さが要る）
  const FOCUS_SCALE = 4

  // 指で触る画面か。**画面の幅ではなく入力の種類で見る** —— 幅で分けると、
  // 窓を狭くしただけの PC が「スマホ扱い」になって、押すたびに全画面へ飛ぶ
  const touchLike = () =>
    window.matchMedia && window.matchMedia("(pointer: coarse)").matches

  export default {
    mounted() {
      this.scale = 1
      this.tx = 0
      this.ty = 0
      this.pointers = new Map()
      this.pinch = null
      this.svg = this.el.querySelector("svg")
      this.bind()
      // 探して選んだ人を真ん中へ。**倍率はサーバーが決めない** —— 器が何 px かは
      // こちらしか知らないので、図の座標だけ受け取って寄せ方はここで決める
      this.handleEvent("focus", ({x, y}) => this.centerOn(x, y))
      this.apply()
    },

    // いま触れている 2 本の指の間隔と中点
    spread() {
      const [a, b] = Array.from(this.pointers.values())
      return {
        distance: Math.hypot(a.x - b.x, a.y - b.y),
        x: (a.x + b.x) / 2,
        y: (a.y + b.y) / 2,
      }
    },

    // 図の座標 (x, y) を器の真ん中に置いて寄る
    centerOn(x, y) {
      const box = this.el.getBoundingClientRect()
      const view = (this.svg && this.svg.getAttribute("viewBox") || "").split(/\s+/)
      const vw = parseFloat(view[2])
      if (!(vw > 0) || !(box.width > 0)) { return }
      this.scale = Math.min(MAX_SCALE, Math.max(this.scale, FOCUS_SCALE))
      const ppu = (box.width / vw) * this.scale
      this.tx = box.width / 2 - x * ppu
      this.ty = box.height / 2 - y * ppu
      this.clamp()
      this.apply()
    },

    updated() {
      // 描き直されると svg の要素が入れ替わるので、持ち直してから当て直す
      this.svg = this.el.querySelector("svg")
      this.apply()
    },

    destroyed() {
      clearTimeout(this.reportTimer)
      clearTimeout(this.settleTimer)
      this.unbind()
    },

    // いま見ている範囲を図の座標で知らせる。**サーバーはここだけを描く。**
    //
    // 送るのは落ち着いてから（`REPORT_DELAY`）。引きずっている最中に毎フレーム
    // 送ると、往復のたびに描き直しが挟まって、かえって固まる。
    report() {
      clearTimeout(this.reportTimer)
      this.reportTimer = setTimeout(() => {
        const {box} = this.metrics()
        const view = (this.svg && this.svg.getAttribute("viewBox") || "").split(/\s+/)
        const vw = parseFloat(view[2])
        if (!(vw > 0) || !(box.width > 0)) { return }
        // 図の 1 単位が画面の何 px か。倍率が上がるほど大きくなる
        const ppu = (box.width / vw) * this.scale
        this.pushEvent("viewport", {
          x: -this.tx / ppu,
          y: -this.ty / ppu,
          w: box.width / ppu,
          h: box.height / ppu,
          ppu: ppu,
        })
      }, REPORT_DELAY)
    },

    apply() {
      if (!this.svg) { return }
      // 数でない値が 1 つでも混ざると transform ごと無効になり、**黙って動かなくなる**
      // （エラーも出ないので原因を追いにくい）。ここで 0 に戻して踏み止まる
      if (!isFinite(this.tx) || !isFinite(this.ty) || !isFinite(this.scale)) {
        this.tx = 0
        this.ty = 0
        this.scale = 1
      }
      this.svg.style.transformOrigin = "0 0"
      this.svg.style.transform =
        `translate(${this.tx}px, ${this.ty}px) scale(${this.scale})`
      this.pinLabels()
      this.report()
    },

    // 年代の札を画面の左端に留める。
    //
    // **図と一緒に流さない。** 少し右へ引きずるだけで年表が画面の外へ出てしまい、
    // 拡大したときにいちばん知りたい「いまどのあたりの時代か」が読めなくなる。
    // 縦は図と一緒に動かす（そこがずれたら年表の意味が無い）。
    //
    // 図そのものは CSS の transform で動かしているので、札はその逆を当てて
    // 打ち消す —— 字の大きさも倍率で割り戻して、拡大しても同じ大きさに見せる。
    pinLabels() {
      const labels = this.svg.querySelector("[data-pinned-labels]")
      if (!labels) { return }
      const box = this.el.getBoundingClientRect()
      const view = (this.svg.getAttribute("viewBox") || "").split(/\s+/)
      const vw = parseFloat(view[2])
      // 図の 1 単位が画面の何 px か（viewBox の伸縮ぶんだけで、倍率は別に掛ける）
      const unit = vw > 0 && box.width > 0 ? box.width / vw : 0
      if (!(unit > 0)) { return }
      const perUnit = unit * this.scale
      // 画面の左端（LABEL_INSET px 内側）に来る図の座標。札は x=8 に書いてあるので、
      // そこからの差を transform で足す
      const target = (LABEL_INSET - this.tx) / perUnit
      labels.setAttribute("transform", `translate(${target - 8}, 0)`)
      labels.style.fontSize = `${LABEL_PX / perUnit}px`

      // 地域の札は上端に留める（横は図と一緒に動かす —— そこがずれたら軸の意味が無い）
      const top = this.svg.querySelector("[data-pinned-top]")
      if (top) {
        top.setAttribute("transform", `translate(0, ${(LABEL_TOP - this.ty) / perUnit})`)
        top.style.fontSize = `${LABEL_PX / perUnit}px`
      }
    },

    // 倍率を変える。**押した点を動かさない** —— 中心を固定して拡大すると、
    // 見ていたものが画面の外へ逃げる
    zoomAt(factor, clientX, clientY) {
      const next = Math.min(MAX_SCALE, Math.max(MIN_SCALE, this.scale * factor))
      if (next === this.scale) { return }
      const box = this.el.getBoundingClientRect()
      const px = clientX - box.left
      const py = clientY - box.top
      const ratio = next / this.scale
      this.tx = px - (px - this.tx) * ratio
      this.ty = py - (py - this.ty) * ratio
      this.scale = next
      this.clamp()
      this.apply()
    },

    // いま画面に出ている図の大きさ（倍率こみ）と、器の大きさ。
    //
    // **SVG に offsetWidth は使えない。** SVGElement は HTMLElement ではないので
    // 値が undefined になり、掛けた先が NaN になって transform ごと無効になる
    // （引きずっても拡大しても何も動かなくなる）。器の幅と viewBox の比から出す。
    metrics() {
      const box = this.el.getBoundingClientRect()
      const view = (this.svg && this.svg.getAttribute("viewBox") || "").split(/\s+/)
      const vw = parseFloat(view[2])
      const vh = parseFloat(view[3])
      const width = box.width
      const height = vw > 0 && vh > 0 ? width * (vh / vw) : box.height
      return {box, width: width * this.scale, height: height * this.scale}
    },

    // 動ける範囲。`{x: [min, max], y: [min, max]}` を返す。
    //
    // **器ではなく図の大きさで測る。** 図は器よりずっと縦長で、倍率 1 倍でも
    // はみ出している —— 器の高さで測ると、拡大するまで縦に動かせなくなる。
    // 収まっているほうの軸は動かさない（余白の中で図が泳ぐと落ち着かない）。
    range() {
      const {box, width, height} = this.metrics()
      if (!isFinite(width) || !isFinite(height)) { return null }
      // **収まっているほうは真ん中に置く。** 上に寄せると、短い図（様式で絞ったとき）
      // で下半分が空白になり、壊れているように見える
      return {
        x: width <= box.width ? centre(box.width - width) : [box.width - width, 0],
        y: height <= box.height ? centre(box.height - height) : [box.height - height, 0],
      }
    },

    // 図を器の外へ出しすぎない。真っ白な面だけが見える状態にしない。
    clamp() {
      const limit = this.range()
      if (!limit) { return }
      this.tx = Math.min(limit.x[1], Math.max(limit.x[0], this.tx))
      this.ty = Math.min(limit.y[1], Math.max(limit.y[0], this.ty))
    },

    // 端からどれだけはみ出しているか（範囲の中なら 0）
    overshoot(value, [min, max]) {
      if (value > max) { return value - max }
      if (value < min) { return value - min }
      return 0
    },

    // 端に着いてからも、抵抗をつけて少しだけ動かす。
    //
    // **止まるのではなく重くなる。** 端で完全に動かなくなると、行き止まりなのか
    // 操作が効いていないのかが指先から区別できない（実際に「バグなのか端なのか
    // 分からない」と言われた）。少し動いて、離すと戻れば、端だと分かる。
    drag(dx, dy) {
      const limit = this.range()
      if (!limit) { return }
      this.tx = this.pull(this.tx, dx, limit.x)
      this.ty = this.pull(this.ty, dy, limit.y)
    },

    pull(value, delta, bounds) {
      const out = Math.abs(this.overshoot(value, bounds))
      // はみ出しているぶんだけ動きを鈍らせ、伸びきったところで止める
      const give = out >= RUBBER_MAX ? 0 : RUBBER * (1 - out / RUBBER_MAX)
      const next = value + delta
      // 範囲へ戻る向きの動きには抵抗をかけない（戻すのが重いと直感に反する）
      const returning = Math.abs(this.overshoot(next, bounds)) < out
      return returning ? next : value + delta * (out > 0 ? give : 1)
    },

    // 指を離したら、はみ出したぶんを戻す。
    settle() {
      const {tx, ty} = this
      this.clamp()
      if (this.tx === tx && this.ty === ty) { return }
      if (this.svg) { this.svg.style.transition = `transform ${SETTLE_MS}ms ease-out` }
      this.apply()
      clearTimeout(this.settleTimer)
      this.settleTimer = setTimeout(() => {
        if (this.svg) { this.svg.style.transition = "" }
      }, SETTLE_MS + 20)
    },

    reset() {
      this.scale = 1
      this.tx = 0
      this.ty = 0
      this.apply()
    },

    // 全画面。**使えない端末がある** —— iOS の Safari は動画以外を全画面にできない
    // ので、そこでは器に class を足して画面いっぱいに広げる（見た目は同じになる）
    fullscreen() {
      if (document.fullscreenElement) {
        document.exitFullscreen()
        return
      }
      if (this.el.classList.contains("faux-fullscreen")) {
        this.el.classList.remove("faux-fullscreen")
        this.onFullscreen()
        return
      }
      if (this.el.requestFullscreen) {
        this.el.requestFullscreen().catch(() => this.fauxFullscreen())
      } else {
        this.fauxFullscreen()
      }
    },

    fauxFullscreen() {
      this.el.classList.add("faux-fullscreen")
      this.onFullscreen()
    },

    bind() {
      this.onWheel = (ev) => {
        // **素のホイールは横取りしない。** 図はページの中に埋まっているので、
        // 素で拡大縮小にすると、読み進めようとスクロールしただけで図が動き、
        // ページが進まない。拡大は Ctrl（Mac は ⌘）を押しながら。
        //
        // トラックパッドのつまむ操作は ctrlKey 付きの wheel として届くので、
        // この分岐だけで指の操作も拾える。
        if (!ev.ctrlKey && !ev.metaKey) { return }
        ev.preventDefault()
        this.zoomAt(ev.deltaY < 0 ? 1.15 : 1 / 1.15, ev.clientX, ev.clientY)
      }

      this.onPointerDown = (ev) => {
        if (ev.target.closest(".relation-tools") || ev.target.closest(".relation-find")) {
          return
        }
        // **指は何本でも来る。** 1 本ぶんしか覚えないと、2 本目を置いた瞬間に
        // 座標が飛び、つまむ操作が引きずりとして扱われる
        this.pointers.set(ev.pointerId, {x: ev.clientX, y: ev.clientY})
        this.dragging = true
        this.moved = 0
        this.lastX = ev.clientX
        this.lastY = ev.clientY
        this.pinch = this.pointers.size >= 2 ? this.spread() : null
        // **ここでは捕まえない。** ポインタを捕捉すると、続く click の宛先が
        // 捕捉した要素へ付け替えられ、丸の phx-click に届かなくなる
        // （押しても代表作が出なくなる）。捕まえるのは引きずり始めてから
      }

      this.onPointerMove = (ev) => {
        if (!this.dragging) { return }
        if (this.pointers.has(ev.pointerId)) {
          this.pointers.set(ev.pointerId, {x: ev.clientX, y: ev.clientY})
        }

        // 指 2 本ならつまむ拡大。**ホイールの無い端末ではこれが唯一の拡大手段**
        if (this.pointers.size >= 2) {
          const now = this.spread()
          if (this.pinch && this.pinch.distance > 0 && now.distance > 0) {
            this.moved = Infinity
            this.zoomAt(now.distance / this.pinch.distance, now.x, now.y)
          }
          this.pinch = now
          return
        }

        const dx = ev.clientX - this.lastX
        const dy = ev.clientY - this.lastY
        this.moved += Math.abs(dx) + Math.abs(dy)
        this.lastX = ev.clientX
        this.lastY = ev.clientY
        // 引きずりだと分かった時点で捕まえる。指が図の外へ出ても追い続けるため
        if (this.moved > DRAG_SLOP && !this.el.hasPointerCapture(ev.pointerId)) {
          this.el.setPointerCapture(ev.pointerId)
        }
        // **倍率 1 倍でも動かせる。** 図は器より縦長なので、拡大していなくても
        // 下のほうは引きずらないと見えない
        this.drag(dx, dy)
        this.apply()
      }

      this.onPointerUp = (ev) => {
        this.pointers.delete(ev.pointerId)
        this.pinch = this.pointers.size >= 2 ? this.spread() : null
        if (!this.dragging) { return }
        if (this.pointers.size > 0) { return }
        this.dragging = false
        if (this.el.hasPointerCapture(ev.pointerId)) {
          this.el.releasePointerCapture(ev.pointerId)
        }
        this.settle()
      }

      // 引きずった直後の click は捨てる（丸の上で指を離すと代表作が開いてしまう）
      this.onClickCapture = (ev) => {
        if (this.moved > DRAG_SLOP) {
          ev.stopPropagation()
          ev.preventDefault()
          this.moved = 0
          return
        }
        const button = ev.target.closest("[data-zoom]")
        if (button) {
          ev.preventDefault()
          const how = button.dataset.zoom
          const box = this.el.getBoundingClientRect()
          if (how === "in") { this.zoomAt(1.4, box.left + box.width / 2, box.top + box.height / 2) }
          if (how === "out") { this.zoomAt(1 / 1.4, box.left + box.width / 2, box.top + box.height / 2) }
          if (how === "reset") { this.reset() }
          if (how === "full") { this.fullscreen() }
          return
        }
        // 図の余白を押したら全画面。**指で触る画面だけ**にする —— 狭い画面では
        // 図が小さすぎて全画面がないと読めないが、PC では窓のまま拡大すれば足りるので、
        // 押すたびに全画面へ飛ぶのは邪魔なだけ（ボタンからは PC でも入れる）。
        // 丸を押したときは代表作が開くので邪魔しない
        if (touchLike() && !ev.target.closest(".relation-node") && !document.fullscreenElement) {
          this.fullscreen()
        }
      }

      // 全画面に入る・出ると器の大きさが変わるので、はみ出しを測り直す
      this.onFullscreen = () => { this.clamp(); this.apply() }

      this.el.addEventListener("wheel", this.onWheel, {passive: false})
      this.el.addEventListener("pointerdown", this.onPointerDown)
      this.el.addEventListener("pointermove", this.onPointerMove)
      this.el.addEventListener("pointerup", this.onPointerUp)
      this.el.addEventListener("pointercancel", this.onPointerUp)
      this.el.addEventListener("click", this.onClickCapture, true)
      document.addEventListener("fullscreenchange", this.onFullscreen)
    },

    unbind() {
      this.el.removeEventListener("wheel", this.onWheel)
      this.el.removeEventListener("pointerdown", this.onPointerDown)
      this.el.removeEventListener("pointermove", this.onPointerMove)
      this.el.removeEventListener("pointerup", this.onPointerUp)
      this.el.removeEventListener("pointercancel", this.onPointerUp)
      this.el.removeEventListener("click", this.onClickCapture, true)
      document.removeEventListener("fullscreenchange", this.onFullscreen)
    },
  }
</script>
