# 生成: mix phx.gen.secret（64バイト以上。短いと起動時に断る）
SECRET_KEY_BASE=

# ブラウザから見えるホスト名（リンクの組み立てに使う）。
# **手元以外から開くなら、その宛先を書く**（この機械の LAN アドレスか、名前が
# 引けるならホスト名）
PHX_HOST=localhost
PORT=7000
# 前段に TLS を置いたときだけ https にする（既定は http で、LAN の中で配る前提）
PHX_SCHEME=http
# LiveView が繋ぎ直すときに接続元を見比べるかどうか。
# 空なら見比べない（LAN の中に閉じている前提）。外へ出すなら宛先をカンマ区切りで並べる
PHX_CHECK_ORIGIN=

# PostgreSQL。初回起動の前に決める（後から変えても DB 側は変わらない）
POSTGRES_USER=tazuna
POSTGRES_PASSWORD=tazuna
POSTGRES_DB=tazuna

# Chiezo（LAN内の知識サーバー）のルートURL。/v1 は付けない
CHIEZO_BASE_URL=
# 関連図を調べさせる相手（未設定なら Chiezo の既定）
CHIEZO_RELATIONS_BACKEND=
CHIEZO_RELATIONS_MODEL=

# ntfy（まとめの通知）。ルートURL とトピックの両方が要る。
# **既定のトピックは持たない** —— 公開の ntfy では、推測できる名前は誰でも読める
NTFY_BASE_URL=
# 通知先は収集ごとに決める（TAZUNA_<収集名>_NTFY_TOPIC）。書かない話題は知らせない
TAZUNA_TECH_NTFY_TOPIC=
TAZUNA_NEWS_NTFY_TOPIC=
# まとめが出ていないか見に行く間隔（分）。既定 60。まとめは 12 時間ごとなので、
# 短くしても早くは届かず、Chiezo への問い合わせが増えるだけ
TAZUNA_NOTIFY_MINUTES=

TZ=Asia/Tokyo
