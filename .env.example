# 生成: mix phx.gen.secret（64バイト以上。短いと起動時に断る）
SECRET_KEY_BASE=

# ブラウザから見えるホスト名（リンクの組み立てに使う）。
# **手元以外から開くなら、その宛先を書く**（この機械の LAN アドレスか、名前が
# 引けるならホスト名）
PHX_HOST=localhost
PORT=7000
# 前段に TLS を置いたときだけ https にする（既定は http で、LAN の中で配る前提）
PHX_SCHEME=http
# LiveView が繋ぎ直すときに接続元を見比べるかどうか。
# 空なら見比べない（LAN の中に閉じている前提）。外へ出すなら宛先をカンマ区切りで並べる
PHX_CHECK_ORIGIN=

# PostgreSQL。初回起動の前に決める（後から変えても DB 側は変わらない）
POSTGRES_USER=chidori
POSTGRES_PASSWORD=chidori
POSTGRES_DB=chidori

# Chiezo（LAN内の知識サーバー）のルートURL。/v1 は付けない
CHIEZO_BASE_URL=
# 関連図を調べさせる相手（未設定なら Chiezo の既定）
CHIEZO_RELATIONS_BACKEND=
CHIEZO_RELATIONS_MODEL=

# ntfy（まとめの通知）の場所の既定。**通知先（トピック）は画面から決める** ——
# 宛先は運用しながら変えるものなので、環境変数だと変えるたびに立て直しが要る。
# ここは環境の事情なので既定だけ置き、話題ごとの上書きも画面からできる
NTFY_BASE_URL=

TZ=Asia/Tokyo
