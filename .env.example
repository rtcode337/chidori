# 生成: mix phx.gen.secret（64バイト以上。短いと起動時に断る）
SECRET_KEY_BASE=

# ブラウザから見えるホスト名（リンクの組み立てに使う）。
# **手元以外から開くなら、その宛先を書く**（この機械の LAN アドレスか、名前が
# 引けるならホスト名）
PHX_HOST=localhost
PORT=7000
# 前段に TLS を置いたときだけ https にする（既定は http で、LAN の中で配る前提。https ならポートは 443）。
# 端末への通知（Web Push）は、PHX_HOST とこれで組んだ https の URL を送り手の名乗りに使う
# （http のままだと iPhone への通知が断られる）
PHX_SCHEME=http
# LiveView の接続元の見比べ方。空なら「開いた宛先と同じ名前なら通す」（どの名前・IP で
# 開いても繋がり、別のサイトのページからの接続は断る）。通す宛先を固定するなら
# カンマ区切りで並べる（例: https://chidori.example.com,http://192.0.2.10:7000）。
# false で見比べをやめる（繋がらないときの切り分け用。常用しない）
PHX_CHECK_ORIGIN=

# PostgreSQL。初回起動の前に決める（後から変えても DB 側は変わらない）
POSTGRES_USER=chidori
POSTGRES_PASSWORD=chidori
POSTGRES_DB=chidori

# Chiezo（LAN内の知識サーバー）のルートURL。/v1 は付けない
CHIEZO_BASE_URL=
# 画面に置く Chiezo へのリンクの宛先（見る人のブラウザから開けるもの）。空なら CHIEZO_BASE_URL。
# Chiezo をコンテナの名前（http://chiezo-app:7010）でつないでいるときは、LAN から開ける宛先を書く
CHIEZO_PUBLIC_URL=
# 関連図を調べさせる相手（未設定なら Chiezo の既定）
CHIEZO_RELATIONS_BACKEND=
CHIEZO_RELATIONS_MODEL=

# ntfy（まとめの通知）の場所の既定。**通知先（トピック）は画面から決める** ——
# 宛先は運用しながら変えるものなので、環境変数だと変えるたびに立て直しが要る。
# ここは環境の事情なので既定だけ置き、話題ごとの上書きも画面からできる
NTFY_BASE_URL=

TZ=Asia/Tokyo
